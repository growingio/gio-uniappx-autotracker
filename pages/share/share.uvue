<template>
	<scroll-view class="page">
		<text class="h2">分享 / 分享朋友圈 / 加收藏</text>
		<text class="desc">
			仅微信小程序端有效。demo 已注册 gioShareTracking。本页按微信原生方式定义
			onShareAppMessage / onShareTimeline / onAddToFavorites，SDK 会代理这些已存在的钩子。
		</text>

		<view class="section">
			<text class="section-title">操作建议</text>
			<text class="step">1. 点右上角菜单「转发」，看请求里是否有 `$mp_on_share`。</text>
			<text class="step">2. 点右上角菜单「分享到朋友圈」，看是否有 `$mp_share_timeline`。</text>
			<text class="step">3. 点右上角菜单「收藏」，看是否有 `$mp_add_favorites`。</text>
			<text class="step">4. 重点看 `$share_title` / `$share_path` / `$share_query`：handler 返回了就用返回值，否则兜底当前页。</text>
		</view>

		<!-- #ifdef MP-WEIXIN -->
		<view class="section">
			<text class="section-title">页面内转发按钮</text>
			<button class="btn" open-type="share">转发给朋友（open-type=share）</button>
			<text class="hint">{{ note }}</text>
		</view>
		<!-- #endif -->

		<!-- #ifndef MP-WEIXIN -->
		<view class="section">
			<text class="hint">当前不是微信小程序端，分享 / 收藏能力不可用。</text>
		</view>
		<!-- #endif -->
	</scroll-view>
</template>

<script lang="uts">
export default {
	data() {
		return {
			note: '点右上角菜单或上面的按钮触发分享，去网络面板看事件。',
		}
	},
	onLoad(options: any) {
		const safeOptions = options != null ? options : ({} as UTSJSONObject)
		console.log('[share] onLoad options=' + JSON.stringify(safeOptions))
	},
	// 仅微信小程序编译这三个钩子；注册 gioShareTracking 后，SDK 会代理已定义的分享 / 收藏 hook。
	// #ifdef MP-WEIXIN
	onShareAppMessage(options: any | null): any | null {
		return {
			title: 'GrowingIO 分享演示',
			path: '/pages/share/share?from=on_share',
		} as UTSJSONObject
	},
	onShareTimeline(options: any | null): any | null {
		return {
			title: 'GrowingIO 朋友圈演示',
			query: 'from=on_timeline',
		} as UTSJSONObject
	},
	onAddToFavorites(options: any | null): any | null {
		return {
			title: 'GrowingIO 收藏演示',
			path: '/pages/share/share?from=add_favorites',
		} as UTSJSONObject
	},
	// #endif
}
</script>

