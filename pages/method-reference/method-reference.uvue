	margin-top: 16px;
	padding: 18px;
	background-color: #ffffff;
	border-width: 1px;
	border-style: solid;
	border-color: #dfe6ef;
	border-radius: 12px;
}

.case-title {
	font-size: 18px;
	font-weight: 600;
	color: #17233d;
}

.code-text {
	margin-top: 8px;
	font-size: 13px;
	color: #6b778c;
}

.primary-button {
	margin-top: 16px;
	background-color: #1677ff;
	color: #ffffff;
