<template>
	<scroll-view class="page">
		<view class="hero">
			<text class="heroTitle">无埋点完整演示</text>
			<text class="heroDescription">一个页面连续验证 VIEW_CLICK / VIEW_CHANGE、element 字段、忽略规则、方法引用、官方组件、list-view 与 image。</text>
			<text class="heroNotice">操作后先看页面底部“最新页面动作”，再对照 GrowingIO 请求。带 data-growing-track 的值组件应携带 textValue，密码输入框除外。</text>
		</view>

		<view class="section">
			<text class="sectionTitle">点击事件</text>
			<text class="hint">覆盖 click / tap / longpress、方法引用、显式 $event 和内联表达式。</text>
			<button
				id="auto_click_method"
				class="btn"
				:data-index="1"
				data-title="方法引用按钮"
				data-src="/pages/autotrack/autotrack?case=method"
				@click="onMethodClick"
			>方法引用 click</button>
			<button
				id="auto_tap_method"
				class="btnGreen"
				:data-index="2"
				data-title="tap 按钮"
				data-src="/pages/autotrack/autotrack?case=tap"
				@tap="onTapClick"
			>tap 事件</button>
			<view
				id="auto_longpress_method"
				class="btnOrange"
				:data-index="3"
				data-title="longpress 区域"
				data-src="/pages/autotrack/autotrack?case=longpress"
				@longpress="onLongPress"
			>
				<text class="btnText">longpress 事件</text>
			</view>
			<button
				id="auto_explicit_event"
				class="btnGhost"
				:data-index="4"
				data-title="显式 event 按钮"
				data-src="/pages/autotrack/autotrack?case=event"
				@click="onExplicitEvent($event)"
			>显式传 $event</button>
			<button
				id="auto_inline_expression"
				class="btnGhost"
				:data-index="5"
				data-title="内联表达式按钮"
				data-src="/pages/autotrack/autotrack?case=inline"
				@click="note('inline expression click')"
			>内联表达式</button>
			<button
				id="auto_inline_argument"
				class="btnGhost"
				:data-index="6"
				data-title="内联参数按钮"
				data-src="/pages/autotrack/autotrack?case=inline-arg"
				@click="onInlineArgument('inline argument click')"
			>内联参数调用</button>
		</view>

		<view class="section">
			<text class="sectionTitle">方法引用与事件参数</text>
			<text class="hint">Android 原生编译会严格检查参数个数。下面验证一参数、零参数和对象成员方法引用在插桩后仍按原签名调用。</text>
			<view class="caseRow">
				<button
					id="method_ref_event"
					class="caseBtn"
					:data-index="70"
					data-title="一参数方法引用"
					data-src="/pages/autotrack/autotrack?case=method-event"
					@click="onEventMethod"
				>一参数引用</button>
				<view class="caseResult">
					<text class="codeLine">&#64;click="onEventMethod"</text>
					<text id="method_ref_event_result" class="resultText">{{ eventResult }}</text>
				</view>
			</view>
			<view class="caseRow">
				<button
					id="method_ref_zero"
					class="caseBtnGreen"
					:data-index="71"
					data-title="零参数方法引用"
					data-src="/pages/autotrack/autotrack?case=method-zero"
					@click="onZeroArgumentMethod"
				>零参数引用</button>
				<view class="caseResult">
					<text class="codeLine">&#64;click="onZeroArgumentMethod"</text>
					<text id="method_ref_zero_result" class="resultText">{{ zeroArgumentResult }}</text>
				</view>
			</view>
			<view class="caseRow">
				<button
					id="method_ref_member"
					class="caseBtnOrange"
					:data-index="72"
					data-title="对象成员方法引用"
					data-src="/pages/autotrack/autotrack?case=method-member"
					@click="actions.onMemberEvent"
				>成员方法引用</button>
				<view class="caseResult">
					<text class="codeLine">&#64;click="actions.onMemberEvent"</text>
					<text id="method_ref_member_result" class="resultText">{{ memberResult }}</text>
				</view>
			</view>
		</view>

		<view class="section">
			<text class="sectionTitle">链接组件</text>
			<text class="hint">覆盖 uni-link 默认点击、显式 click 和 href 作为 hyperlink。</text>
			<view class="caseRow">
				<view class="linkControl">
					<uni-link
						id="auto_uni_link_default"
						href="https://doc.dcloud.net.cn/uni-app-x/"
						target="_self"
						:data-index="17"
						data-title="uni-link 默认点击"
					>uni-link 默认点击</uni-link>
				</view>
				<text class="codeLine">uni-link href；内部 click 携带 data-src</text>
			</view>
			<view class="caseRow">
				<view class="linkControl">
					<uni-link
						id="auto_uni_link_explicit"
						href="https://uniapp.dcloud.net.cn"
						target="_self"
						:data-index="18"
						data-title="uni-link 显式 click"
						@click="onUniLinkClick"
					>uni-link 显式 click</uni-link>
				</view>
				<text class="codeLine">uni-link href + &#64;click="onUniLinkClick"</text>
			</view>
		</view>

		<view class="section">
			<text class="sectionTitle">合法调用写法</text>
			<text class="hint">覆盖带括号、不带括号、不同参数类型、多参数、$event 混参和连续语句。</text>
			<view class="caseRow">
				<button
					id="auto_call_no_parentheses"
					class="caseBtn"
					:data-index="7"
					data-title="不带括号的方法引用"
					data-src="/pages/autotrack/autotrack?case=no-parentheses"
					@click="onNoParentheses"
				>不带括号</button>
				<text class="codeLine">&#64;click="onNoParentheses"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_call_empty_parentheses"
					class="caseBtn"
					:data-index="8"
					data-title="显式空括号"
					data-src="/pages/autotrack/autotrack?case=empty-parentheses"
					@click="onEmptyParentheses()"
				>空括号</button>
				<text class="codeLine">&#64;click="onEmptyParentheses()"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_call_string_argument"
					class="caseBtnGreen"
					:data-index="9"
					data-title="字符串参数"
					data-src="/pages/autotrack/autotrack?case=string-argument"
					@click="onStringArgument('string_arg')"
				>字符串参数</button>
				<text class="codeLine">&#64;click="onStringArgument('string_arg')"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_call_number_argument"
					class="caseBtnGreen"
					:data-index="10"
					data-title="数字参数"
					data-src="/pages/autotrack/autotrack?case=number-argument"
					@click="onNumberArgument(42)"
				>数字参数</button>
				<text class="codeLine">&#64;click="onNumberArgument(42)"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_call_boolean_argument"
					class="caseBtnGreen"
					:data-index="11"
					data-title="布尔参数"
					data-src="/pages/autotrack/autotrack?case=boolean-argument"
					@click="onBooleanArgument(true)"
				>布尔参数</button>
				<text class="codeLine">&#64;click="onBooleanArgument(true)"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_call_null_argument"
					class="caseBtnGreen"
					:data-index="12"
					data-title="null 参数"
					data-src="/pages/autotrack/autotrack?case=null-argument"
					@click="onNullArgument(null)"
				>null 参数</button>
				<text class="codeLine">&#64;click="onNullArgument(null)"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_call_multi_arguments"
					class="caseBtnOrange"
					:data-index="13"
					data-title="多参数"
					data-src="/pages/autotrack/autotrack?case=multi-arguments"
					@click="onMultipleArguments('sku_001', 3, true)"
				>多参数</button>
				<text class="codeLine">&#64;click="onMultipleArguments('sku_001', 3, true)"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_call_event_and_argument"
					class="caseBtnOrange"
					:data-index="14"
					data-title="$event 混合参数"
					data-src="/pages/autotrack/autotrack?case=event-and-argument"
					@click="onEventAndArgument($event, 'extra_arg')"
				>$event + 参数</button>
				<text class="codeLine">&#64;click="onEventAndArgument($event, 'extra_arg')"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_call_inline_sequence"
					class="caseBtnGhost"
					:data-index="15"
					data-title="连续语句"
					data-src="/pages/autotrack/autotrack?case=inline-sequence"
					@click="note('inline first'); onInlineArgument('inline second')"
				>连续语句</button>
				<text class="codeLine">&#64;click="note('inline first'); onInlineArgument('inline second')"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_call_conditional"
					class="caseBtnGhost"
					:data-index="16"
					data-title="条件表达式"
					data-src="/pages/autotrack/autotrack?case=conditional"
					@click="conditionEnabled ? onConditionalTrue() : onConditionalFalse()"
				>条件表达式</button>
				<text class="codeLine">&#64;click="conditionEnabled ? onConditionalTrue() : onConditionalFalse()"</text>
			</view>
		</view>

		<view class="section">
			<text class="sectionTitle">element 字段</text>
			<text class="hint">观察 xpath / index / textValue / hyperlink 是否按 dataset 进入 element。</text>
			<view class="caseRow">
				<button
					id="auto_element_id_only"
					class="caseBtn"
					@click="onElementIdOnly"
				>只有 id</button>
				<text class="codeLine">id="auto_element_id_only" &#64;click="onElementIdOnly"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_dataset_full"
					class="caseBtn"
					:data-index="30"
					data-title="完整 dataset"
					data-src="https://example.com/full"
					@click="onDatasetFull"
				>完整 dataset</button>
				<text class="codeLine">id + :data-index="30" + data-title + data-src + &#64;click</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_dataset_static_index"
					class="caseBtn"
					data-index="31"
					data-title="静态 index"
					@click="onDatasetStaticIndex"
				>静态 index</button>
				<text class="codeLine">data-index="31" data-title="静态 index" &#64;click="onDatasetStaticIndex"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_dataset_title_only"
					class="caseBtnGreen"
					data-title="只有 textValue"
					@click="onDatasetTitleOnly"
				>只有 title</button>
				<text class="codeLine">data-title="只有 textValue" &#64;click="onDatasetTitleOnly"</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_dataset_src_only"
					class="caseBtnGreen"
					data-src="https://example.com/src-only"
					@click="onDatasetSrcOnly"
				>只有 src</button>
				<text class="codeLine">data-src="https://example.com/src-only" &#64;click="onDatasetSrcOnly"</text>
			</view>
			<view class="caseRow">
				<button
					class="caseBtnGhost"
					data-title="无 id 节点"
					:data-index="32"
					@click="onElementNoId"
				>无 id</button>
				<text class="codeLine">无 id + data-title + :data-index="32"；xpath 应为 #onElementNoId</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_dataset_zero"
					class="caseBtnOrange"
					:data-index="0"
					data-title="index 为 0"
					data-src="https://example.com/zero"
					@click="onDatasetZero"
				>index=0</button>
				<text class="codeLine">:data-index="0"；应不进入 element.index</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_dataset_max"
					class="caseBtnOrange"
					:data-index="2147483647"
					data-title="index 最大边界"
					data-src="https://example.com/max"
					@click="onDatasetMaxIndex"
				>index=max</button>
				<text class="codeLine">:data-index="2147483647"；应不进入 element.index</text>
			</view>
			<view class="caseRow">
				<button
					id="auto_dataset_invalid"
					class="caseBtnOrange"
					data-index="abc"
					data-title="非法 index"
					data-src="https://example.com/invalid"
					@click="onDatasetInvalid"
				>index=abc</button>
				<text class="codeLine">data-index="abc"；应不进入 element.index</text>
			</view>
		</view>

		<view class="section">
			<text class="sectionTitle">忽略与嵌套</text>
			<text class="hint">growingIgnore 应阻止 VIEW_CLICK；嵌套点击用于观察 currentTarget 优先级。</text>
			<button
				id="auto_click_ignore"
				class="btnDanger"
				:data-growing-ignore="true"
				data-title="忽略按钮"
				@click="onIgnoredClick"
			>data-growing-ignore=true</button>
			<view
				id="auto_parent_click"
				class="nestBox"
				:data-index="20"
				data-title="父级 currentTarget"
				data-src="/pages/autotrack/autotrack?case=nested"
				@click="onParentClick"
			>
				<text class="nestTitle">点这里或子区域</text>
				<view
					id="auto_child_area"
					class="nestChild"
					:data-index="21"
					data-title="子级 target"
					data-src="/pages/autotrack/autotrack?case=child"
				>
					<text class="nestChildText">子区域 target</text>
				</view>
			</view>
		</view>

		<view class="section">
			<text class="sectionTitle">变更事件</text>
			<text class="hint">先看输入类事件，再看真正触发 change 的组件；独立 SDK 只把 blur / change / confirm 归为 VIEW_CHANGE。</text>
			<view class="caseRow">
				<input
					id="auto_direct_input"
					class="changeInput"
					v-model="changeValue"
					data-growing-track="true"
					data-title="直接输入 input"
					@input="onDirectInput"
				/>
				<text class="codeLine">发送：否；&#64;input 不在独立 SDK change listeners 里</text>
			</view>
			<view class="caseRow">
				<input
					id="auto_blur_input"
					class="changeInput"
					v-model="blurValue"
					:data-index="42"
					:data-growing-track="true"
					data-title="blur 输入框"
					data-src="/pages/autotrack/autotrack?case=blur"
					@blur="onInputBlur($event)"
				/>
				<text class="codeLine">发送：是；&#64;blur="onInputBlur($event)"；带 xpath / textValue，不带 index</text>
			</view>
			<view class="caseRow">
				<input
					id="auto_confirm_input"
					class="changeInput"
					v-model="confirmValue"
					:data-index="43"
					:data-growing-track="true"
					data-title="confirm 输入框"
					data-src="/pages/autotrack/autotrack?case=confirm"
					confirm-type="search"
					@confirm="onInputConfirm('confirm_arg')"
				/>
				<text class="codeLine">发送：是；&#64;confirm="onInputConfirm('confirm_arg')"；带 xpath / textValue，不带 index</text>
			</view>
			<view class="caseRow">
				<input
					id="auto_password_input"
					class="changeInput"
					v-model="passwordValue"
					type="password"
					:data-growing-track="true"
					data-title="password 输入框"
					@blur="onPasswordBlur($event)"
				/>
				<text class="codeLine">发送：是；change 发送逻辑同普通 input；type="password" + data-growing-track 强制不带 textValue</text>
			</view>
			<view class="caseRow">
				<input
					id="auto_attr_fallback"
					class="changeInput"
					value="attr_fallback_value"
					:data-growing-track="true"
					data-title="attr fallback 输入框"
					@blur="onAttrFallbackBlur"
				/>
				<text class="codeLine">发送：是；detail.value 没值时 fallback target.attr.value</text>
			</view>
			<view class="caseRow">
				<view class="changeControl">
					<switch
						id="auto_change_switch"
						:checked="switchChecked"
						data-growing-track="true"
						data-title="switch change"
						@change="onSwitchChange"
					/>
				</view>
				<text class="codeLine">发送：是；switch &#64;change + 静态 data-growing-track；带 xpath / textValue</text>
			</view>
			<view class="caseRow">
				<view class="changeControl">
					<switch
						id="auto_change_event_argument"
						:checked="eventArgumentChecked"
						:data-growing-track="true"
						data-title="$event 混合 change"
						@change="onChangeEventAndArgument($event, 'change_extra')"
					/>
				</view>
				<text class="codeLine">发送：是；switch &#64;change="$event + 参数"；带 xpath / textValue</text>
			</view>
			<view class="caseRow">
				<view class="changeControl">
					<switch
						id="auto_change_inline_sequence"
						:checked="inlineChangeChecked"
						:data-growing-track="true"
						data-title="连续语句 change"
						@change="note('change inline first'); onChangeInlineSecond()"
					/>
				</view>
				<text class="codeLine">发送：是；连续语句；eventName 取 note，xpath 为 #note；带 textValue</text>
			</view>
			<view class="caseRow">
				<slider
					id="auto_change_slider"
					class="changeSlider"
					:value="sliderValue"
					:min="0"
					:max="100"
					:step="1"
					:data-growing-track="true"
					data-title="slider change"
					@change="onSliderChange"
				/>
				<text class="codeLine">发送：是；slider &#64;change；带 xpath / textValue=滑动值</text>
			</view>
			<view class="caseRow">
				<view class="changeControl">
					<switch
						id="auto_change_no_track"
						:checked="noTrackChecked"
						data-title="不采集值的 switch"
						@change="onChangeNoTrack"
					/>
				</view>
				<text class="codeLine">发送：是；无 growingTrack；只带 xpath，不带 textValue</text>
			</view>
			<view class="caseRow">
				<view class="changeControl">
					<switch
						:checked="changeNoIdChecked"
						:data-growing-track="true"
						data-title="无 id change"
						@change="onChangeNoId"
					/>
				</view>
				<text class="codeLine">发送：是；无 id；xpath 应为 #onChangeNoId；带 textValue</text>
			</view>
			<view class="caseRow">
				<view class="changeControl">
					<switch
						id="auto_change_invalid_index"
						:checked="invalidChangeChecked"
						data-index="abc"
						:data-growing-track="true"
						data-title="非法 index change"
						@change="onChangeInvalidIndex"
					/>
				</view>
				<text class="codeLine">发送：是；change 不读取 index；不提示非法 index</text>
			</view>
			<view class="caseRow">
				<view class="changeControl">
					<switch
						id="auto_change_ignore"
						:checked="ignoredChecked"
						:data-growing-track="true"
						:data-growing-ignore="true"
						data-title="忽略变更 switch"
						@change="onIgnoredChange"
					/>
				</view>
				<text class="codeLine">发送：否；growingIgnore=true；不产生 VIEW_CHANGE</text>
			</view>

			<text class="subsectionTitle">标量值组件</text>
			<text class="hint">textarea / radio-group / picker 的 detail.value 由桥接层统一归一化，模板插桩只传原始 $event。</text>
			<textarea
				id="component_textarea_confirm"
				class="demoTextarea"
				v-model="textareaValue"
				data-title="textarea confirm"
				data-growing-track="true"
				confirm-type="done"
				@confirm="recordComponentAction('textarea confirm')"
			/>
			<radio-group
				id="component_radio_group_change"
				class="choiceRow"
				data-title="radio group change"
				data-growing-track="true"
				@change="recordComponentAction('radio-group change')"
			>
				<view class="choiceItem"><radio value="alpha" /><text class="choiceText">Alpha</text></view>
				<view class="choiceItem"><radio value="beta" /><text class="choiceText">Beta</text></view>
			</radio-group>
			<picker
				id="component_picker_change"
				class="demoPicker"
				:range="pickerItems"
				:value="0"
				data-title="picker change"
				data-growing-track="true"
				@change="recordComponentAction('picker change')"
			>
				<view class="pickerTrigger"><text class="pickerTriggerText">打开 picker（HBuilderX 5.08+）</text></view>
			</picker>

			<text class="subsectionTitle">数组值组件</text>
			<text class="hint">checkbox-group 保留数组值；picker-view 会按各列的候选文案映射，示例中 [1] 上报为 Beta。</text>
			<checkbox-group
				id="component_checkbox_group_change"
				class="choiceRow"
				data-title="checkbox group change"
				data-growing-track="true"
				@change="recordComponentAction('checkbox-group change')"
			>
				<view class="choiceItem"><checkbox value="red" /><text class="choiceText">Red</text></view>
				<view class="choiceItem"><checkbox value="blue" /><text class="choiceText">Blue</text></view>
			</checkbox-group>
			<picker-view
				id="component_picker_view_change"
				class="pickerView"
				:value="pickerValue"
				data-title="picker view change"
				data-growing-track="true"
				@change="recordComponentAction('picker-view change')"
			>
				<picker-view-column class="pickerColumn">
					<view class="pickerItem" v-for="(item, index) in pickerItems" :key="index">
						<text class="pickerText">{{ item }}</text>
					</view>
				</picker-view-column>
			</picker-view>

			<text class="subsectionTitle">非 value 型 change</text>
			<text class="hint">swiper 只有 current / source，不能读取不存在的 detail.value；手势滑动可上报 VIEW_CHANGE，autoplay 仍按既有规则忽略。</text>
			<swiper
				id="component_swiper_change"
				class="demoSwiper"
				:autoplay="false"
				:circular="false"
				data-title="swiper change"
				@change="recordComponentAction('swiper change')"
			>
				<swiper-item><view class="swiperItem swiperBlue"><text class="swiperText">Swipe A</text></view></swiper-item>
				<swiper-item><view class="swiperItem swiperGreen"><text class="swiperText">Swipe B</text></view></swiper-item>
			</swiper>
		</view>

		<view class="section">
			<text class="sectionTitle">tabBar</text>
			<text class="hint">Web、微信小程序、HarmonyOS VDOM 点击底部 tabBar 的“无埋点”页签时，应通过 onTabItemTap 上报 VIEW_CLICK，xpath 为 #onTabItemTap；Android、iOS、HarmonyOS Vapor 不挂载该 hook。</text>
		</view>
		<view class="section">
			<text class="sectionTitle">导航组件</text>
			<text class="hint">navigator 点击应上报 VIEW_CLICK，同时跳转路由页验证后续 PAGE、query 与 referralPage。</text>
			<navigator
				id="component_navigator_click"
				class="navigatorCard"
				url="/pages/route/route?from=autotrack"
				:data-index="79"
				data-title="navigator click"
				data-src="/pages/route/route"
				@click="recordComponentAction('navigator click')"
			>
				<text class="navigatorText">navigator · 去路由验证页</text>
			</navigator>
		</view>

		<view class="section">
			<text class="sectionTitle">list-view / list-item</text>
			<text class="hint">在固定高度列表中验证复用节点、动态 dataset、列表项 VIEW_CLICK、下拉刷新与触底追加。</text>
			<view class="listActions">
				<button class="smallButton" @click="scrollToFirstItem">到顶部</button>
				<button class="smallButton smallButtonGhost" @click="scrollToLastItem">到底部</button>
			</view>
			<list-view
				class="demoList"
				direction="vertical"
				:show-scrollbar="true"
				:scroll-with-animation="true"
				:scroll-into-view="scrollIntoView"
				:refresher-enabled="true"
				:refresher-triggered="refresherTriggered"
				refresher-default-style="black"
				@refresherrefresh="onRefresherRefresh"
				@scrolltolower="onScrollToLower"
			>
				<list-item
					v-for="item in listItems"
					:id="item.id"
					:key="item.id"
					class="demoListItem"
					:data-index="item.index"
					:data-title="item.title"
					:data-src="item.src"
					@click="onListItemClick(item)"
				>
					<view class="listItemMain">
						<view class="listBadge"><text class="listBadgeText">{{ item.index }}</text></view>
						<view class="listContent">
							<text class="listTitle">{{ item.title }}</text>
							<text class="listDescription">{{ item.description }}</text>
						</view>
					</view>
				</list-item>
			</list-view>
		</view>

		<view class="section">
			<text class="sectionTitle">image 图片组件</text>
			<text class="hint">验证动态 mode、lazy-load、load/error 与图片 VIEW_CLICK；点击成功图片还会发送 image_demo_click 供对照。</text>
			<view class="imagePreview">
				<image
					id="image_mode_preview"
					class="previewImage"
					:src="imageSrc"
					:mode="currentImageMode"
					:lazy-load="true"
					:fade-show="true"
					:data-index="80"
					:data-title="'image mode=' + currentImageMode"
					data-src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png"
					@load="onImageLoad"
					@error="onImageError"
					@click="onImageClick(currentImageMode)"
				/>
			</view>
			<text class="imageModeLabel">当前 mode：{{ currentImageMode }}</text>
			<view class="imageModeRow">
				<button v-for="mode in imageModes" :key="mode" class="imageModeButton" @click="setImageMode(mode)">{{ mode }}</button>
			</view>
			<view class="imageResultRow">
				<image
					id="image_error"
					class="smallImage errorImage"
					:src="brokenImageSrc"
					mode="aspectFit"
					:data-index="81"
					data-title="image error case"
					data-src="https://example.invalid/not-found.png"
					@load="onImageLoad"
					@error="onImageError"
					@click="onImageClick('error')"
				/>
				<view class="imageResultText">
					<text class="resultText">load：{{ imageLoadInfo }}</text>
					<text class="resultText">error：{{ imageErrorInfo }}</text>
				</view>
			</view>
		</view>
		<view class="result">
			<text class="label">最新页面动作：</text>
			<text class="value">{{ lastAction }}</text>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { gdp } from '@/uni_modules/gio-uniappx-autotracker/gdp.uts'

type MethodActions = {
	onMemberEvent: (event : any | null) => void
}

type DemoListItem = {
	id: string
	index: number
	title: string
	description: string
	src: string
}

const changeValue = ref('change_value')
const blurValue = ref('blur_value')
const confirmValue = ref('confirm_value')
const passwordValue = ref('password_value')
const switchChecked = ref(false)
const eventArgumentChecked = ref(false)
const inlineChangeChecked = ref(false)
const sliderValue = ref(20)
const noTrackChecked = ref(false)
const changeNoIdChecked = ref(false)
const invalidChangeChecked = ref(false)
const ignoredChecked = ref(false)
const lastAction = ref('(none)')
const conditionEnabled = ref(true)
const eventResult = ref('等待点击')
const zeroArgumentResult = ref('等待点击')
const memberResult = ref('等待点击')
const textareaValue = ref('textarea value')
const pickerValue = ref<Array<number>>([0])
const pickerItems = ['Alpha', 'Beta', 'Gamma']
const refresherTriggered = ref(false)
const scrollIntoView = ref('')
const imageSrc: string.ImageURIString = 'https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png'
const brokenImageSrc: string.ImageURIString = 'https://example.invalid/gio-image-demo-not-found.png'
const imageModes = ['scaleToFill', 'aspectFit', 'aspectFill', 'widthFix']
const currentImageMode = ref('aspectFit')
const imageLoadInfo = ref('(waiting)')
const imageErrorInfo = ref('(waiting)')

function buildListItems(startIndex : number, count : number) : Array<DemoListItem> {
	const result : Array<DemoListItem> = []
	for (let i = 0; i < count; i++) {
		const index = startIndex + i
		result.push({
			id: 'autotrack_list_item_' + index.toString(),
			index: index,
			title: '列表项 #' + index.toString(),
			description: '动态 dataset 与复用节点点击采集',
			src: '/pages/autotrack/autotrack?item=' + index.toString(),
		})
	}
	return result
}

const listItems = ref<Array<DemoListItem>>(buildListItems(1, 12))
let nextListIndex = 13

function note(message : string) {
	lastAction.value = message
}

const actions : MethodActions = {
	onMemberEvent: (event : any | null) : void => {
		memberResult.value = event != null ? 'member $event received' : 'member $event missing'
		note(memberResult.value)
	},
}

function onMethodClick(event : any | null) {
	note(event != null ? 'method click event received' : 'method click event missing')
}

function onEventMethod(event : any | null) {
	eventResult.value = event != null ? '$event received' : '$event missing'
	note(eventResult.value)
}

function onZeroArgumentMethod() {
	zeroArgumentResult.value = 'zero argument called'
	note(zeroArgumentResult.value)
}

function onTapClick() {
	note('tap click')
}

function onLongPress() {
	note('longpress')
}

function onExplicitEvent(_event : any | null) {
	note('explicit event click')
}

function onInlineArgument(message : string) {
	note(message)
}

function onUniLinkClick() {
	note('uni-link explicit click')
}

function onElementIdOnly() {
	note('element id only')
}

function onNoParentheses() {
	note('no parentheses method reference')
}

function onEmptyParentheses() {
	note('empty parentheses call')
}

function onStringArgument(value : string) {
	note('string argument: ' + value)
}

function onNumberArgument(value : number) {
	note('number argument: ' + value.toString())
}

function onBooleanArgument(value : boolean) {
	note('boolean argument: ' + (value ? 'true' : 'false'))
}

function onNullArgument(value : string | null) {
	note(value == null ? 'null argument' : value)
}

function onMultipleArguments(sku : string, count : number, checked : boolean) {
	note('multi arguments: ' + sku + ' / ' + count.toString() + ' / ' + (checked ? 'true' : 'false'))
}

function onEventAndArgument(_event : any | null, value : string) {
	note('$event with argument: ' + value)
}

function onConditionalTrue() {
	conditionEnabled.value = false
	note('conditional true branch')
}

function onConditionalFalse() {
	conditionEnabled.value = true
	note('conditional false branch')
}

function onDatasetFull() {
	note('dataset full')
}

function onDatasetStaticIndex() {
	note('dataset static index')
}

function onDatasetTitleOnly() {
	note('dataset title only')
}

function onDatasetSrcOnly() {
	note('dataset src only')
}

function onElementNoId() {
	note('element without id')
}

function onDatasetZero() {
	note('dataset index zero')
}

function onDatasetMaxIndex() {
	note('dataset index max')
}

function onDatasetInvalid() {
	note('dataset index invalid')
}

function onIgnoredClick() {
	note('ignored click handler executed')
}

function onParentClick() {
	note('nested parent click')
}

function onDirectInput() {
	note('direct input only: ' + changeValue.value)
}

function onInputBlur(_event : any | null) {
	note('input blur: ' + blurValue.value)
}

function onInputConfirm(value : string) {
	note('input confirm: ' + confirmValue.value + ' / ' + value)
}

function onPasswordBlur(_event : any | null) {
	note('password blur')
}

function onSwitchChange() {
	switchChecked.value = !switchChecked.value
	note('switch change: ' + (switchChecked.value ? 'true' : 'false'))
}

function onChangeEventAndArgument(_event : any | null, value : string) {
	eventArgumentChecked.value = !eventArgumentChecked.value
	note('switch event argument: ' + (eventArgumentChecked.value ? 'true' : 'false') + ' / ' + value)
}

function onChangeInlineSecond() {
	inlineChangeChecked.value = !inlineChangeChecked.value
	note('change inline second: ' + (inlineChangeChecked.value ? 'true' : 'false'))
}

function onSliderChange(_event : any | null = null) {
	note('slider change')
}

function onChangeNoTrack() {
	noTrackChecked.value = !noTrackChecked.value
	note('change without growingTrack: ' + (noTrackChecked.value ? 'true' : 'false'))
}

function onAttrFallbackBlur() {
	note('attr fallback blur')
}

function onChangeNoId() {
	changeNoIdChecked.value = !changeNoIdChecked.value
	note('change without id: ' + (changeNoIdChecked.value ? 'true' : 'false'))
}

function onChangeInvalidIndex() {
	invalidChangeChecked.value = !invalidChangeChecked.value
	note('change invalid index: ' + (invalidChangeChecked.value ? 'true' : 'false'))
}

function onIgnoredChange() {
	ignoredChecked.value = !ignoredChecked.value
	note('ignored change handler executed: ' + (ignoredChecked.value ? 'true' : 'false'))
}

function recordComponentAction(message : string) {
	note(message)
}

function appendListItems(count : number) {
	const more = buildListItems(nextListIndex, count)
	for (let i = 0; i < more.length; i++) {
		listItems.value.push(more[i])
	}
	nextListIndex += count
}

function prependListItems(count : number) {
	const more = buildListItems(nextListIndex, count)
	for (let i = more.length - 1; i >= 0; i--) {
		listItems.value.unshift(more[i])
	}
	nextListIndex += count
}

function onRefresherRefresh() {
	refresherTriggered.value = true
	note('list-view 下拉刷新中')
	setTimeout(() => {
		prependListItems(2)
		refresherTriggered.value = false
		note('list-view 刷新完成，当前 ' + (listItems.value.length as number).toString() + ' 条')
	}, 600)
}

function onScrollToLower() {
	appendListItems(4)
	note('list-view 触底追加 4 条，当前 ' + (listItems.value.length as number).toString() + ' 条')
}

function scrollToFirstItem() {
	if ((listItems.value.length as number) == 0) {
		return
	}
	scrollIntoView.value = listItems.value[0].id
	note('list-view 滚动到顶部')
}

function scrollToLastItem() {
	const count = listItems.value.length as number
	if (count == 0) {
		return
	}
	scrollIntoView.value = listItems.value[count - 1].id
	note('list-view 滚动到底部')
}

function onListItemClick(item : DemoListItem) {
	const properties = {} as UTSJSONObject
	properties['itemIndex'] = item.index
	properties['itemTitle'] = item.title
	gdp('track', 'list_view_item_click', properties)
	note('点击 ' + item.title + '，已发送 list_view_item_click')
}

function setImageMode(mode : string) {
	currentImageMode.value = mode
	note('image mode：' + mode)
}

function onImageClick(scene : string) {
	const properties = {} as UTSJSONObject
	properties['scene'] = scene
	properties['mode'] = currentImageMode.value
	gdp('track', 'image_demo_click', properties)
	note('点击图片：' + scene + '，已发送 image_demo_click')
}

function onImageLoad(event : ImageLoadEvent) {
	const width = event.detail.width
	const height = event.detail.height
	imageLoadInfo.value = 'width=' + `${width as number}` + ', height=' + `${height as number}`
}

function onImageError(event : ImageErrorEvent) {
	imageErrorInfo.value = event.detail.errMsg
}
</script>

<style>
.page { padding: 20rpx; flex: 1; background-color: #f3f5f8; }
.hero { padding: 28rpx; margin-bottom: 20rpx; border-radius: 14rpx; background-color: #172554; }
.heroTitle { color: #ffffff; font-size: 38rpx; font-weight: bold; }
.heroDescription { margin-top: 12rpx; color: #dbeafe; font-size: 25rpx; line-height: 38rpx; }
.heroNotice { margin-top: 16rpx; padding: 16rpx; border-radius: 10rpx; color: #fef3c7; background-color: #713f12; font-size: 22rpx; line-height: 34rpx; }
.section { background: #fff; padding: 20rpx; margin-bottom: 20rpx; border-radius: 10rpx; }
.sectionTitle { font-size: 30rpx; font-weight: bold; color: #20242a; margin-bottom: 8rpx; }
.subsectionTitle { margin-top: 24rpx; margin-bottom: 6rpx; font-size: 26rpx; font-weight: bold; color: #344054; }
.hint { font-size: 22rpx; color: #667085; padding: 4rpx 0 12rpx; }
.fieldLabel { font-size: 22rpx; color: #475467; margin: 10rpx 2rpx 6rpx; }
.btn { background: #1677ff; color: #fff; font-size: 26rpx; padding: 16rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.btnGreen { background: #13a67a; color: #fff; font-size: 26rpx; padding: 16rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.btnOrange { background: #fa8c16; padding: 16rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.btnText { color: #fff; font-size: 26rpx; text-align: center; }
.btnWarn { background: #fff7e6; color: #b26200; font-size: 26rpx; padding: 16rpx; border-radius: 8rpx; margin-bottom: 12rpx; border: 1rpx solid #ffd591; }
.btnDanger { background: #ef4444; color: #fff; font-size: 26rpx; padding: 16rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.btnGhost { background: #eef5ff; color: #1677ff; font-size: 26rpx; padding: 16rpx; border-radius: 8rpx; margin-bottom: 12rpx; border: 1rpx solid #9ec5ff; }
.caseRow { flex-direction: row; align-items: stretch; margin-bottom: 12rpx; }
.caseResult { flex: 1; }
.caseBtn { width: 220rpx; background: #1677ff; color: #fff; font-size: 24rpx; padding: 14rpx 8rpx; border-radius: 8rpx; margin-right: 12rpx; }
.caseBtnGreen { width: 220rpx; background: #13a67a; color: #fff; font-size: 24rpx; padding: 14rpx 8rpx; border-radius: 8rpx; margin-right: 12rpx; }
.caseBtnOrange { width: 220rpx; background: #fa8c16; color: #fff; font-size: 24rpx; padding: 14rpx 8rpx; border-radius: 8rpx; margin-right: 12rpx; }
.caseBtnGhost { width: 220rpx; background: #eef5ff; color: #1677ff; font-size: 24rpx; padding: 14rpx 8rpx; border-radius: 8rpx; margin-right: 12rpx; border: 1rpx solid #9ec5ff; }
.codeLine { flex: 1; color: #344054; background: #f8fafc; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 14rpx; font-size: 24rpx; }
.input { border: 1rpx solid #d0d5dd; padding: 14rpx; border-radius: 6rpx; margin-bottom: 12rpx; font-size: 26rpx; }
.changeInput { width: 300rpx; border: 1rpx solid #d0d5dd; padding: 14rpx; border-radius: 6rpx; margin-right: 12rpx; font-size: 24rpx; }
.changeControl { width: 300rpx; margin-right: 12rpx; justify-content: center; }
.changeSlider { width: 300rpx; margin-right: 12rpx; }
.linkControl { width: 300rpx; margin-right: 12rpx; justify-content: center; }
.resultText { margin-top: 8rpx; font-size: 23rpx; color: #00875a; }
.demoTextarea { height: 150rpx; padding: 14rpx; margin-bottom: 12rpx; border-width: 1rpx; border-style: solid; border-color: #d0d5dd; border-radius: 8rpx; font-size: 24rpx; }
.choiceRow { flex-direction: row; flex-wrap: wrap; padding-top: 8rpx; padding-bottom: 12rpx; }
.choiceItem { flex-direction: row; align-items: center; margin-right: 28rpx; margin-bottom: 8rpx; }
.choiceText { margin-left: 8rpx; color: #344054; font-size: 24rpx; }
.demoPicker { margin-bottom: 10rpx; }
.pickerTrigger { padding: 18rpx; border-width: 1rpx; border-style: solid; border-color: #93c5fd; border-radius: 8rpx; align-items: center; background-color: #eff6ff; }
.pickerTriggerText { color: #1d4ed8; font-size: 24rpx; }
.pickerView { height: 240rpx; border-width: 1rpx; border-style: solid; border-color: #d0d5dd; border-radius: 8rpx; }
.pickerColumn { height: 240rpx; }
.pickerItem { height: 80rpx; align-items: center; justify-content: center; }
.pickerText { color: #344054; font-size: 24rpx; text-align: center; }
.demoSwiper { height: 240rpx; border-radius: 8rpx; }
.swiperItem { flex: 1; align-items: center; justify-content: center; }
.swiperBlue { background-color: #dbeafe; }
.swiperGreen { background-color: #d1fae5; }
.swiperText { color: #1f2937; font-size: 28rpx; font-weight: bold; }
.navigatorCard { padding: 22rpx; border-radius: 8rpx; align-items: center; background-color: #7c3aed; }
.navigatorText { color: #ffffff; font-size: 25rpx; }
.listActions { flex-direction: row; margin-bottom: 12rpx; }
.smallButton { margin-right: 12rpx; padding: 10rpx 22rpx; border-radius: 8rpx; background-color: #1677ff; color: #ffffff; font-size: 22rpx; }
.smallButtonGhost { background-color: #ffffff; color: #1677ff; border-width: 1rpx; border-style: solid; border-color: #1677ff; }
.demoList { height: 620rpx; border-width: 1rpx; border-style: solid; border-color: #e4e7ec; border-radius: 10rpx; background-color: #f8fafc; }
.demoListItem { margin: 12rpx; border-radius: 8rpx; background-color: #ffffff; border-width: 1rpx; border-style: solid; border-color: #e4e7ec; }
.listItemMain { flex-direction: row; align-items: center; padding: 18rpx; }
.listBadge { width: 56rpx; height: 56rpx; margin-right: 16rpx; border-radius: 8rpx; align-items: center; justify-content: center; background-color: #e6f4ff; }
.listBadgeText { color: #1677ff; font-size: 22rpx; font-weight: bold; }
.listContent { flex: 1; }
.listTitle { color: #20242a; font-size: 25rpx; font-weight: 500; }
.listDescription { margin-top: 6rpx; color: #667085; font-size: 21rpx; }
.imagePreview { height: 300rpx; margin-top: 10rpx; border-radius: 10rpx; align-items: center; justify-content: center; overflow: hidden; background-color: #eef5ff; }
.previewImage { width: 100%; height: 300rpx; }
.imageModeLabel { margin-top: 12rpx; color: #344054; font-size: 23rpx; }
.imageModeRow { flex-direction: row; flex-wrap: wrap; margin-top: 10rpx; }
.imageModeButton { margin-right: 8rpx; margin-bottom: 8rpx; padding: 8rpx 14rpx; border-radius: 6rpx; background-color: #eef5ff; color: #1677ff; font-size: 20rpx; }
.imageResultRow { flex-direction: row; align-items: center; margin-top: 12rpx; }
.smallImage { width: 180rpx; height: 130rpx; margin-right: 14rpx; border-radius: 8rpx; background-color: #f0f5ff; }
.errorImage { border-width: 1rpx; border-style: solid; border-color: #ffa39e; background-color: #fff1f0; }
.imageResultText { flex: 1; }
.nestBox { padding: 20rpx; border: 1rpx solid #9ec5ff; border-radius: 10rpx; background: #eef5ff; }
.nestTitle { font-size: 26rpx; color: #1677ff; margin-bottom: 12rpx; }
.nestChild { margin-top: 12rpx; padding: 18rpx; border-radius: 8rpx; background: #fff; border: 1rpx solid #d0d5dd; }
.nestChildText { font-size: 24rpx; color: #475467; }
.result { padding: 20rpx; background: #fffbe6; border-radius: 10rpx; margin-bottom: 20rpx; }
.label { font-size: 24rpx; color: #999; }
.value { font-size: 26rpx; color: #333; margin-top: 8rpx; }
</style>
