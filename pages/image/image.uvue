<template>
	<scroll-view class="page">
		<view class="section">
			<text class="h2">image 图片组件</text>
			<text class="desc">验证 src、mode、lazy-load、fade-show、show-menu-by-longpress、draggable、flatten 以及 load/error 事件。</text>
			<view class="hero">
				<image
					id="image_hero"
					class="heroImage"
					:src="imageSrc"
					mode="aspectFill"
					:lazy-load="false"
					:fade-show="true"
					:show-menu-by-longpress="true"
					:data-index="1"
					data-title="主图 aspectFill"
					data-src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png"
					@load="onImageLoad"
					@error="onImageError"
					@click="onImageClick('hero')"
				></image>
			</view>
			<text class="status">{{ lastAction }}</text>
		</view>

		<view class="section">
			<text class="h2">mode 缩放裁剪</text>
			<text class="desc">点击按钮切换当前预览图的 mode，观察 scaleToFill / aspectFit / aspectFill / widthFix / top / center / bottom 等效果。</text>
			<view class="modePreview">
				<image
					id="image_mode_preview"
					class="previewImage"
					:src="imageSrc"
					:mode="currentMode"
					:data-index="2"
					:data-title="'mode=' + currentMode"
					data-src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png"
					@load="onImageLoad"
					@error="onImageError"
					@click="onImageClick(currentMode)"
				></image>
			</view>
			<text class="modeLabel">当前 mode：{{ currentMode }}</text>
			<view class="modeGrid">
				<button
					v-for="item in modes"
					:key="item"
					class="modeBtn"
					:class="currentMode == item ? 'active' : ''"
					@click="setMode(item)"
				>{{ item }}</button>
			</view>
		</view>

		<view class="section">
			<text class="h2">属性组合</text>
			<view class="imageRow">
				<view class="imageCase">
					<image
						id="image_width_fix"
						class="caseImage"
						:src="imageSrc"
						mode="widthFix"
						:lazy-load="true"
						:fade-show="true"
						:data-index="3"
						data-title="widthFix lazy-load"
						data-src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png"
						@load="onImageLoad"
						@error="onImageError"
						@click="onImageClick('widthFix')"
					></image>
					<text class="caseText">widthFix + lazy-load</text>
				</view>
				<view class="imageCase">
					<image
						id="image_flatten"
						class="caseImage"
						:src="imageSrc"
						mode="aspectFit"
						:flatten="true"
						:data-index="4"
						data-title="flatten aspectFit"
						data-src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png"
						@load="onImageLoad"
						@error="onImageError"
						@click="onImageClick('flatten')"
					></image>
					<text class="caseText">flatten + aspectFit</text>
				</view>
			</view>
			<!-- #ifdef WEB -->
			<image
				id="image_draggable"
				class="draggableImage"
				:src="imageSrc"
				mode="aspectFit"
				:draggable="true"
				:data-index="5"
				data-title="Web draggable"
				data-src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png"
				@load="onImageLoad"
				@error="onImageError"
				@click="onImageClick('draggable')"
			></image>
			<text class="caseText">Web：draggable=true，可测试鼠标拖动。</text>
			<!-- #endif -->
		</view>

		<view class="section">
			<text class="h2">load / error 事件</text>
			<text class="hint">成功图片会记录 width / height，错误图片会记录 errMsg。</text>
			<view class="imageRow">
				<image
					id="image_success"
					class="smallImage"
					:src="imageSrc"
					mode="aspectFit"
					:data-index="6"
					data-title="load success"
					data-src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png"
					@load="onImageLoad"
					@error="onImageError"
					@click="onImageClick('success')"
				></image>
				<image
					id="image_error"
					class="smallImage errorBox"
					:src="brokenSrc"
					mode="aspectFit"
					:data-index="7"
					data-title="error case"
					data-src="https://example.invalid/not-found.png"
					@load="onImageLoad"
					@error="onImageError"
					@click="onImageClick('error')"
				></image>
			</view>
			<view class="result">
				<text class="resultText">load：{{ loadInfo }}</text>
				<text class="resultText">error：{{ errorInfo }}</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { gdp } from '@/uni_modules/gio-uniappx-autotracker/gdp.uts'

const imageSrc: string.ImageURIString = 'https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png'
const brokenSrc: string.ImageURIString = 'https://example.invalid/gio-image-demo-not-found.png'
const modes = ref<Array<string>>([
	'scaleToFill',
	'aspectFit',
	'aspectFill',
	'widthFix',
	'heightFix',
	'top',
	'center',
	'bottom',
])
const currentMode = ref('aspectFit')
const lastAction = ref('点击图片或切换 mode，观察 VIEW_CLICK 与 image_demo_click。')
const loadInfo = ref('(waiting)')
const errorInfo = ref('(waiting)')

function setMode(mode: string) {
	currentMode.value = mode
	lastAction.value = '已切换 mode：' + mode
}

function onImageClick(scene: string) {
	gdp('track', 'image_demo_click', {
		scene: scene,
		mode: currentMode.value,
	} as UTSJSONObject)
	lastAction.value = '点击图片：' + scene + '，已发送 image_demo_click。'
}

function onImageLoad(event: ImageLoadEvent) {
	const width = event.detail.width
	const height = event.detail.height
	loadInfo.value = 'width=' + `${width as number}` + ', height=' + `${height as number}`
}

function onImageError(event: ImageErrorEvent) {
	errorInfo.value = event.detail.errMsg
}
</script>

<style>
.page { padding: 20rpx; flex: 1; background: #f8f8f8; }
.section { background: #fff; padding: 22rpx; margin-bottom: 20rpx; border-radius: 10rpx; }
.h2 { font-size: 30rpx; font-weight: bold; color: #222; }
.desc { margin-top: 8rpx; font-size: 24rpx; color: #666; line-height: 36rpx; }
.hero { margin-top: 18rpx; height: 320rpx; border-radius: 10rpx; overflow: hidden; background: #eef5ff; }
.heroImage { width: 100%; height: 320rpx; }
.status { margin-top: 12rpx; font-size: 23rpx; color: #888; }
.modePreview { margin-top: 18rpx; height: 260rpx; background: #f0f5ff; border-radius: 10rpx; align-items: center; justify-content: center; overflow: hidden; }
.previewImage { width: 460rpx; height: 220rpx; background: #e6f4ff; }
.modeLabel { margin-top: 12rpx; font-size: 24rpx; color: #333; }
.modeGrid { margin-top: 12rpx; flex-direction: row; flex-wrap: wrap; }
.modeBtn { margin-right: 10rpx; margin-bottom: 10rpx; padding: 10rpx 18rpx; border-radius: 8rpx; background: #f5f5f5; color: #333; font-size: 22rpx; }
.modeBtn.active { background: #1677ff; color: #fff; }
.imageRow { flex-direction: row; flex-wrap: wrap; margin-top: 16rpx; }
.imageCase { width: 48%; margin-right: 2%; margin-bottom: 16rpx; }
.caseImage { width: 100%; height: 180rpx; background: #f0f5ff; border-radius: 8rpx; }
.caseText { margin-top: 8rpx; font-size: 22rpx; color: #666; }
.draggableImage { margin-top: 16rpx; width: 220rpx; height: 160rpx; background: #f0f5ff; border-radius: 8rpx; }
.hint { margin-top: 8rpx; font-size: 22rpx; color: #888; }
.smallImage { width: 220rpx; height: 160rpx; margin-right: 16rpx; background: #f0f5ff; border-radius: 8rpx; }
.errorBox { background: #fff1f0; border: 1rpx solid #ffa39e; }
.result { margin-top: 12rpx; padding: 16rpx; background: #fffbe6; border-radius: 8rpx; }
.resultText { font-size: 23rpx; color: #333; margin-bottom: 6rpx; }
</style>
