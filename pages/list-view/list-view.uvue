<template>
	<view class="page">
		<view class="header">
			<text class="title">list-view 长列表</text>
			<text class="desc">使用 list-view / list-item 验证长列表、下拉刷新、触底追加和列表项点击。</text>
			<view class="actions">
				<button class="btn" @click="scrollToTopItem">到顶部</button>
				<button class="btn ghost" @click="scrollToMiddleItem">到中间</button>
				<button class="btn ghost" @click="scrollToLastItem">到底部</button>
			</view>
			<text class="status">{{ lastAction }}</text>
		</view>

		<list-view
			class="list"
			direction="vertical"
			:show-scrollbar="true"
			:scroll-with-animation="true"
			:scroll-into-view="scrollIntoView"
			:refresher-enabled="true"
			:refresher-triggered="refresherTriggered"
			refresher-default-style="black"
			@refresherrefresh="onRefresherRefresh"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
			@scrolltolower="onScrollToLower"
			@scrolltoupper="onScrollToUpper"
			@scrollend="onScrollEnd"
		>
			<list-item
				v-for="item in items"
				:id="item.id"
				:key="item.id"
				class="listItem"
				:data-index="item.index"
				:data-title="item.title"
				:data-src="item.src"
				@click="onItemClick(item)"
			>
				<view class="itemMain">
					<view class="itemBadge">
						<text class="itemBadgeText">{{ item.index }}</text>
					</view>
					<view class="itemContent">
						<text class="itemTitle">{{ item.title }}</text>
						<text class="itemDesc">{{ item.desc }}</text>
						<text class="itemTag">{{ item.tag }}</text>
					</view>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { gdp } from '@/uni_modules/gio-uniappx-autotracker/gdp.uts'

type DemoListItem = {
	id: string
	index: number
	title: string
	desc: string
	tag: string
	src: string
}

function buildItems(startIndex: number, count: number): Array<DemoListItem> {
	const list: Array<DemoListItem> = []
	for (let i = 0; i < count; i++) {
		const index = startIndex + i
		list.push({
			id: 'list_item_' + index,
			index: index,
			title: '商品卡片 #' + index,
			desc: '这是 list-view 中的第 ' + index + ' 个 list-item，用于验证长列表复用和自动点击采集。',
			tag: index % 2 == 0 ? '推荐' : '热销',
			src: '/pages/list-view/list-view?item=' + index,
		})
	}
	return list
}

const items = ref<Array<DemoListItem>>(buildItems(1, 30))
const refresherTriggered = ref(false)
const scrollIntoView = ref('')
const lastAction = ref('拖动列表或点击列表项，观察 PAGE / VIEW_CLICK / 自定义 track。')
let nextIndex = 31

function setAction(text: string) {
	lastAction.value = text
}

function appendItems(count: number) {
	const more = buildItems(nextIndex, count)
	for (let i = 0; i < more.length; i++) {
		items.value.push(more[i])
	}
	nextIndex += count
}

function prependItems(count: number) {
	const more = buildItems(nextIndex, count)
	for (let i = more.length - 1; i >= 0; i--) {
		items.value.unshift(more[i])
	}
	nextIndex += count
}

function onRefresherRefresh() {
	refresherTriggered.value = true
	setAction('下拉刷新触发，正在前置 3 条数据。')
	setTimeout(() => {
		prependItems(3)
		refresherTriggered.value = false
		setAction('刷新完成：当前 ' + (items.value.length as number) + ' 条。')
	}, 800)
}

function onRefresherRestore() {
	setAction('下拉刷新已复位。')
}

function onRefresherAbort() {
	setAction('下拉刷新已中止。')
}

function onScrollToLower() {
	appendItems(8)
	setAction('触底追加 8 条：当前 ' + (items.value.length as number) + ' 条。')
}

function onScrollToUpper() {
	setAction('已滚动到顶部。')
}

function onScrollEnd() {
	setAction('滚动结束。')
}

function scrollToTopItem() {
	if ((items.value.length as number) == 0) {
		return
	}
	scrollIntoView.value = items.value[0].id
	setAction('滚动到顶部列表项。')
}

function scrollToMiddleItem() {
	const count = items.value.length as number
	if (count == 0) {
		return
	}
	const middle = Math.floor(count / 2)
	scrollIntoView.value = items.value[middle].id
	setAction('滚动到中间列表项。')
}

function scrollToLastItem() {
	const count = items.value.length as number
	if (count == 0) {
		return
	}
	scrollIntoView.value = items.value[count - 1].id
	setAction('滚动到底部列表项。')
}

function onItemClick(item: DemoListItem) {
	gdp('track', 'list_view_item_click', {
		itemIndex: item.index,
		itemTitle: item.title,
		itemTag: item.tag,
	} as UTSJSONObject)
	setAction('点击了 ' + item.title + '，已发送 list_view_item_click。')
}
</script>

<style>
.page { flex: 1; background: #f8f8f8; }
.header { padding: 24rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.title { font-size: 34rpx; font-weight: bold; color: #222; }
.desc { margin-top: 8rpx; font-size: 24rpx; color: #666; line-height: 36rpx; }
.actions { flex-direction: row; flex-wrap: wrap; margin-top: 18rpx; }
.btn { margin-right: 12rpx; margin-bottom: 10rpx; padding: 12rpx 22rpx; border-radius: 8rpx; background: #1677ff; color: #fff; font-size: 24rpx; }
.btn.ghost { background: #fff; color: #1677ff; border: 1rpx solid #1677ff; }
.status { margin-top: 4rpx; font-size: 22rpx; color: #888; }
.list { flex: 1; }
.listItem { margin: 0 20rpx 16rpx; border-radius: 10rpx; background: #fff; border: 1rpx solid #eee; }
.itemMain { flex-direction: row; align-items: center; padding: 22rpx; }
.itemBadge { width: 64rpx; height: 64rpx; border-radius: 8rpx; background: #e6f4ff; align-items: center; justify-content: center; margin-right: 18rpx; }
.itemBadgeText { color: #1677ff; font-size: 24rpx; font-weight: bold; }
.itemContent { flex: 1; }
.itemTitle { font-size: 28rpx; color: #222; font-weight: 500; }
.itemDesc { margin-top: 8rpx; font-size: 23rpx; color: #666; line-height: 34rpx; }
.itemTag { margin-top: 10rpx; font-size: 22rpx; color: #13a87f; }
</style>
