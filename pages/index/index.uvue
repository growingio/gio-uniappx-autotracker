<template>
	<scroll-view class="container">
		<view class="header">
			<text class="title">GrowingIO uni-app-x SDK</text>
			<text class="subtitle">Minimal showcase · VISIT / PAGE / APP_CLOSED / ABTest / setOptions</text>
		</view>

		<view class="section">
			<text class="section-title">当前版本能演示什么</text>
			<text class="hint">1. 首次进入或 session 过期后，会自动发 `VISIT`。</text>
			<text class="hint">2. 每次页面显示，会自动发 `PAGE`，并尽量带 `path/query/title/referralPage`。</text>
			<text class="hint">3. 应用退后台时，会自动发 `APP_CLOSED`，并尽量带当前页停留时长。</text>
			<text class="hint">4. 业务事件可以通过 `gdp('track', ...)` 发送；调用层传 `properties`，请求体里会映射成 `attributes`。</text>
			<text class="hint">5. 用户属性可以通过 `gdp('setUserAttributes', ...)` 发送；请求体里会生成单独的 `LOGIN_USER_ATTRIBUTES` 事件。</text>
		</view>

		<view class="section">
			<text class="section-title">功能演示（7 个主题页）</text>
			<view class="card-list">
				<view
					id="home_entry_custom_event"
					class="card"
					:data-index="1"
					data-title="进入自定义事件演示页"
					data-src="/pages/custom-event/custom-event"
					@click="go('custom-event')"
				>
					<text class="card-title">① 自定义事件 / track</text>
					<text class="card-desc">覆盖典型、边界和业务埋点场景，方便在网络面板里看最终 body。</text>
				</view>
				<view
					id="home_entry_user"
					class="card"
					:data-index="2"
					data-title="进入用户身份演示页"
					data-src="/pages/user/user"
					@click="go('user')"
				>
					<text class="card-title">② 用户身份 / setUserId / setUserAttributes</text>
					<text class="card-desc">切换 userId、userKey 和用户属性，观察请求体变化。</text>
				</view>
				<view
					id="home_entry_lifecycle"
					class="card"
					:data-index="3"
					data-title="进入生命周期演示页"
					data-src="/pages/lifecycle/lifecycle"
					@click="go('lifecycle')"
				>
					<text class="card-title">③ 生命周期 / VISIT / PAGE / APP_CLOSED</text>
					<text class="card-desc">通过切页、切后台来验证关键事件触发时机。</text>
				</view>
				<view
					id="home_entry_autotrack"
					class="card"
					:data-index="4"
					data-title="进入无埋点演示页"
					data-src="/pages/autotrack/autotrack"
					@click="go('autotrack')"
				>
					<text class="card-title">④ 无埋点 / VIEW_CLICK / VIEW_CHANGE</text>
					<text class="card-desc">一个页面覆盖 click/change、组件矩阵、方法引用、list-view、image、dataset、忽略规则和 tabBar。</text>
				</view>
				<view
					id="home_entry_route"
					class="card"
					:data-index="5"
					data-title="进入路由演示页"
					data-src="/pages/route/route"
					@click="go('route')"
				>
					<text class="card-title">⑤ 路由 / referralPage / query</text>
					<text class="card-desc">带 query 跳转，帮助验证 page 级上下文字段。</text>
				</view>
				<view
					id="home_entry_abtest"
					class="card"
					:data-index="6"
					data-title="进入 ABTest 演示页"
					data-src="/pages/abtest/abtest"
					@click="go('abtest')"
				>
					<text class="card-title">⑥ ABTest / registerPlugins / getABTest</text>
					<text class="card-desc">当前插件层只考虑 gioABTest，先按小程序逻辑对齐。</text>
				</view>
				<view
					id="home_entry_datacollect"
					class="card"
					:data-index="7"
					data-title="进入数据采集开关演示页"
					data-src="/pages/datacollect/datacollect"
					@click="go('datacollect')"
				>
					<text class="card-title">⑦ 数据采集开关 / setOptions</text>
					<text class="card-desc">动态切换 dataCollect，控制 SDK 是否采集数据。关闭后事件不上报，开启后恢复。</text>
				</view>
				<!-- #ifdef MP-WEIXIN -->
				<view
					id="home_entry_share"
					class="card"
					:data-index="8"
					data-title="进入微信分享演示页"
					data-src="/pages/share/share"
					@click="go('share')"
				>
					<text class="card-title">⑥ 分享 / 朋友圈 / 收藏（仅小程序）</text>
					<text class="card-desc">注册 gioShareTracking 后按微信原生分享钩子采集 $mp_on_share / $mp_share_timeline / $mp_add_favorites。</text>
				</view>
				<!-- #endif -->
			</view>
		</view>

		<view class="section">
			<text class="section-title">快捷动作</text>
			<view class="btn-row">
				<button class="btn" @click="onTrackQuick">发一条首页事件</button>
				<button class="btn" @click="onGoRouteWithParams">去路由页(带参)</button>
				<button class="btn ghost" @click="onRefreshNote">刷新说明</button>
			</view>
			<text class="hint">{{ lastNote }}</text>
		</view>
	</scroll-view>
</template>

<script lang="uts">
import { gdp } from '@/uni_modules/gio-uniappx-autotracker/gdp.uts'

export default {
	data() {
		return {
			lastNote: '建议同时打开控制台和网络面板观察请求体。',
		}
	},
	onShow() {
		console.log('index onShow')
	},
	methods: {
		isTabBarPage(name: string): boolean {
			return (
				name == 'index' ||
				name == 'custom-event' ||
				name == 'user' ||
				name == 'autotrack'
			)
		},
		go(name: string) {
			const url = `/pages/${name}/${name}`
			if (this.isTabBarPage(name)) {
				uni.switchTab({ url })
				return
			}
			uni.navigateTo({ url })
		},
		onGoRouteWithParams() {
			uni.navigateTo({
				url: '/pages/route/route?from=index&ts=' + Date.now() + '&tag=quick',
			})
		},
		onTrackQuick() {
			gdp('track', 'home_quick_track', {
				from: 'index',
				tick: Date.now(),
			} as UTSJSONObject)
			this.lastNote = '已发送 home_quick_track，请查看请求体。'
		},
		onRefreshNote() {
			this.lastNote = '当前公开 API 已收口为 gdp(...)，微信分享采集需要注册 gioShareTracking。'
		},
	},
}
</script>

<style>
.container { padding: 20rpx; flex: 1; }
.header { padding: 40rpx 20rpx; text-align: center; }
.title { font-size: 40rpx; font-weight: bold; }
