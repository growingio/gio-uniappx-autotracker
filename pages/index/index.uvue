.section { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-top: 20rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.card-list { display: flex; flex-direction: column; }
.card { padding: 24rpx; border: 1rpx solid #eee; border-radius: 10rpx; margin-bottom: 16rpx; }
.card-title { font-size: 28rpx; font-weight: 500; color: #1677ff; }
.card-desc { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.btn-row { flex-direction: row; flex-wrap: wrap; }
.btn { background: #1677ff; color: #fff; font-size: 26rpx; padding: 16rpx 32rpx; border-radius: 8rpx; margin: 8rpx; }
.btn.ghost { background: #fff; color: #1677ff; border: 1rpx solid #1677ff; }
.hint { font-size: 22rpx; color: #888; padding: 6rpx 0; }
</style>
