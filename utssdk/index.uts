import { normalizeInitOptions } from './common/config.uts'
import { GioPluginItem } from './interface.uts'
import { GioTracker } from './common/core/tracker.uts'

const tracker = GioTracker.getInstance()

// NOTE: do NOT re-export gioUniappxAutotracker here. This file is the uts
// NATIVE module entry; re-exporting plugin.uts would pull it into the native
// (Kotlin/Swift) compile where the Vue global `defineMixin` is not in scope.
// The app-facing root index.uts re-exports the plugin (in Vue context) instead.

export function initialize (options : UTSJSONObject) : boolean {
  return tracker.initialize(normalizeInitOptions(options))
}

export function track(eventName : string, properties : UTSJSONObject | null = null) : boolean {
  return tracker.track(eventName, properties)
}

export function setUserId(userId : string, userKey : string | null = null) : boolean {
  return tracker.setUserId(userId, userKey)
}

export function setUserAttributes (userAttributes : UTSJSONObject | null) : boolean {
  return tracker.setUserAttributes(userAttributes)
}

export function identify (assignmentId : any) : boolean {
  return tracker.identify(assignmentId)
}

export function clearUserId () : boolean {
  return tracker.clearUserId()
}

export function setUserKey (userKey : string) : boolean {
  return tracker.setUserKey(userKey)
}

export function registerPlugins (plugins : Array<any>) : boolean {
  // The JS bridge passes plain objects (UTSJSONObject elements). Force-casting
  // the whole array `as Array<GioPluginItem>` triggers Swift `_arrayForceCast`
  // which fails at runtime (elements aren't GioPluginItem instances) → SIGABRT
  // on startup. Convert element-by-element instead, reading the typed fields.
  const items = [] as Array<GioPluginItem>
  for (let i = 0; i < plugins.length; i++) {
    const raw = plugins[i] as UTSJSONObject
    const nameValue = raw['name']
    if (nameValue == null) {
      continue
    }
    const optionsValue = raw['options']
    items.push({
      name: `${nameValue}`,
      options: optionsValue != null ? (optionsValue as UTSJSONObject) : null
    } as GioPluginItem)
  }
  return tracker.registerPlugins(items)
}

export function getABTest(
  layerId : any,
  callback : ((result : any) => void) | null = null
) : boolean {
  return tracker.getABTest(layerId, callback)
}
