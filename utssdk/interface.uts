export type GioReportSuccess = {
  errMsg : string
}

export type GioReportErrorCode =
  62000 |
  62001 |
  62002 |
  62003

export type GioReportError = {
  errCode : GioReportErrorCode
  errMsg : string
  message : string
  name : string
}

export type GioReportFail = GioReportError
export type GioReportSuccessCallback = (res : GioReportSuccess) => void
export type GioReportFailCallback = (err : GioReportFail) => void
export type GioReportCompleteCallback = (res : any) => void

export type GioInitOptions = {
  projectId : string
  dataSourceId : string
  appId : string
  serverUrl : string
  appVersion : string | null
  cookieDomain : string | null
  // UTS-iOS can't represent a nullable boolean (collapses `boolean | null` to a
  // non-null `Bool = false`), so these stay plain booleans; their "unspecified"
  // defaults are resolved in normalizeInitOptions (config.uts).
  debug : boolean
  forceLogin : boolean
  originalSource : boolean
  followShare : boolean
  storageType : string | null
}

export type GioPluginItem = {
  name : string
  options : UTSJSONObject | null
}

export type GioABTestPluginOptions = {
  abServerUrl : string | null
  requestInterval : number | null
  requestTimeout : number | null
}

export type GioABTestResult = {
  layerId : string
  strategyId : string
  experimentId : string
  layerName : string | null
  experimentName : string | null
  strategyName : string | null
  variables : UTSJSONObject | null
}

export type GioABTestCallback = (result : GioABTestResult | UTSJSONObject) => void

// Storage contract shared by the common engine and the platform adapters.
// UTS cannot call methods on an `any`-typed value, so storage must be typed
// through this interface rather than passed around as `any`.
export interface GioStorage {
  getItem(key : string) : any | null
  setItem(key : string, value : any, expiredAt : number | null) : void
  removeItem(key : string) : void
  hasItem(key : string) : boolean
  getKeys() : Array<string>
}

export type GioContext = {
  deviceId : string
  sessionId : string
  userId : string | null
  userKey : string | null
}

export type GioPageContext = {
  path : string
  query : string | null
  title : string | null
  referralPage : string | null
  duration : number | null
}

export type GioOriginalSource = {
  sessionId : string
  path : string
  query : string
  title : string
  referralPage : string
}

export type GioTrackEvent = {
  appChannel : string | null
  appVersion : string
  dataSourceId : string
  deviceBrand : string
  deviceId : string
  deviceModel : string | null
  deviceType : string | null
  domain : string
  eventName : string | null
  eventSequenceId : number | null
  eventType : string
  language : string
  latitude : number | null
  longitude : number | null
  networkState : string | null
  operatingSystem : string | null
  path : string | null
  platform : string
  platformVersion : string
  query : string | null
  referralPage : string | null
  screenHeight : number
  screenWidth : number
  sdkVersion : string
  sessionId : string
  timestamp : number
  timezoneOffset : number
  title : string
  userId : string | null
  userKey : string | null
  attributes : UTSJSONObject | null
}

// Provides the two storage instances. Implemented by GioStorageContainer.
// Declared after the types it depends on — UTS does not hoist forward
// references from `export interface` member signatures.
export interface GioStorageProvider {
  getMainStorage() : GioStorage
  getOriginalSourceStorage() : GioStorage
}

// The slice of the tracker that plugins (e.g. ABTest) depend on. Declared here
// to break the tracker<->plugin import cycle; UTS cannot dot-access an `any`
// tracker, so plugins type it through this interface. Implemented by GioTracker.
export interface GioABTestHost {
  getStorage() : GioStorageProvider
  getContext() : GioContext | null
  getOptions() : GioInitOptions | null
  trackPluginEvent(eventName : string, properties : UTSJSONObject | null) : boolean
}

// 平台侧「分享 / 收藏」处理器所依赖的 host 能力，由 GioTracker 实现。把发事件、
// 取当前页上下文、翻 shareOut、读 followShare 这些平台无关的能力暴露出去，使各端
// 独有的事件名 / 字段集 / 翻转策略可以收敛到各自平台目录（如 mp-weixin），不进公共层。
export interface GioShareHost {
  isFollowShareEnabled() : boolean
  getCurrentPageContext() : GioPageContext | null
  setShareOut(value : boolean) : void
  emitShareEvent(eventName : string, properties : UTSJSONObject | null) : void
}
