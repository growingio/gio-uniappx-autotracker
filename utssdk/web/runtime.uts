import {
  GioInitOptions,
  GioPageContext,
  GioTrackEvent
} from '../interface.uts'
import {
  registerEventShaper,
  registerPageContextResolver,
  registerPlatformStorageFactory,
  registerRuntimeBehavior
} from '../common/runtime/index.uts'
import {
  buildCookieStorageValue,
  buildWrappedStorageValue,
  getActualStorageKey,
  getDefaultStorageExpiredAt,
  readDirectStorageValue,
  readStructuredStorageValue
} from '../common/storage/index.uts'

const SPECIAL_TOP_DOMAIN_PREFIXES = [
  '.ac.',
  '.br.',
  '.co.',
  '.com.',
  '.edu.',
  '.gov.',
  '.org.',
  '.net.'
] as Array<string>

function getRuntimeDocument() : any | null {
  try {
    const runtimeGlobal = globalThis as any
    return runtimeGlobal.document != null ? runtimeGlobal.document : null
  } catch (_error) {
    return null
  }
}

function getRuntimeLocation() : any | null {
  try {
    const runtimeGlobal = globalThis as any
    return runtimeGlobal.location != null ? runtimeGlobal.location : null
  } catch (_error) {
    return null
  }
}

function getRuntimeLocalStorage() : any | null {
  try {
    const runtimeGlobal = globalThis as any
    return runtimeGlobal.localStorage != null ? runtimeGlobal.localStorage : null
  } catch (_error) {
    return null
  }
}

function decodeCookieValue(value : string) : string {
  try {
    return decodeURIComponent(value)
  } catch (_error) {
    return value
  }
}

function encodeCookieValue(value : string) : string {
  try {
    return encodeURIComponent(value)
  } catch (_error) {
    return value
  }
}

function isIpHost(hostname : string) : boolean {
  const segments = hostname.split('.')
  if (segments.length != 4) {
    return false
  }
  for (let i = 0; i < segments.length; i++) {
    const part = segments[i]
    if (part.length == 0 || isNaN(Number(part))) {
      return false
    }
  }
  return true
}

function isSpecialTopDomain(domain : string) : boolean {
  for (let i = 0; i < SPECIAL_TOP_DOMAIN_PREFIXES.length; i++) {
    if (domain.startsWith(SPECIAL_TOP_DOMAIN_PREFIXES[i])) {
      return true
    }
  }
  return false
}

function domainParse(hostname : string) : Array<string> {
  const domains = [] as Array<string>
  const segments = hostname.split('.')
  if (segments.length < 2 || isIpHost(hostname)) {
    return domains
  }
  const domain2 = `.${segments.slice(segments.length - 2).join('.')}`
  if (!isSpecialTopDomain(domain2)) {
    domains.push(domain2)
  }
  if (segments.length >= 3) {
    const domain3 = `.${segments.slice(segments.length - 3).join('.')}`
    if (!isSpecialTopDomain(domain3) && domains.indexOf(domain3) < 0) {
      domains.push(domain3)
    }
  }
  if (segments.length >= 4) {
    const domain4 = `.${segments.slice(segments.length - 4).join('.')}`
    if (!isSpecialTopDomain(domain4) && domains.indexOf(domain4) < 0) {
      domains.push(domain4)
    }
  }
  return domains
}

function readCookieMap() : UTSJSONObject {
  const result = {} as UTSJSONObject
  const runtimeDocument = getRuntimeDocument()
  if (runtimeDocument == null || runtimeDocument.cookie == null) {
    return result
  }
  const cookieText = `${runtimeDocument.cookie}`
  if (cookieText.length == 0) {
    return result
  }
  const pairs = cookieText.split(';')
  for (let i = 0; i < pairs.length; i++) {
    const item = pairs[i].trim()
    if (item.length == 0) {
      continue
    }
    const equalIndex = item.indexOf('=')
    if (equalIndex < 0) {
      result[item] = ''
      continue
    }
    const key = item.slice(0, equalIndex)
    const value = item.slice(equalIndex + 1)
    result[key] = decodeCookieValue(value)
  }
  return result
}

function writeCookie(
  key : string,
  value : string,
  expiredAt : number,
  domain : string
) {
  const runtimeDocument = getRuntimeDocument()
  if (runtimeDocument == null) {
    return
  }
  let cookieText = `${key}=${encodeCookieValue(value)}; expires=${new Date(expiredAt).toUTCString()}; path=/`
  if (domain.length > 0) {
    cookieText += `; domain=${domain}`
  }
  runtimeDocument.cookie = cookieText
}

function removeCookie(key : string, domain : string) {
  writeCookie(key, '', 1, domain)
}

function testCookie(domain : string) : boolean {
  const runtimeLocation = getRuntimeLocation()
  if (runtimeLocation == null) {
    return false
  }
  const hostname = runtimeLocation.hostname != null
    ? `${runtimeLocation.hostname}`
    : ''
  const protocol = runtimeLocation.protocol != null
    ? `${runtimeLocation.protocol}`
    : ''
  if (
    hostname.length == 0 ||
    hostname == 'localhost' ||
    hostname == '127.0.0.1' ||
    (protocol != 'http:' && protocol != 'https:')
  ) {
    return false
  }
  const testKey = 'gioCookie'
  writeCookie(testKey, 'yes', Date.now() + 60 * 1000, domain)
  const cookieMap = readCookieMap()
  const valid = cookieMap[testKey] != null && `${cookieMap[testKey]}` == 'yes'
  removeCookie(testKey, domain)
  return valid
}

function resolveCookieDomain(requestedDomain : string) : string {
  if (requestedDomain.length > 0 && testCookie(requestedDomain)) {
    return requestedDomain
  }
  const runtimeLocation = getRuntimeLocation()
  if (runtimeLocation == null || runtimeLocation.hostname == null) {
    return ''
  }
  const hostname = `${runtimeLocation.hostname}`
  const candidates = domainParse(hostname)
  candidates.push(hostname)
  for (let i = 0; i < candidates.length; i++) {
    if (testCookie(candidates[i])) {
      return candidates[i]
    }
  }
  return ''
}

function canUseLocalStorage() : boolean {
  try {
    const storage = getRuntimeLocalStorage()
    if (storage == null) {
      return false
    }
    storage.setItem('__gio_storage_test__', '__gio_storage_test__')
    storage.removeItem('__gio_storage_test__')
    return true
  } catch (_error) {
    return false
  }
}

function readLocalItem(key : string) : string | null {
  const storage = getRuntimeLocalStorage()
  if (storage == null) {
    return null
  }
  const value = storage.getItem(key)
  return value != null ? `${value}` : null
}

function writeLocalItem(key : string, value : string) {
  const storage = getRuntimeLocalStorage()
  if (storage == null) {
    return
  }
  storage.setItem(key, value)
}

function removeLocalItem(key : string) {
  const storage = getRuntimeLocalStorage()
  if (storage == null) {
    return
  }
  storage.removeItem(key)
}

function getLocalKeys() : Array<string> {
  const storage = getRuntimeLocalStorage()
  if (storage == null) {
    return [] as Array<string>
  }
  const keys = [] as Array<string>
  const length = Number(storage.length != null ? storage.length : 0)
  for (let i = 0; i < length; i++) {
    const key = storage.key(i)
    if (key != null) {
      keys.push(`${key}`)
    }
  }
  return keys
}

function getCookieKeys() : Array<string> {
  return Object.keys(readCookieMap())
}

function createCookieStorage(domain : string) : GioStorage {
  return {
    getItem(key : string) : any | null {
      const cookieValue = readCookieMap()[getActualStorageKey(key)]
      if (cookieValue == null) {
        return null
      }
      return readDirectStorageValue(key, `${cookieValue}`)
    },
    setItem(key : string, value : any, expiredAt : number | null) {
      writeCookie(
        getActualStorageKey(key),
        buildCookieStorageValue(key, value),
        expiredAt != null && expiredAt > 0
          ? expiredAt
          : getDefaultStorageExpiredAt(),
        domain
      )
    },
    setRawItem(key : string, value : any) {
      writeCookie(
        getActualStorageKey(key),
        `${value}`,
        getDefaultStorageExpiredAt(),
        domain
      )
    },
    removeItem(key : string) {
      removeCookie(getActualStorageKey(key), domain)
    },
    hasItem(key : string) : boolean {
      return this.getItem(key) != null
    },
    getKeys() : Array<string> {
      return getCookieKeys()
    }
  }
}

function createLocalStorageAdapter() : GioStorage {
  return {
    getItem(key : string) : any | null {
      return readStructuredStorageValue(
        key,
        readLocalItem(getActualStorageKey(key))
      )
    },
    setItem(key : string, value : any, expiredAt : number | null) {
      writeLocalItem(
        getActualStorageKey(key),
        buildWrappedStorageValue(key, value, expiredAt)
      )
    },
    setRawItem(key : string, value : any) {
      writeLocalItem(getActualStorageKey(key), `${value}`)
    },
    removeItem(key : string) {
      removeLocalItem(getActualStorageKey(key))
      if (getActualStorageKey(key) != key) {
        removeLocalItem(key)
      }
    },
    hasItem(key : string) : boolean {
      return this.getItem(key) != null
    },
    getKeys() : Array<string> {
      return getLocalKeys()
    }
  }
}

function normalizeQueryString(queryText : string) : string {
  if (queryText.length == 0) {
    return ''
  }
  let normalizedQuery = queryText
  if (normalizedQuery.startsWith('?') || normalizedQuery.startsWith('&')) {
    normalizedQuery = normalizedQuery.slice(1)
  }
  const hashIndex = normalizedQuery.indexOf('#')
  if (hashIndex >= 0) {
    normalizedQuery = normalizedQuery.slice(0, hashIndex)
  }
  if (normalizedQuery.length == 0) {
    return ''
  }
  const segments = normalizedQuery.split('&')
  const parts = [] as Array<string>
  for (let i = 0; i < segments.length; i++) {
    const segment = segments[i]
    if (segment.length == 0) {
      continue
    }
    let key = segment
    let value = ''
    const equalIndex = segment.indexOf('=')
    if (equalIndex >= 0) {
      key = segment.slice(0, equalIndex)
      value = segment.slice(equalIndex + 1)
    }
    if (key.length == 0) {
      continue
    }
    parts.push(`${key}=${value}`)
  }
  if (parts.length == 0) {
    return ''
  }
  return parts.join('&')
}

function mergeQueryString(baseQuery : string, appendedQuery : string) : string {
  if (baseQuery.length == 0) {
    return appendedQuery
  }
  if (appendedQuery.length == 0) {
    return baseQuery
  }
  return `${baseQuery}&${appendedQuery}`
}

function readDocumentReferrer() : string {
  try {
    const runtimeDocument = getRuntimeDocument()
    if (
      runtimeDocument != null &&
      runtimeDocument.referrer != null &&
      `${runtimeDocument.referrer}`.length > 0
    ) {
      return `${runtimeDocument.referrer}`
    }
  } catch (_error) {}
  return ''
}

let lastPageFullUrl : string = ''

function readCurrentHref() : string {
  try {
    const runtimeLocation = getRuntimeLocation()
    if (runtimeLocation != null && runtimeLocation.href != null) {
      return `${runtimeLocation.href}`
    }
  } catch (_error) {}
  return ''
}

function resolveBrowserPageContext(
  logicalPageContext : GioPageContext | null
) : GioPageContext | null {
  let path = ''
  let query = ''
  let title = ''
  try {
    const runtimeLocation = getRuntimeLocation()
    const runtimeDocument = getRuntimeDocument()
    if (runtimeLocation != null) {
      const pathname = runtimeLocation.pathname != null
        ? `${runtimeLocation.pathname}`
        : ''
      const search = runtimeLocation.search != null
        ? `${runtimeLocation.search}`
        : ''
      const hash = runtimeLocation.hash != null
        ? `${runtimeLocation.hash}`
        : ''
      path = pathname
      query = normalizeQueryString(search)
      if (hash.length > 0) {
        const hashQueryIndex = hash.indexOf('?')
        if (hashQueryIndex >= 0) {
          path += hash.slice(0, hashQueryIndex)
          query = mergeQueryString(
            query,
            normalizeQueryString(hash.slice(hashQueryIndex + 1))
          )
        } else {
          path += hash
        }
      }
    }
    if (
      runtimeDocument != null &&
      runtimeDocument.title != null
    ) {
      title = `${runtimeDocument.title}`
    }
  } catch (_error) {}
  if (path.length == 0 && logicalPageContext != null) {
    path = logicalPageContext.path
  }
  if (path.length == 0) {
    return null
  }
  if (
    title.length == 0 &&
    logicalPageContext != null &&
    logicalPageContext.title != null &&
    logicalPageContext.title.length > 0
  ) {
    title = logicalPageContext.title
  }
  const documentReferrer = readDocumentReferrer()
  const currentHref = readCurrentHref()
  const previousPageUrl = lastPageFullUrl
  lastPageFullUrl = currentHref.length > 0 ? currentHref : lastPageFullUrl
  return {
    path: path,
    query: query,
    title: title,
    referralPage: previousPageUrl.length > 0
      ? previousPageUrl
      : documentReferrer,
    duration: logicalPageContext != null ? logicalPageContext.duration : null
  } as GioPageContext
}

registerPlatformStorageFactory({
  createMainStorage(options : GioInitOptions, fallback : any) : any {
    const requestedStorageType = options.storageType != null
      ? options.storageType.toLowerCase()
      : 'cookie'
    if (requestedStorageType == 'cookie') {
      const cookieDomain = resolveCookieDomain(
        options.cookieDomain != null ? options.cookieDomain : ''
      )
      if (cookieDomain.length > 0) {
        return createCookieStorage(cookieDomain)
      }
    }
    if (canUseLocalStorage()) {
      return createLocalStorageAdapter()
    }
    return fallback
  },
  createOriginalSourceStorage(_options : GioInitOptions, fallback : any) : any {
    if (canUseLocalStorage()) {
      return createLocalStorageAdapter()
    }
    return fallback
  }
})

registerPageContextResolver({
  resolvePageContext(pageContext : GioPageContext | null) : GioPageContext | null {
    return resolveBrowserPageContext(pageContext)
  }
})

registerRuntimeBehavior({
  scheduleVisitAndPage(dispatch : (() => void)) {
    setTimeout(() => {
      dispatch()
    }, 0)
  },
  shouldTrackAppClosed() : boolean {
    return false
  }
})

registerEventShaper({
  shapeTrackEvent(event : GioTrackEvent) : GioTrackEvent {
    event.appChannel = null
    event.deviceModel = null
    event.deviceType = null
    event.networkState = null
    event.operatingSystem = null
    event.platform = 'web'
    event.platformVersion = null
    return event
  }
})
