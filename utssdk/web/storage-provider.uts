import { registerWebStorageProvider } from '../common/storage/index.uts'

const SPECIAL_TOP_DOMAIN_PREFIXES = [
  '.ac.',
  '.br.',
  '.co.',
  '.com.',
  '.edu.',
  '.gov.',
  '.org.',
  '.net.'
] as Array<string>

function getRuntimeDocument() : any | null {
  try {
    const runtimeGlobal = globalThis as any
    return runtimeGlobal.document != null ? runtimeGlobal.document : null
  } catch (_error) {
    return null
  }
}

function getRuntimeLocation() : any | null {
  try {
    const runtimeGlobal = globalThis as any
    return runtimeGlobal.location != null ? runtimeGlobal.location : null
  } catch (_error) {
    return null
  }
}

function getRuntimeLocalStorage() : any | null {
  try {
    const runtimeGlobal = globalThis as any
    return runtimeGlobal.localStorage != null ? runtimeGlobal.localStorage : null
  } catch (_error) {
    return null
  }
}

function decodeCookieValue(value : string) : string {
  try {
    return decodeURIComponent(value)
  } catch (_error) {
    return value
  }
}

function encodeCookieValue(value : string) : string {
  try {
    return encodeURIComponent(value)
  } catch (_error) {
    return value
  }
}

function isIpHost(hostname : string) : boolean {
  const segments = hostname.split('.')
  if (segments.length != 4) {
    return false
  }
  for (let i = 0; i < segments.length; i++) {
    const part = segments[i]
    if (part.length == 0 || isNaN(Number(part))) {
      return false
    }
  }
  return true
}

function isSpecialTopDomain(domain : string) : boolean {
  for (let i = 0; i < SPECIAL_TOP_DOMAIN_PREFIXES.length; i++) {
    if (domain.startsWith(SPECIAL_TOP_DOMAIN_PREFIXES[i])) {
      return true
    }
  }
  return false
}

function domainParse(hostname : string) : Array<string> {
  const domains = [] as Array<string>
  const segments = hostname.split('.')
  if (segments.length < 2 || isIpHost(hostname)) {
    return domains
  }
  const domain2 = `.${segments.slice(segments.length - 2).join('.')}`
  if (!isSpecialTopDomain(domain2)) {
    domains.push(domain2)
  }
  if (segments.length >= 3) {
    const domain3 = `.${segments.slice(segments.length - 3).join('.')}`
    if (!isSpecialTopDomain(domain3) && domains.indexOf(domain3) < 0) {
      domains.push(domain3)
    }
  }
  if (segments.length >= 4) {
    const domain4 = `.${segments.slice(segments.length - 4).join('.')}`
    if (!isSpecialTopDomain(domain4) && domains.indexOf(domain4) < 0) {
      domains.push(domain4)
    }
  }
  return domains
}

function readCookieMap() : UTSJSONObject {
  const result = {} as UTSJSONObject
  const runtimeDocument = getRuntimeDocument()
  if (runtimeDocument == null || runtimeDocument.cookie == null) {
    return result
  }
  const cookieText = `${runtimeDocument.cookie}`
  if (cookieText.length == 0) {
    return result
  }
  const pairs = cookieText.split(';')
  for (let i = 0; i < pairs.length; i++) {
    const item = pairs[i].trim()
    if (item.length == 0) {
      continue
    }
    const equalIndex = item.indexOf('=')
    if (equalIndex < 0) {
      result[item] = ''
      continue
    }
    const key = item.slice(0, equalIndex)
    const value = item.slice(equalIndex + 1)
    result[key] = decodeCookieValue(value)
  }
  return result
}

function writeCookie(
  key : string,
  value : string,
  expiredAt : number,
  domain : string
) {
  const runtimeDocument = getRuntimeDocument()
  if (runtimeDocument == null) {
    return
  }
  let cookieText = `${key}=${encodeCookieValue(value)}; expires=${new Date(expiredAt).toUTCString()}; path=/`
  if (domain.length > 0) {
    cookieText += `; domain=${domain}`
  }
  runtimeDocument.cookie = cookieText
}

function removeCookie(key : string, domain : string) {
  writeCookie(key, '', 1, domain)
}

function testCookie(domain : string) : boolean {
  const runtimeLocation = getRuntimeLocation()
  if (runtimeLocation == null) {
    return false
  }
  const hostname = runtimeLocation.hostname != null
    ? `${runtimeLocation.hostname}`
    : ''
  const protocol = runtimeLocation.protocol != null
    ? `${runtimeLocation.protocol}`
    : ''
  if (
    hostname.length == 0 ||
    hostname == 'localhost' ||
    hostname == '127.0.0.1' ||
    (protocol != 'http:' && protocol != 'https:')
  ) {
    return false
  }
  const testKey = 'gioCookie'
  writeCookie(testKey, 'yes', Date.now() + 60 * 1000, domain)
  const cookieMap = readCookieMap()
  const valid = cookieMap[testKey] != null && `${cookieMap[testKey]}` == 'yes'
  removeCookie(testKey, domain)
  return valid
}

function resolveCookieDomain(requestedDomain : string) : string {
  if (requestedDomain.length > 0 && testCookie(requestedDomain)) {
    return requestedDomain
  }
  const runtimeLocation = getRuntimeLocation()
  if (runtimeLocation == null || runtimeLocation.hostname == null) {
    return ''
  }
  const hostname = `${runtimeLocation.hostname}`
  const candidates = domainParse(hostname)
  candidates.push(hostname)
  for (let i = 0; i < candidates.length; i++) {
    if (testCookie(candidates[i])) {
      return candidates[i]
    }
  }
  return ''
}

function canUseLocalStorage() : boolean {
  try {
    const storage = getRuntimeLocalStorage()
    if (storage == null) {
      return false
    }
    storage.setItem('__gio_storage_test__', '__gio_storage_test__')
    storage.removeItem('__gio_storage_test__')
    return true
  } catch (_error) {
    return false
  }
}

function readLocalItem(key : string) : string | null {
  const storage = getRuntimeLocalStorage()
  if (storage == null) {
    return null
  }
  const value = storage.getItem(key)
  return value != null ? `${value}` : null
}

function writeLocalItem(key : string, value : string) {
  const storage = getRuntimeLocalStorage()
  if (storage == null) {
    return
  }
  storage.setItem(key, value)
}

function removeLocalItem(key : string) {
  const storage = getRuntimeLocalStorage()
  if (storage == null) {
    return
  }
  storage.removeItem(key)
}

function getLocalKeys() : Array<string> {
  const storage = getRuntimeLocalStorage()
  if (storage == null) {
    return [] as Array<string>
  }
  const keys = [] as Array<string>
  const length = Number(storage.length != null ? storage.length : 0)
  for (let i = 0; i < length; i++) {
    const key = storage.key(i)
    if (key != null) {
      keys.push(`${key}`)
    }
  }
  return keys
}

function getCookieKeys() : Array<string> {
  return Object.keys(readCookieMap())
}

registerWebStorageProvider({
  resolveCookieDomain: resolveCookieDomain,
  canUseLocalStorage: canUseLocalStorage,
  readCookieItem: (key : string, _domain : string) => {
    const cookieMap = readCookieMap()
    return cookieMap[key] != null ? `${cookieMap[key]}` : null
  },
  writeCookieItem: writeCookie,
  removeCookieItem: removeCookie,
  getCookieKeys: getCookieKeys,
  readLocalItem: readLocalItem,
  writeLocalItem: writeLocalItem,
  removeLocalItem: removeLocalItem,
  getLocalKeys: getLocalKeys
})
