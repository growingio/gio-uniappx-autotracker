import { GioInitOptions } from '../interface.uts'
import { platformName } from './utils.uts'

export const SDK_VERSION = '0.1.0'
export const DEFAULT_REQUEST_TIMEOUT_MS = 15 * 1000
export const DEFAULT_MAX_QUEUE_SIZE = 100
export const DEFAULT_APP_VERSION = '1.0.0'
export const DEFAULT_WEB_SESSION_EXPIRES_MINUTES = 30
export const DEFAULT_MP_SESSION_EXPIRES_MINUTES = 5
export const DEFAULT_APP_SESSION_EXPIRES_MINUTES = 0.5

function readRequiredString(raw : UTSJSONObject, key : string) : string {
  const value = raw[key]
  if (value == null) {
    return ''
  }
  return `${value}`
}

function readNullableString(raw : UTSJSONObject, key : string) : string | null {
  const value = raw[key]
  if (value == null) {
    return null
  }
  return `${value}`
}

function readNullableBoolean(raw : UTSJSONObject, key : string) : boolean | null {
  const value = raw[key]
  if (value == null) {
    return null
  }
  if (typeof value === 'boolean') {
    return value
  }
  return null
}

function readNullableNumber(raw : UTSJSONObject, key : string) : number | null {
  const value = raw[key]
  if (value == null) {
    return null
  }
  if (typeof value === 'number') {
    return value
  }
  return null
}

function getDefaultSessionExpires() : number {
  const platform = platformName()
  if (platform == 'web') {
    return DEFAULT_WEB_SESSION_EXPIRES_MINUTES
  }
  if (platform.startsWith('mp-')) {
    return DEFAULT_MP_SESSION_EXPIRES_MINUTES
  }
  return DEFAULT_APP_SESSION_EXPIRES_MINUTES
}

export const normalizeInitOptions = function (raw : UTSJSONObject) : GioInitOptions {
  return {
    projectId: readRequiredString(raw, 'projectId'),
    dataSourceId: readRequiredString(raw, 'dataSourceId'),
    appId: readRequiredString(raw, 'appId'),
    serverUrl: readRequiredString(raw, 'serverUrl'),
    appVersion: readNullableString(raw, 'appVersion'),
    cookieDomain: readNullableString(raw, 'cookieDomain'),
    debug: readNullableBoolean(raw, 'debug'),
    forceLogin: readNullableBoolean(raw, 'forceLogin'),
    originalSource: readNullableBoolean(raw, 'originalSource'),
    storageType: readNullableString(raw, 'storageType'),
    sessionExpires: readNullableNumber(raw, 'sessionExpires')
  } as GioInitOptions
}

class GioConfigData {
  static instance : GioConfigData | null = null

  static getInstance() : GioConfigData {
    if (GioConfigData.instance == null) {
      GioConfigData.instance = new GioConfigData()
    }
    return GioConfigData.instance as GioConfigData
  }

  private options : GioInitOptions | null = null

  private constructor() {}

  setOptions(options : GioInitOptions) {
    if (options.debug == null) {
      options.debug = false
    }
    if (options.forceLogin == null) {
      options.forceLogin = false
    }
    if (options.originalSource == null) {
      options.originalSource = true
    }
    if (options.cookieDomain == null) {
      options.cookieDomain = ''
    }
    if (options.storageType == null || options.storageType.length == 0) {
      options.storageType = platformName() == 'web' ? 'cookie' : 'localstorage'
    } else {
      options.storageType = options.storageType.toLowerCase()
    }
    if (options.sessionExpires == null) {
      options.sessionExpires = getDefaultSessionExpires()
    }
    if (options.appVersion == null || options.appVersion.length == 0) {
      options.appVersion = DEFAULT_APP_VERSION
    }
    this.options = options
  }

  getOptions() : GioInitOptions | null {
    return this.options
  }
}

export const GioConfig = GioConfigData.getInstance()
