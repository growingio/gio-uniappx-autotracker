import { GioInitOptions } from '../interface.uts'

export const SDK_VERSION = '0.1.0'
export const DEFAULT_SESSION_TIMEOUT_MS = 30 * 60 * 1000
export const DEFAULT_REQUEST_TIMEOUT_MS = 15 * 1000
export const DEFAULT_MAX_QUEUE_SIZE = 100
export const DEFAULT_STORAGE_PREFIX = 'gio:uniappx'
export const DEFAULT_APP_VERSION = '1.0.0'

function readRequiredString(raw : UTSJSONObject, key : string) : string {
  const value = raw[key]
  if (value == null) {
    return ''
  }
  return `${value}`
}

function readNullableString(raw : UTSJSONObject, key : string) : string | null {
  const value = raw[key]
  if (value == null) {
    return null
  }
  return `${value}`
}

function readNullableBoolean(raw : UTSJSONObject, key : string) : boolean | null {
  const value = raw[key]
  if (value == null) {
    return null
  }
  if (typeof value === 'boolean') {
    return value
  }
  return null
}

function readNullableNumber(raw : UTSJSONObject, key : string) : number | null {
  const value = raw[key]
  if (value == null) {
    return null
  }
  if (typeof value === 'number') {
    return value
  }
  return null
}

export const normalizeInitOptions = function (raw : UTSJSONObject) : GioInitOptions {
  const headerValue = raw['header']
  let header : UTSJSONObject | null = null
  if (headerValue != null) {
    header = headerValue as UTSJSONObject
  }
  return {
    projectId: readRequiredString(raw, 'projectId'),
    dataSourceId: readRequiredString(raw, 'dataSourceId'),
    appId: readRequiredString(raw, 'appId'),
    serverUrl: readRequiredString(raw, 'serverUrl'),
    appVersion: readNullableString(raw, 'appVersion'),
    debug: readNullableBoolean(raw, 'debug'),
    forceLogin: readNullableBoolean(raw, 'forceLogin'),
    autoTrackLifecycle: readNullableBoolean(raw, 'autoTrackLifecycle'),
    sessionTimeoutMs: readNullableNumber(raw, 'sessionTimeoutMs'),
    requestTimeoutMs: readNullableNumber(raw, 'requestTimeoutMs'),
    maxQueueSize: readNullableNumber(raw, 'maxQueueSize'),
    storagePrefix: readNullableString(raw, 'storagePrefix'),
    header: header
  } as GioInitOptions
}

class GioConfigData {
  static instance : GioConfigData | null = null

  static getInstance() : GioConfigData {
    if (GioConfigData.instance == null) {
      GioConfigData.instance = new GioConfigData()
    }
    return GioConfigData.instance as GioConfigData
  }

  private options : GioInitOptions | null = null

  private constructor() {}

  setOptions(options : GioInitOptions) {
    if (options.debug == null) {
      options.debug = false
    }
    if (options.forceLogin == null) {
      options.forceLogin = false
    }
    if (options.autoTrackLifecycle == null) {
      options.autoTrackLifecycle = true
    }
    if (options.sessionTimeoutMs == null) {
      options.sessionTimeoutMs = DEFAULT_SESSION_TIMEOUT_MS
    }
    if (options.requestTimeoutMs == null) {
      options.requestTimeoutMs = DEFAULT_REQUEST_TIMEOUT_MS
    }
    if (options.maxQueueSize == null) {
      options.maxQueueSize = DEFAULT_MAX_QUEUE_SIZE
    }
    const storagePrefix = options.storagePrefix
    if (storagePrefix == null || storagePrefix.length == 0) {
      options.storagePrefix = DEFAULT_STORAGE_PREFIX
    }
    if (options.header == null) {
      options.header = {} as UTSJSONObject
    }
    if (options.appVersion == null || options.appVersion.length == 0) {
      options.appVersion = DEFAULT_APP_VERSION
    }
    this.options = options
  }

  getOptions() : GioInitOptions | null {
    return this.options
  }
}

export const GioConfig = GioConfigData.getInstance()
