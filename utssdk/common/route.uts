export type GioResolvedRoute = {
  path : string
  query : string
  title : string
  signature : string
}

function stringifyRouteQuery(value : any | null) : string {
  if (value == null) {
    return ''
  }
  if (typeof value === 'string') {
    if (value.length == 0) {
      return ''
    }
    return normalizeQueryString(value)
  }
  const raw = value as UTSJSONObject
  if (Object.keys(raw).length == 0) {
    return ''
  }
  const keys = Object.keys(raw)
  const parts = [] as Array<string>
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    if (key.length == 0) {
      continue
    }
    const item = raw[key]
    const itemValue = item != null ? `${item}` : ''
    parts.push(`${key}=${itemValue}`)
  }
  return parts.join('&')
}

function normalizeRoutePath(raw : string | null) : string {
  if (raw == null || raw.length == 0) {
    return ''
  }
  let value = raw
  const hashIndex = value.indexOf('#')
  if (hashIndex >= 0) {
    value = value.slice(hashIndex + 1)
  }
  while (value.startsWith('/')) {
    value = value.slice(1)
  }
  const queryIndex = value.indexOf('?')
  if (queryIndex >= 0) {
    value = value.slice(0, queryIndex)
  }
  while (value.startsWith('/')) {
    value = value.slice(1)
  }
  return value
}

function normalizeQueryString(queryText : string) : string {
  if (queryText.length == 0) {
    return ''
  }
  let normalizedQuery = queryText
  if (normalizedQuery.startsWith('?') || normalizedQuery.startsWith('&')) {
    normalizedQuery = normalizedQuery.slice(1)
  }
  const hashIndex = normalizedQuery.indexOf('#')
  if (hashIndex >= 0) {
    normalizedQuery = normalizedQuery.slice(0, hashIndex)
  }
  if (normalizedQuery.length == 0) {
    return ''
  }
  const segments = normalizedQuery.split('&')
  const parts = [] as Array<string>
  for (let i = 0; i < segments.length; i++) {
    const segment = segments[i]
    if (segment.length == 0) {
      continue
    }
    let key = segment
    let value = ''
    const equalIndex = segment.indexOf('=')
    if (equalIndex >= 0) {
      key = segment.slice(0, equalIndex)
      value = segment.slice(equalIndex + 1)
    }
    if (key.length == 0) {
      continue
    }
    parts.push(`${key}=${value}`)
  }
  if (parts.length == 0) {
    return ''
  }
  return parts.join('&')
}

function getPageUrl(page : any | null) : string {
  if (page == null) {
    return ''
  }
  if (page.url != null && `${page.url}`.length > 0) {
    return `${page.url}`
  }
  if (page.fullPath != null && `${page.fullPath}`.length > 0) {
    return `${page.fullPath}`
  }
  if (page.$page != null) {
    if (page.$page.fullPath != null && `${page.$page.fullPath}`.length > 0) {
      return `${page.$page.fullPath}`
    }
    if (page.$page.path != null && `${page.$page.path}`.length > 0) {
      return `${page.$page.path}`
    }
  }
  return ''
}

function getPagePath(page : any | null) : string {
  if (page == null) {
    return ''
  }
  if (page.route != null && `${page.route}`.length > 0) {
    return normalizeRoutePath(`${page.route}`)
  }
  if (page.__route__ != null && `${page.__route__}`.length > 0) {
    return normalizeRoutePath(`${page.__route__}`)
  }
  if (page.$page != null) {
    const route = page.$page.route
    if (route != null && `${route}`.length > 0) {
      return normalizeRoutePath(`${route}`)
    }
    const fullPath = page.$page.fullPath
    if (fullPath != null && `${fullPath}`.length > 0) {
      return normalizeRoutePath(`${fullPath}`)
    }
    const path = page.$page.path
    if (path != null && `${path}`.length > 0) {
      return normalizeRoutePath(`${path}`)
    }
  }
  const pageUrl = getPageUrl(page)
  if (pageUrl.length > 0) {
    return normalizeRoutePath(pageUrl)
  }
  return ''
}

function getPageQuery(page : any | null, options : any | null) : string {
  if (options != null) {
    return stringifyRouteQuery(options)
  }
  if (page == null) {
    return ''
  }
  if (page.options != null) {
    const query = stringifyRouteQuery(page.options)
    if (query.length > 0) {
      return query
    }
  }
  if (page.$page != null && page.$page.options != null) {
    const query = stringifyRouteQuery(page.$page.options)
    if (query.length > 0) {
      return query
    }
  }
  const pageUrl = getPageUrl(page)
  if (pageUrl.length == 0) {
    return ''
  }
  const queryIndex = pageUrl.indexOf('?')
  if (queryIndex < 0 || queryIndex >= pageUrl.length - 1) {
    return ''
  }
  return normalizeQueryString(pageUrl.slice(queryIndex + 1))
}

function getPageTitle(page : any | null) : string {
  if (page == null) {
    return ''
  }
  if (
    page.navigationBarTitleText != null &&
    `${page.navigationBarTitleText}`.length > 0
  ) {
    return `${page.navigationBarTitleText}`
  }
  if (page.title != null && `${page.title}`.length > 0) {
    return `${page.title}`
  }
  if (page.$page != null && page.$page.meta != null) {
    const title = page.$page.meta.navigationBarTitleText
    if (title != null && `${title}`.length > 0) {
      return `${title}`
    }
  }
  return ''
}

export function buildRouteSignature(path : string, query : string) : string {
  if (path.length == 0) {
    return ''
  }
  if (query.length == 0) {
    return path
  }
  return `${path}?${query}`
}

export function resolvePageRoute(
  page : any | null,
  options : any | null
) : GioResolvedRoute {
  const path = getPagePath(page)
  const query = getPageQuery(page, options)
  const title = getPageTitle(page)
  return {
    path: path,
    query: query,
    title: title,
    signature: buildRouteSignature(path, query)
  } as GioResolvedRoute
}

export function isPageRouteTarget(target : any | null) : boolean {
  return getPagePath(target).length > 0
}
