export type GioResolvedRoute = {
  path : string
  query : string
  title : string
  signature : string
}

function stringifyRouteQuery(value : any | null) : string {
  if (value == null) {
    return ''
  }
  if (typeof value == 'string') {
    if (value.length == 0) {
      return ''
    }
    return normalizeQueryString(value)
  }
  const raw = value as UTSJSONObject
  if (UTSJSONObject.keys(raw).length == 0) {
    return ''
  }
  const keys = UTSJSONObject.keys(raw)
  const parts = [] as Array<string>
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    if (key.length == 0) {
      continue
    }
    const item = raw[key]
    const itemValue = item != null ? `${item}` : ''
    parts.push(`${key}=${itemValue}`)
  }
  return parts.join('&')
}

function normalizeRoutePath(raw : string | null) : string {
  if (raw == null || raw.length == 0) {
    return ''
  }
  // raw is non-null here, but UTS keeps the `string | null` type on the new
  // binding; assert to a non-null string so String methods resolve.
  let value : string = raw as string
  const hashIndex = value.indexOf('#')
  if (hashIndex >= 0) {
    value = value.slice(hashIndex + 1)
  }
  while (value.startsWith('/')) {
    value = value.slice(1)
  }
  const queryIndex = value.indexOf('?')
  if (queryIndex >= 0) {
    value = value.slice(0, queryIndex)
  }
  while (value.startsWith('/')) {
    value = value.slice(1)
  }
  return value
}

function normalizeQueryString(queryText : string) : string {
  if (queryText.length == 0) {
    return ''
  }
  let normalizedQuery = queryText
  if (normalizedQuery.startsWith('?') || normalizedQuery.startsWith('&')) {
    normalizedQuery = normalizedQuery.slice(1)
  }
  const hashIndex = normalizedQuery.indexOf('#')
  if (hashIndex >= 0) {
    normalizedQuery = normalizedQuery.slice(0, hashIndex)
  }
  if (normalizedQuery.length == 0) {
    return ''
  }
  const segments = normalizedQuery.split('&')
  const parts = [] as Array<string>
  for (let i = 0; i < segments.length; i++) {
    const segment = segments[i]
    if (segment.length == 0) {
      continue
    }
    let key = segment
    let value = ''
    const equalIndex = segment.indexOf('=')
    if (equalIndex >= 0) {
      key = segment.slice(0, equalIndex)
      value = segment.slice(equalIndex + 1)
    }
    if (key.length == 0) {
      continue
    }
    parts.push(`${key}=${value}`)
  }
  if (parts.length == 0) {
    return ''
  }
  return parts.join('&')
}

// UTS forbids dot-access of arbitrary members on an `any` value; read fields
// through direct index access with fallback protection.
function readAnyField(source : any | null, key : string) : any | null {
	if (source == null) {
		return null
	}
	try {
		const record = source as UTSJSONObject
		const value = (record as any)[key]
		return value != null ? value : null
	} catch (_error) {
		return null
	}
}

function getPageUrl(page : any | null) : string {
  const url = readAnyField(page, 'url')
  if (url != null && `${url}`.length > 0) {
    return `${url}`
  }
  const fullPath = readAnyField(page, 'fullPath')
  if (fullPath != null && `${fullPath}`.length > 0) {
    return `${fullPath}`
  }
  const sub = readAnyField(page, '$page')
  const subFullPath = readAnyField(sub, 'fullPath')
  if (subFullPath != null && `${subFullPath}`.length > 0) {
    return `${subFullPath}`
  }
  const subPath = readAnyField(sub, 'path')
  if (subPath != null && `${subPath}`.length > 0) {
    return `${subPath}`
  }
  return ''
}

export function getPagePath(page : any | null) : string {
  const route = readAnyField(page, 'route')
  if (route != null && `${route}`.length > 0) {
    return normalizeRoutePath(`${route}`)
  }
  const legacyRoute = readAnyField(page, '__route__')
  if (legacyRoute != null && `${legacyRoute}`.length > 0) {
    return normalizeRoutePath(`${legacyRoute}`)
  }
  const sub = readAnyField(page, '$page')
  const subRoute = readAnyField(sub, 'route')
  if (subRoute != null && `${subRoute}`.length > 0) {
    return normalizeRoutePath(`${subRoute}`)
  }
  const subFullPath = readAnyField(sub, 'fullPath')
  if (subFullPath != null && `${subFullPath}`.length > 0) {
    return normalizeRoutePath(`${subFullPath}`)
  }
  const subPath = readAnyField(sub, 'path')
  if (subPath != null && `${subPath}`.length > 0) {
    return normalizeRoutePath(`${subPath}`)
  }
  const pageUrl = getPageUrl(page)
  if (pageUrl.length > 0) {
    return normalizeRoutePath(pageUrl)
  }
  return ''
}

function getPageQuery(
  page : any | null,
  options : any | null,
  cachedQueryOptions : string | null,
  queryFromLastEvent : string | null
) : string {
  if (options != null) {
    return stringifyRouteQuery(options)
  }
  const pageOptions = readAnyField(page, 'options')
  if (pageOptions != null) {
    const query = stringifyRouteQuery(pageOptions)
    if (query.length > 0) {
      return query
    }
  }
  const subOptions = readAnyField(readAnyField(page, '$page'), 'options')
  if (subOptions != null) {
    const query = stringifyRouteQuery(subOptions)
    if (query.length > 0) {
      return query
    }
  }
  if (cachedQueryOptions != null) {
    return cachedQueryOptions
  }
  const pageUrl = getPageUrl(page)
  if (pageUrl.length == 0) {
    if (queryFromLastEvent != null && queryFromLastEvent.length > 0) {
      return queryFromLastEvent
    }
    return ''
  }
  const queryIndex = pageUrl.indexOf('?')
  if (queryIndex < 0 || queryIndex >= pageUrl.length - 1) {
    if (queryFromLastEvent != null && queryFromLastEvent.length > 0) {
      return queryFromLastEvent
    }
    return ''
  }
  return normalizeQueryString(pageUrl.slice(queryIndex + 1))
}

function getPageTitle(page : any | null) : string {
  const navTitle = readAnyField(page, 'navigationBarTitleText')
  if (navTitle != null && `${navTitle}`.length > 0) {
    return `${navTitle}`
  }
  const title = readAnyField(page, 'title')
  if (title != null && `${title}`.length > 0) {
    return `${title}`
  }
  const meta = readAnyField(readAnyField(page, '$page'), 'meta')
  const metaTitle = readAnyField(meta, 'navigationBarTitleText')
  if (metaTitle != null && `${metaTitle}`.length > 0) {
    return `${metaTitle}`
  }
  return ''
}

export function buildRouteSignature(path : string, query : string) : string {
  if (path.length == 0) {
    return ''
  }
  if (query.length == 0) {
    return path
  }
  return `${path}?${query}`
}

export function resolvePageRoute(
  page : any | null,
  options : any | null,
  cachedQueryOptions : string | null = null,
  queryFromLastEvent : string | null = null
) : GioResolvedRoute {
  const path = getPagePath(page)
  const query = getPageQuery(page, options, cachedQueryOptions, queryFromLastEvent)
  const title = getPageTitle(page)
  return {
    path: path,
    query: query,
    title: title,
    signature: buildRouteSignature(path, query)
  } as GioResolvedRoute
}

export function isPageRouteTarget(target : any | null) : boolean {
  return getPagePath(target).length > 0
}
