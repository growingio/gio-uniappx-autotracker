import { GioInitOptions, GioABTestCallback, GioABTestResult } from '../interface.uts'

export function now () : number {
  return Date.now()
}

// Native `Date` has no getTimezoneOffset(); only web/mp (JS) do. Return 0 on
// the app platform rather than emit an unresolved member that derails the
// Swift type-checker.
export function readTimezoneOffsetMinutes () : number {
  // #ifdef APP
  return 0
  // #endif
  // #ifndef APP
  return new Date().getTimezoneOffset()
  // #endif
}

export function guid () : string {
  const template = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'
  let result = ''
  for (let i = 0; i < template.length; i++) {
    const char = template.charAt(i)
    if (char == 'x' || char == 'y') {
      const random = Math.floor(Math.random() * 16)
      const value = char == 'x' ? random : ((random & 0x3) | 0x8)
      result += value.toString(16)
      continue
    }
    result += char
  }
  return result
}

// UTS-iOS types JSON.stringify as `string | null`; most call sites want a
// non-null string. Centralize the coercion.
export function jsonStringify (value : any) : string {
  const text = JSON.stringify(value)
  return text != null ? (text as string) : ''
}

export function hashCode(value : string, abs : boolean = false) : number {
  let hash = 0
  if (value.length == 0) {
    return hash
  }
  let index = 0
  while (index < value.length) {
    // charCodeAt is typed `number` for the editor but the native (Kotlin)
    // backend returns `Number?`, so coalesce to keep the arithmetic non-null.
    const charCode = value.charCodeAt(index)
    hash = (hash << 5) - hash + (charCode != null ? charCode : 0)
    hash = hash & hash
    index++
  }
  return abs ? Math.abs(hash) : hash
}

export function normalizeServerUrl (serverUrl : string) : string {
  if (serverUrl.endsWith('/')) {
    return serverUrl.slice(0, serverUrl.length - 1)
  }
  return serverUrl
}

export function buildCollectUrl (options : GioInitOptions) : string {
  return `${normalizeServerUrl(options.serverUrl)}/v3/projects/${options.projectId}/collect`
}

export type GioSystemContext = {
  deviceBrand : string
  deviceModel : string
  deviceType : string
  language : string
  networkState : string
  operatingSystem : string
  platform : string
  platformVersion : string
  screenHeight : number
  screenWidth : number
}

export function isBlank (value : string | null) : boolean {
  return value == null || value.length == 0
}

const EVENT_NAME_REG = /^[a-zA-Z_][0-9a-zA-Z_]{0,100}$/

export function isValidEventName (eventName : string | null) : boolean {
  if (isBlank(eventName)) {
    return false
  }
  return (eventName as string).match(EVENT_NAME_REG) != null
}

function readSystemText(source : any | null, keys : Array<string>) : string {
  if (source == null) {
    return ''
  }
  const raw = source as UTSJSONObject
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    const value = raw[key]
    if (value != null && `${value}`.length > 0) {
      return `${value}`
    }
  }
  return ''
}

export function getSystemInfoSnapshot() : UTSJSONObject | null {
  // UTS (Kotlin/Swift) cannot index `uni` dynamically by string name, so call
  // the typed sync APIs directly and assemble the snapshot the consumers read.
  try {
    const snapshot = {} as UTSJSONObject

    const device = uni.getDeviceInfo()
    snapshot['deviceBrand'] = device.deviceBrand
    snapshot['brand'] = device.brand
    snapshot['deviceModel'] = device.deviceModel
    snapshot['model'] = device.model
    snapshot['osName'] = device.osName
    snapshot['osVersion'] = device.osVersion
    snapshot['platform'] = device.platform

    const appBase = uni.getAppBaseInfo()
    snapshot['uniPlatform'] = appBase.uniPlatform
    snapshot['version'] = appBase.version
    snapshot['appLanguage'] = appBase.appLanguage
    snapshot['language'] = appBase.language

    const windowInfo = uni.getWindowInfo()
    snapshot['screenWidth'] = windowInfo.screenWidth
    snapshot['screenHeight'] = windowInfo.screenHeight

    return snapshot
  } catch (_error) {
    return null
  }
}

export function isValidIdentifyId (value : any | null) : boolean {
  if (value == null) {
    return false
  }
  // Validate purely via the string form — no typeof-number branch / numeric
  // comparison, which transpiles to NSNumber casts/compares Swift rejects.
  const text = `${value}`
  return text.length > 0 && text != '0' && text != '-' && text != 'null' && text != 'undefined'
}

export function normalizeTrackProperties (properties : UTSJSONObject | null) : UTSJSONObject | null {
  if (properties == null) {
    return null
  }

  const normalized = {} as UTSJSONObject
  const raw = properties as UTSJSONObject
  const keys = UTSJSONObject.keys(raw)

  for (let i = 0; i < keys.length; i++) {
    const rawKey = keys[i]
    if (rawKey == '&&sendTo') {
      continue
    }

    const value = raw[rawKey]
    if (value == null) {
      continue
    }

    const key = `${rawKey}`.slice(0, 100)

    if (Array.isArray(value)) {
      const arrayValue = value as Array<any>
      const parts = [] as Array<string>
      const maxLength = arrayValue.length > 100 ? 100 : arrayValue.length
      for (let j = 0; j < maxLength; j++) {
        const item = arrayValue[j]
        if (item == null) {
          continue
        }
        parts.push(`${item}`)
      }
      normalized[key] = parts.join('||').slice(0, 1000)
      continue
    }

    if (typeof value == 'object' || typeof value == 'function') {
      continue
    }

    normalized[key] = `${value}`.slice(0, 1000)
  }

  return UTSJSONObject.keys(normalized).length > 0 ? normalized : null
}

export function platformName () : string {
  const system = getSystemInfoSnapshot()
  const platform = readSystemText(system, ['uniPlatform', 'platform'])
  if (platform.length > 0) {
    return platform
  }
  return 'unknown'
}

export function getSystemContext () : GioSystemContext {
  const system = getSystemInfoSnapshot()
  const platformText = readSystemText(system, ['uniPlatform', 'platform'])
  const platform = platformText.length > 0 ? platformText : 'unknown'

  let operatingSystem = platform
  const lowerPlatform = platform.toLowerCase()
  if (lowerPlatform.indexOf('android') >= 0) {
    operatingSystem = 'uni-app-x-Android'
  } else if (lowerPlatform.indexOf('ios') >= 0) {
    operatingSystem = 'uni-app-x-iOS'
  } else if (
    lowerPlatform.indexOf('harmony') >= 0 ||
    lowerPlatform.indexOf('ohos') >= 0
  ) {
    operatingSystem = 'uni-app-x-HarmonyOS'
  } else {
    const osName = readSystemText(system, ['osName'])
    const lowerOsName = osName.toLowerCase()
    if (lowerOsName.indexOf('android') >= 0) {
      operatingSystem = 'uni-app-x-Android'
    } else if (lowerOsName.indexOf('ios') >= 0) {
      operatingSystem = 'uni-app-x-iOS'
    } else if (
      lowerOsName.indexOf('harmony') >= 0 ||
      lowerOsName.indexOf('ohos') >= 0
    ) {
      operatingSystem = 'uni-app-x-HarmonyOS'
    }
  }

  let platformVersion = operatingSystem
  const osVersion = readSystemText(system, ['osVersion', 'version'])
  if (osVersion.length > 0) {
    platformVersion = `${operatingSystem} ${osVersion}`
  }

  return {
    deviceBrand: readSystemText(system, ['deviceBrand', 'brand']),
    deviceModel: readSystemText(system, ['deviceModel', 'model']),
    deviceType: operatingSystem,
    language: readSystemText(system, ['language', 'appLanguage']),
    networkState: readSystemText(system, ['networkType']),
    operatingSystem: operatingSystem,
    platform: platform,
    platformVersion: platformVersion,
    screenHeight: system != null ? (system as UTSJSONObject).getNumber('screenHeight', 0) : 0,
    screenWidth: system != null ? (system as UTSJSONObject).getNumber('screenWidth', 0) : 0
  } as GioSystemContext
}

export function consoleText(
  message : any,
  type : string | null = null
) {
  const styles = {
    info: 'color: #3B82F6;',
    error: 'color: #EF4444;',
    warn: 'color: #F59E0B;',
    success: 'color: #10B981;'
  } as UTSJSONObject
  let style = ''
  if (type != null && styles[type] != null) {
    style = `${styles[type]}`
  }
  console.log(`%c [GrowingIO]：${message}`, style)
}

function stringifyDebugData(data : any) : string {
  try {
    // UTS-iOS JSON.stringify only takes the value arg (no replacer/space).
    return jsonStringify(data)
  } catch (_error) {
    return `${data}`
  }
}

function escapeDebugString(text : string) : string {
  return text
    .replaceAll('\\', '\\\\')
    .replaceAll('"', '\\"')
    .replaceAll('\n', '\\n')
    .replaceAll('\r', '\\r')
    .replaceAll('\t', '\\t')
}

function prettyPrintDebugJson(value : any | null, indentLevel : number = 0) : string {
  if (value == null) {
    return 'null'
  }
  if (typeof value == 'string') {
    return `"${escapeDebugString(value)}"`
  }
  if (typeof value == 'number' || typeof value == 'boolean') {
    return `${value}`
  }
  const indentUnit = '  '
  const currentIndent = indentUnit.repeat(indentLevel)
  const nextIndent = indentUnit.repeat(indentLevel + 1)
  if (Array.isArray(value)) {
    if (value.length == 0) {
      return '[]'
    }
    const lines = [] as Array<string>
    for (let i = 0; i < value.length; i++) {
      lines.push(`${nextIndent}${prettyPrintDebugJson(value[i], indentLevel + 1)}`)
    }
    return `[\n${lines.join(',\n')}\n${currentIndent}]`
  }
  if (typeof value == 'object') {
    const raw = value as UTSJSONObject
    const keys = UTSJSONObject.keys(raw)
    if (keys.length == 0) {
      return '{}'
    }
    const lines = [] as Array<string>
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i]
      const rendered = prettyPrintDebugJson(raw[key], indentLevel + 1)
      lines.push(`${nextIndent}"${escapeDebugString(key)}": ${rendered}`)
    }
    return `{\n${lines.join(',\n')}\n${currentIndent}}`
  }
  return stringifyDebugData(value)
}

type GioCivilTime = {
  year : number
  month : number
  day : number
  hour : number
  minute : number
  second : number
  milli : number
}

// Calendar fields from an epoch-millisecond value via pure integer math —
// avoids JS `Date` instance methods (toISOString/getUTC*), which don't exist
// on the native (Swift/Kotlin) `Date`. Algorithm: Howard Hinnant's
// civil_from_days. Treats the input as the wall clock for whatever offset the
// caller already baked into `ms` (UTC for ISO, +8h for Beijing).
function epochMsToCivil(ms : number) : GioCivilTime {
  const milli = ((ms % 1000) + 1000) % 1000
  const totalSec = Math.floor(ms / 1000)
  const second = ((totalSec % 60) + 60) % 60
  const totalMin = Math.floor(totalSec / 60)
  const minute = ((totalMin % 60) + 60) % 60
  const totalHour = Math.floor(totalMin / 60)
  const hour = ((totalHour % 24) + 24) % 24
  const days = Math.floor(totalHour / 24)

  const z = days + 719468
  const era = Math.floor((z >= 0 ? z : z - 146096) / 146097)
  const doe = z - era * 146097
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365)
  const y = yoe + era * 400
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100))
  const mp = Math.floor((5 * doy + 2) / 153)
  const day = doy - Math.floor((153 * mp + 2) / 5) + 1
  const month = mp < 10 ? mp + 3 : mp - 9
  const year = month <= 2 ? y + 1 : y

  return {
    year: year,
    month: month,
    day: day,
    hour: hour,
    minute: minute,
    second: second,
    milli: milli
  } as GioCivilTime
}

function padDatePart(value : number, size : number = 2) : string {
  let text = `${value}`
  while (text.length < size) {
    text = `0${text}`
  }
  return text
}

function formatDebugTimestamp() : string {
  const c = epochMsToCivil(now())
  const datePart = `${c.year}-${padDatePart(c.month)}-${padDatePart(c.day)}`
  const timePart = `${padDatePart(c.hour)}:${padDatePart(c.minute)}:${padDatePart(c.second)}.${padDatePart(c.milli, 3)}`
  return `${datePart}T${timePart}Z`
}

function buildDebugMessage(message : string) : string {
  return `[GrowingIO Debug][${formatDebugTimestamp()}] ${message}`
}

export function formatBeijingTimestamp(ts : number) : string {
  const beijingMs = ts + 480 * 60 * 1000
  const c = epochMsToCivil(beijingMs)
  const datePart = `${c.year}-${padDatePart(c.month)}-${padDatePart(c.day)}`
  const timePart = `${padDatePart(c.hour)}:${padDatePart(c.minute)}:${padDatePart(c.second)}.${padDatePart(c.milli, 3)}`
  return `${datePart} ${timePart} GMT+8`
}

export function debugLog(enabled : boolean, message : string, data : any | null = null) {
  if (!enabled) {
    return
  }
  if (data == null) {
    console.log(buildDebugMessage(message))
    return
  }
  console.log(buildDebugMessage(`${message}\n${prettyPrintDebugJson(data)}`))
}

export function niceCallback(callback : GioABTestCallback | null, value : GioABTestResult | UTSJSONObject) {
  if (callback == null) {
    return
  }
  try {
    callback(value)
  } catch (error) {
    consoleText(`回调执行失败！${error}`, 'error')
  }
}
