import {
  GioInitOptions,
  GioOriginalSource,
  GioPageContext,
  GioTrackEvent
} from '../../../interface.uts'
import { SDK_VERSION } from '../../config.uts'
import { GioSystemContext, now, readTimezoneOffsetMinutes } from '../../utils.uts'
import {
  resolvePageContext as resolveRuntimePageContext,
  shapeTrackEvent
} from '../../runtime/index.uts'
import { GioUserStore } from '../../userStore/index.uts'

export class GioEventBuilder {
  private userStore : GioUserStore | null = null

  configure(userStore : GioUserStore) {
    this.userStore = userStore
  }

  // Named distinctly from the imported runtime `resolvePageContext`: UTS-iOS
  // ignores the import alias and module-qualifies the call, which collides with
  // a same-named class method ("cannot find UTSSDKModules... in scope").
  private composePageContext(
    eventType : string,
    pageContext : GioPageContext | null,
    originalSource : GioOriginalSource | null
  ) : GioPageContext | null {
    let resolvedPageContext = resolveRuntimePageContext(pageContext)
    if (eventType == 'VISIT' && originalSource != null) {
      resolvedPageContext = {
        path: originalSource.path,
        query: originalSource.query,
        title: originalSource.title,
        referralPage: originalSource.referralPage,
        duration: pageContext != null ? pageContext.duration : null
      } as GioPageContext
    }
    return resolvedPageContext
  }

  buildEvent(
    options : GioInitOptions,
    systemContext : GioSystemContext,
    name : string,
    eventType : string,
    properties : UTSJSONObject | null,
    pageContext : GioPageContext | null,
    appChannel : string | null,
    originalSource : GioOriginalSource | null
  ) : GioTrackEvent {
    const userStore = this.userStore as GioUserStore
    const context = userStore.getContext()
    const resolvedPageContext = this.composePageContext(
      eventType,
      pageContext,
      originalSource
    )
    let path : string | null = null
    let query : string | null = null
    let title : string | null = null
    let referralPage : string | null = null
    if (resolvedPageContext != null) {
      path = resolvedPageContext.path
      query = resolvedPageContext.query
      title = resolvedPageContext.title
      referralPage = resolvedPageContext.referralPage
    }
    let eventName : string | null = null
    if (eventType == 'CUSTOM') {
      eventName = name
    }
    let eventSequenceId : number | null = null
    if (
      eventType != 'APP_CLOSED' &&
      eventType != 'LOGIN_USER_ATTRIBUTES'
    ) {
      eventSequenceId = userStore.getNextEventSequenceId()
    }
    // Extract only the expression-valued entries (cast / ternary / calls) into
    // locals; the plain member accesses auto-unwrap fine inline. The big
    // `{...} as GioTrackEvent` literal was "unable to type-check in reasonable
    // time" mostly because of the unresolved `new Date().getTimezoneOffset()`
    // (no native Date member) plus the inline cast/ternary. (Don't extract the
    // String! member accesses — an untyped local decays them to String? and
    // then fails assignment into the non-null event fields.)
    const appVersionText : string = options.appVersion as string
    const titleText : string = title != null ? (title as string) : ''
    const timestamp : number = now()
    const timezoneOffset : number = readTimezoneOffsetMinutes()
    return shapeTrackEvent({
      appChannel: appChannel,
      appVersion: appVersionText,
      dataSourceId: options.dataSourceId,
      deviceBrand: systemContext.deviceBrand,
      deviceId: context.deviceId,
      deviceModel: systemContext.deviceModel,
      deviceType: systemContext.deviceType,
      domain: options.appId,
      eventName: eventName,
      eventSequenceId: eventSequenceId,
      eventType: eventType,
      language: systemContext.language,
      latitude: null,
      longitude: null,
      networkState: systemContext.networkState,
      operatingSystem: systemContext.operatingSystem,
      path: path,
      platform: systemContext.platform,
      platformVersion: systemContext.platformVersion,
      protocolType: null,
      query: query,
      referralPage: referralPage,
      screenHeight: systemContext.screenHeight,
      screenWidth: systemContext.screenWidth,
      sdkVersion: SDK_VERSION,
      sessionId: context.sessionId,
      timestamp: timestamp,
      timezoneOffset: timezoneOffset,
      title: titleText,
      userId: context.userId,
      userKey: context.userKey,
      attributes: properties
    } as GioTrackEvent)
  }
}
