import { GioInitOptions, GioTrackEvent } from '../../interface.uts'
import { DEFAULT_REQUEST_TIMEOUT_MS } from '../config.uts'
import { buildCollectUrl, debugLog } from '../utils.uts'
import { dispatchViaEventSender } from '../runtime/index.uts'

export class GioUploader {
  private options : GioInitOptions | null = null
  private pending : Array<GioTrackEvent> = []
  private hoarding : Array<GioTrackEvent> = []
  private inflight : boolean = false
  private forceLogin : boolean = false
  private onFlushSuccess : ((events : Array<GioTrackEvent>) => void) | null = null

  configure(
    options : GioInitOptions,
    onFlushSuccess : ((events : Array<GioTrackEvent>) => void) | null = null
  ) {
    this.options = options
    this.forceLogin = options.forceLogin == true
    this.onFlushSuccess = onFlushSuccess
  }

  private sanitizeValue(value : any | null) : any | null {
    if (value == null) {
      return null
    }
    if (typeof value == 'string') {
      return value.length > 0 ? value : null
    }
    if (Array.isArray(value)) {
      const items = [] as Array<any>
      for (let i = 0; i < value.length; i++) {
        const sanitizedItem = this.sanitizeValue(value[i])
        if (sanitizedItem != null) {
          items.push(sanitizedItem)
        }
      }
      return items
    }
    if (typeof value == 'object') {
      const raw = value as UTSJSONObject
      const sanitized = {} as UTSJSONObject
      const keys = UTSJSONObject.keys(raw)
      for (let i = 0; i < keys.length; i++) {
        const key = keys[i]
        const sanitizedValue = this.sanitizeValue(raw[key])
        if (sanitizedValue != null) {
          sanitized[key] = sanitizedValue
        }
      }
      return UTSJSONObject.keys(sanitized).length > 0 ? sanitized : null
    }
    return value
  }

  enqueue(event : GioTrackEvent, maxQueueSize : number) {
    const queue = this.forceLogin ? this.hoarding : this.pending
    queue.push(event)
    if (queue.length > maxQueueSize) {
      queue.shift()
    }
  }

  getPendingCount() : number {
    // Array.length transpiles to Swift Int; the `: number` return is NSNumber,
    // so coerce explicitly (implicit Int→NSNumber return is rejected).
    return this.pending.length as number
  }

  getHoardingCount() : number {
    return this.hoarding.length as number
  }

  setForceLogin(forceLogin : boolean) {
    this.forceLogin = forceLogin
  }

  releaseHoarding(deviceId : string, maxQueueSize : number) {
    for (let i = 0; i < this.hoarding.length; i++) {
      const event = this.hoarding[i]
      event.deviceId = deviceId
      this.pending.push(event)
      if (this.pending.length > maxQueueSize) {
        this.pending.shift()
      }
    }
    this.hoarding = []
  }

  private sanitizeEvent(event : GioTrackEvent) : UTSJSONObject {
    const sanitized = {} as UTSJSONObject
    const raw = this.toEventJSONObject(event)
    const target = sanitized as UTSJSONObject
    const keys = UTSJSONObject.keys(raw)
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i]
      const sanitizedValue = this.sanitizeValue(raw[key])
      if (sanitizedValue == null) {
        continue
      }
      target[key] = sanitizedValue
    }
    return sanitized
  }

  private toEventJSONObject(event : GioTrackEvent) : UTSJSONObject {
    return {
      appChannel: event.appChannel,
      appVersion: event.appVersion,
      dataSourceId: event.dataSourceId,
      deviceBrand: event.deviceBrand,
      deviceId: event.deviceId,
      deviceModel: event.deviceModel,
      deviceType: event.deviceType,
      domain: event.domain,
      eventName: event.eventName,
      eventSequenceId: event.eventSequenceId,
      eventType: event.eventType,
      language: event.language,
      latitude: event.latitude,
      longitude: event.longitude,
      networkState: event.networkState,
      operatingSystem: event.operatingSystem,
      path: event.path,
      platform: event.platform,
      platformVersion: event.platformVersion,
      query: event.query,
      referralPage: event.referralPage,
      screenHeight: event.screenHeight,
      screenWidth: event.screenWidth,
      sdkVersion: event.sdkVersion,
      sessionId: event.sessionId,
      timestamp: event.timestamp,
      timezoneOffset: event.timezoneOffset,
      title: event.title,
      userId: event.userId,
      userKey: event.userKey,
      attributes: event.attributes
    } as UTSJSONObject
  }

  private buildRequestHeader() : UTSJSONObject {
    const header = {} as UTSJSONObject
    header['content-type'] = 'application/json;charset=UTF-8'
    return header
  }

  flush(success : (() => void) | null = null, fail : (() => void) | null = null) : boolean {
    if (this.options == null) {
      return false
    }
    if (this.inflight || this.pending.length == 0) {
      return false
    }

    const batch = this.pending.slice()
    const requestData = [] as Array<UTSJSONObject>
    for (let i = 0; i < batch.length; i++) {
      requestData.push(this.sanitizeEvent(batch[i]))
    }
    const options = this.options
    if (options == null) {
      this.inflight = false
      return false
    }
    const sendAt = Date.now()

    this.inflight = true
    debugLog(options.debug as boolean, 'request payload', requestData)

    const collectUrl = `${buildCollectUrl(options)}?stm=${sendAt}&compress=0`
    const dispatched = dispatchViaEventSender(
      collectUrl,
      requestData,
      () => {
        if (this.onFlushSuccess != null) {
          this.onFlushSuccess(batch)
        }
        this.pending.splice(0, batch.length)
        if (success != null) {
          success()
        }
        this.inflight = false
        if (this.pending.length > 0) {
          this.flush(null, null)
        }
      },
      () => {
        this.inflight = false
        if (fail != null) {
          fail()
        }
      }
    )
    if (dispatched) {
      return true
    }

    uni.request<string>({
      url: collectUrl,
      method: 'POST',
      dataType: 'text',
      timeout: DEFAULT_REQUEST_TIMEOUT_MS,
      header: this.buildRequestHeader(),
      data: requestData,
      success: (res : RequestSuccess<string>) => {
        const statusCode = parseFloat(`${res.statusCode}`)
        if (statusCode == 200 || statusCode == 204) {
          if (this.onFlushSuccess != null) {
            this.onFlushSuccess(batch)
          }
          this.pending.splice(0, batch.length)
          if (success != null) {
            success()
          }
          this.inflight = false
          if (this.pending.length > 0) {
            this.flush(null, null)
          }
          return
        } else {
          if (fail != null) {
            fail()
          }
        }
        this.inflight = false
      },
      fail(_ : RequestFail) {
        this.inflight = false
        if (fail != null) {
          fail()
        }
      }
    } as RequestOptions<string>)

    return true
  }
}
