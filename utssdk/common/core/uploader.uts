import { GioInitOptions, GioTrackEvent } from '../../interface.uts'
import { buildCollectUrl, debugLog } from '../utils.uts'

export class GioUploader {
  private options : GioInitOptions | null = null
  private pending : Array<GioTrackEvent> = []
  private hoarding : Array<GioTrackEvent> = []
  private inflight : boolean = false
  private forceLogin : boolean = false

  configure(options : GioInitOptions) {
    this.options = options
    this.forceLogin = options.forceLogin == true
  }

  enqueue(event : GioTrackEvent, maxQueueSize : number) {
    const queue = this.forceLogin ? this.hoarding : this.pending
    queue.push(event)
    if (queue.length > maxQueueSize) {
      queue.shift()
    }
  }

  getPendingCount() : number {
    return this.pending.length
  }

  getHoardingCount() : number {
    return this.hoarding.length
  }

  setForceLogin(forceLogin : boolean) {
    this.forceLogin = forceLogin
  }

  releaseHoarding(deviceId : string, maxQueueSize : number) {
    for (let i = 0; i < this.hoarding.length; i++) {
      const event = this.hoarding[i]
      event.deviceId = deviceId
      this.pending.push(event)
      if (this.pending.length > maxQueueSize) {
        this.pending.shift()
      }
    }
    this.hoarding = []
  }

  private sanitizeEvent(event : GioTrackEvent) : GioTrackEvent {
    const sanitized = {} as GioTrackEvent
    const raw = event as UTSJSONObject
    const target = sanitized as UTSJSONObject
    const keys = Object.keys(raw)
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i]
      const value = raw[key]
      if (value == null) {
        continue
      }
      if (typeof value === 'string' && value.length == 0) {
        continue
      }
      target[key] = value
    }
    return sanitized
  }

  private buildRequestHeader(options : GioInitOptions) : UTSJSONObject {
    const header = {} as UTSJSONObject
    header['content-type'] = 'application/json;charset=UTF-8'
    const customHeader = options.header
    if (customHeader == null) {
      return header
    }
    const customHeaderObject = customHeader as UTSJSONObject
    const keys = Object.keys(customHeaderObject)
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i]
      header[key] = customHeaderObject[key]
    }
    return header
  }

  flush(success : (() => void) | null = null, fail : (() => void) | null = null) : boolean {
    if (this.options == null) {
      return false
    }
    if (this.inflight || this.pending.length == 0) {
      return false
    }

    const batch = this.pending.slice()
    const requestData = [] as Array<GioTrackEvent>
    for (let i = 0; i < batch.length; i++) {
      requestData.push(this.sanitizeEvent(batch[i]))
    }
    const options = this.options as GioInitOptions
    const sendAt = Date.now()

    this.inflight = true
    debugLog(options.debug as boolean, 'flush events', requestData)

    uni.request({
      url: `${buildCollectUrl(options)}?stm=${sendAt}&compress=0`,
      method: 'POST',
      timeout: options.requestTimeoutMs as number,
      header: this.buildRequestHeader(options),
      data: requestData,
      success: (res) => {
        const statusCode = Number(res.statusCode)
        if (statusCode == 200 || statusCode == 204) {
          this.pending.splice(0, batch.length)
          if (success != null) {
            success()
          }
        } else {
          if (fail != null) {
            fail()
          }
        }
        this.inflight = false
      },
      fail: (_) => {
        this.inflight = false
        if (fail != null) {
          fail()
        }
      }
    })

    return true
  }
}
