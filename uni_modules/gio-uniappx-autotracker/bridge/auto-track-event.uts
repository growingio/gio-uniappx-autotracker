import { readDynamicField } from './utils.uts'

function readStringValue(value : any | null) : string | null {
  if (value == null || typeof value != 'string') {
    return null
  }
  return value as string
}

function readNumberValue(value : any | null) : number | null {
  if (value == null || typeof value != 'number') {
    return null
  }
  return value as number
}

function readBooleanValue(value : any | null) : boolean | null {
  if (value == null || typeof value != 'boolean') {
    return null
  }
  return value as boolean
}

function readStringField(source : any | null, key : string) : string | null {
  return readStringValue(readDynamicField(source, key))
}

function readNumberField(source : any | null, key : string) : number | null {
  return readNumberValue(readDynamicField(source, key))
}

function readBooleanField(source : any | null, key : string) : boolean | null {
  return readBooleanValue(readDynamicField(source, key))
}

function copyInjectedDetailValue(target : UTSJSONObject, source : UTSJSONObject | null) : boolean {
  if (source == null) {
    return false
  }
  const textValue = source.getString('value')
  if (textValue != null) {
    target['value'] = textValue
    return true
  }
  const numberValue = source.getNumber('value')
  if (numberValue != null) {
    target['value'] = numberValue
    return true
  }
  const booleanValue = source.getBoolean('value')
  if (booleanValue != null) {
    target['value'] = booleanValue
    return true
  }
  return false
}

function copyDatasetFlag(source : any | null, target : UTSJSONObject, key : string) {
  const booleanValue = readBooleanField(source, key)
  if (booleanValue != null) {
    target[key] = booleanValue
    return
  }
  const stringValue = readStringField(source, key)
  if (stringValue != null) {
    target[key] = stringValue
  }
}

function copyDataset(source : any | null) : UTSJSONObject | null {
  if (source == null || typeof source != 'object' || Array.isArray(source)) {
    return null
  }
  const copied = {} as UTSJSONObject
  const indexText = readStringField(source, 'index')
  if (indexText != null) {
    copied['index'] = indexText
  } else {
    const indexNumber = readNumberField(source, 'index')
    if (indexNumber != null) {
      copied['index'] = indexNumber
    }
  }
  const src = readStringField(source, 'src')
  if (src != null) {
    copied['src'] = src
  }
  const title = readStringField(source, 'title')
  if (title != null) {
    copied['title'] = title
  }
  copyDatasetFlag(source, copied, 'growingTrack')
  copyDatasetFlag(source, copied, 'growingIgnore')
  return UTSJSONObject.keys(copied).length > 0 ? copied : null
}

function copyScalarValue(source : any | null) : UTSJSONObject | null {
  if (source == null || typeof source != 'object' || Array.isArray(source)) {
    return null
  }
  const copied = {} as UTSJSONObject
  const typeText = readStringField(source, 'type')
  if (typeText != null) {
    copied['type'] = typeText
  }
  const valueText = readStringField(source, 'value')
  if (valueText != null) {
    copied['value'] = valueText
  } else {
    const valueNumber = readNumberField(source, 'value')
    if (valueNumber != null) {
      copied['value'] = valueNumber
    } else {
      const valueBoolean = readBooleanField(source, 'value')
      if (valueBoolean != null) {
        copied['value'] = valueBoolean
      }
    }
  }
  return UTSJSONObject.keys(copied).length > 0 ? copied : null
}

function copyEventTargetSnapshot(source : any | null) : UTSJSONObject | null {
  if (source == null || typeof source != 'object' || Array.isArray(source)) {
    return null
  }
  const copied = {} as UTSJSONObject
  const id = readStringField(source, 'id')
  if (id != null) {
    copied['id'] = id
  }
  const dataset = copyDataset(readDynamicField(source, 'dataset'))
  if (dataset != null) {
    copied['dataset'] = dataset
  }
  const typeText = readStringField(source, 'type')
  if (typeText != null) {
    copied['type'] = typeText
  }
  const runtimeAttr = copyScalarValue(readDynamicField(source, 'attr'))
  const attr = runtimeAttr != null ? runtimeAttr : copyScalarValue(source)
  if (attr != null) {
    copied['attr'] = attr
  }
  return UTSJSONObject.keys(copied).length > 0 ? copied : null
}

function writeStaticDatasetValue(target : UTSJSONObject, key : string, value : string | null) {
  if (value != null && value.length > 0) {
    target[key] = value
  }
}

function buildStaticTargetSnapshot(
  staticId : string | null,
  staticIndex : string | null,
  staticTitle : string | null,
  staticSrc : string | null,
  staticGrowingTrack : string | null,
  staticGrowingIgnore : string | null
) : UTSJSONObject | null {
  const copied = {} as UTSJSONObject
  if (staticId != null && staticId.length > 0) {
    copied['id'] = staticId
  }
  const dataset = {} as UTSJSONObject
  writeStaticDatasetValue(dataset, 'index', staticIndex)
  writeStaticDatasetValue(dataset, 'title', staticTitle)
  writeStaticDatasetValue(dataset, 'src', staticSrc)
  writeStaticDatasetValue(dataset, 'growingTrack', staticGrowingTrack)
  writeStaticDatasetValue(dataset, 'growingIgnore', staticGrowingIgnore)
  if (UTSJSONObject.keys(dataset).length > 0) {
    copied['dataset'] = dataset
  }
  return UTSJSONObject.keys(copied).length > 0 ? copied : null
}

function isDatasetFieldMissing(dataset : UTSJSONObject, key : string) : boolean {
  return dataset.getString(key) == null && dataset.getNumber(key) == null && dataset.getBoolean(key) == null
}

function mergeStaticDatasetValue(runtimeDataset : UTSJSONObject, staticDataset : UTSJSONObject, key : string) {
  const value = staticDataset.getString(key)
  if (value != null && isDatasetFieldMissing(runtimeDataset, key)) {
    runtimeDataset[key] = value
  }
}

function mergeStaticDataset(runtimeDataset : UTSJSONObject | null, staticDataset : UTSJSONObject | null) : UTSJSONObject | null {
  if (runtimeDataset == null) {
    return staticDataset
  }
  if (staticDataset == null) {
    return runtimeDataset
  }
  mergeStaticDatasetValue(runtimeDataset, staticDataset, 'index')
  mergeStaticDatasetValue(runtimeDataset, staticDataset, 'title')
  mergeStaticDatasetValue(runtimeDataset, staticDataset, 'src')
  mergeStaticDatasetValue(runtimeDataset, staticDataset, 'growingTrack')
  mergeStaticDatasetValue(runtimeDataset, staticDataset, 'growingIgnore')
  return runtimeDataset
}

function mergeStaticTargetSnapshot(runtimeTarget : UTSJSONObject | null, staticTarget : UTSJSONObject | null) : UTSJSONObject | null {
  if (runtimeTarget == null) {
    return staticTarget
  }
  if (staticTarget == null) {
    return runtimeTarget
  }
  const runtimeId = runtimeTarget.getString('id', '')
  const staticId = staticTarget.getString('id')
  if (runtimeId.length == 0 && staticId != null) {
    runtimeTarget['id'] = staticId
  }
  const dataset = mergeStaticDataset(runtimeTarget.getJSON('dataset'), staticTarget.getJSON('dataset'))
  if (dataset != null) {
    runtimeTarget['dataset'] = dataset
  }
  return runtimeTarget
}

function copyEventDetailSnapshot(source : any | null) : UTSJSONObject | null {
  if (source == null || typeof source != 'object' || Array.isArray(source)) {
    return null
  }
  const copied = {} as UTSJSONObject
  const sourceText = readStringField(source, 'source')
  if (sourceText != null) {
    copied['source'] = sourceText
  }
  const value = copyScalarValue(source)
  if (value != null) {
    const valueText = value.getString('value')
    if (valueText != null) {
      copied['value'] = valueText
    } else {
      const valueNumber = value.getNumber('value')
      if (valueNumber != null) {
        copied['value'] = valueNumber
      } else {
        const valueBoolean = value.getBoolean('value')
        if (valueBoolean != null) {
          copied['value'] = valueBoolean
        }
      }
    }
  }
  return UTSJSONObject.keys(copied).length > 0 ? copied : null
}

function copyTabItemTargetSnapshot(source : any | null) : UTSJSONObject | null {
  if (source == null || typeof source != 'object' || Array.isArray(source)) {
    return null
  }
  const dataset = {} as UTSJSONObject
  const indexNumber = readNumberField(source, 'index')
  if (indexNumber != null) {
    dataset['index'] = (indexNumber as number) + 1
  } else {
    const indexText = readStringField(source, 'index')
    if (indexText != null && indexText.length > 0) {
      const indexValue = parseInt(indexText, 10)
      if (!isNaN(indexValue)) {
        dataset['index'] = indexValue + 1
      }
    }
  }
  const text = readStringField(source, 'text')
  if (text != null) {
    dataset['title'] = text
  }
  const pagePath = readStringField(source, 'pagePath')
  if (pagePath != null) {
    dataset['src'] = pagePath
  } else {
    const path = readStringField(source, 'path')
    if (path != null) {
      dataset['src'] = path
    }
  }
  const copied = {} as UTSJSONObject
  copied['id'] = ''
  if (UTSJSONObject.keys(dataset).length > 0) {
    copied['dataset'] = dataset
  }
  return copied
}

export function buildAutoTrackEventSnapshot(
  action : string,
  event : any | null,
  eventName : string,
  elementType : string | null,
  staticId : string | null,
  staticIndex : string | null,
  staticTitle : string | null,
  staticSrc : string | null,
  staticGrowingTrack : string | null,
  staticGrowingIgnore : string | null,
  eventDetail : UTSJSONObject | null,
  preferOriginalTarget : boolean = false
) : UTSJSONObject | null {
  if (eventName.length == 0) {
    return null
  }
  const snapshot = {} as UTSJSONObject
  snapshot['action'] = action
  snapshot['eventName'] = eventName
  const staticTarget = buildStaticTargetSnapshot(
    staticId,
    staticIndex,
    staticTitle,
    staticSrc,
    staticGrowingTrack,
    staticGrowingIgnore
  )
  if (elementType != null && elementType.length > 0) {
    snapshot['elementType'] = elementType
  }
  let runtimeDetail : UTSJSONObject | null = null
  if (event != null && typeof event == 'object' && !Array.isArray(event)) {
    const type = readStringField(event, 'type')
    if (type != null) {
      snapshot['type'] = type
    }
    const timeStamp = readNumberField(event, 'timeStamp')
    if (timeStamp != null) {
      snapshot['timeStamp'] = timeStamp
    }
    const currentTarget = mergeStaticTargetSnapshot(
      copyEventTargetSnapshot(readDynamicField(event, 'currentTarget')),
      staticTarget
    )
    const target = mergeStaticTargetSnapshot(
      copyEventTargetSnapshot(readDynamicField(event, 'target')),
      staticTarget
    )
    const primaryTarget = preferOriginalTarget && target != null
      ? target
      : currentTarget
    if (primaryTarget != null) {
      snapshot['currentTarget'] = primaryTarget
    }
    if (target != null) {
      snapshot['target'] = target
    }
    runtimeDetail = copyEventDetailSnapshot(readDynamicField(event, 'detail'))
  } else if (staticTarget != null) {
    snapshot['currentTarget'] = staticTarget
    snapshot['target'] = staticTarget
  }
  const detail = runtimeDetail != null ? runtimeDetail : {} as UTSJSONObject
  const hasInjectedValue = copyInjectedDetailValue(detail, eventDetail)
  if (runtimeDetail != null || hasInjectedValue) {
    snapshot['detail'] = detail
  }
  return snapshot
}

export function buildAutoTrackTabItemSnapshot(item : any | null) : UTSJSONObject | null {
  const target = copyTabItemTargetSnapshot(item)
  if (target == null) {
    return null
  }
  const snapshot = {} as UTSJSONObject
  snapshot['action'] = 'CLICK'
  snapshot['eventName'] = 'onTabItemTap'
  snapshot['type'] = 'tap'
  snapshot['target'] = target
  return snapshot
}
