// plugin.uts — JS 编译层入口（Vue 上下文）
// 职责：仅负责 defineMixin 生命周期混入，不包含初始化逻辑。
// 初始化逻辑已移入 utssdk/index.uts 的 initialize()。
// 通过模块路径 @/uni_modules/gio-uniappx-autotracker 导入 GioTracker，
// 而非直接依赖 utssdk 内部文件路径。

import { onPageLoad, onShow, onHide, onPageUnload } from '@/uni_modules/gio-uniappx-autotracker'
import { gdp } from './gdp.uts'

export { gdp }
export default gdp

// #ifdef MP-WEIXIN
export {
  wrapAddToFavorites,
  wrapShareAppMessage,
  wrapShareTimeline
} from '@/uni_modules/gio-uniappx-autotracker'
// #endif
let lifecycleInstalled = false

const lifecycle = defineMixin({
  // @ts-ignore
  onLaunch(options : any | null = null) {
  },
  // @ts-ignore
  onLoad(options : OnLoadOptions) {
    // @ts-ignore
  },
  // @ts-ignore
  onShow(options : any | null = null) {
    // @ts-ignore
  },
  // @ts-ignore
  onHide() {
    // @ts-ignore
  },
  // @ts-ignore
  onUnload() {
    // @ts-ignore
  }
})

export function installGioLifecycle(app : VueApp) : boolean {
  if (lifecycleInstalled) {
    return true
  }
  app.mixin(lifecycle)
  lifecycleInstalled = true
  return true
}
