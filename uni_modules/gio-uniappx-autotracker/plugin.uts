import { normalizeInitOptions } from './utssdk/common/config.uts'
import { GioTracker } from './utssdk/common/core/tracker.uts'

const tracker = GioTracker.getInstance()
let lifecycleInstalled = false

const lifecycle = defineMixin({
  // @ts-ignore
  onLoad(options : OnLoadOptions) {
    // @ts-ignore
    tracker.onPageLoad(this, options)
  },
  // @ts-ignore
  onShow() {
    // @ts-ignore
    tracker.onShow(this)
  },
  // @ts-ignore
  onHide() {
    // @ts-ignore
    tracker.onHide(this)
  },
  // @ts-ignore
  onUnload() {
    // @ts-ignore
    tracker.onPageUnload(this)
  }
})

function bindInitOptions(rawOptions : UTSJSONObject) {
  // #ifdef WEB
  try { window['vdsConfig'] = rawOptions } catch (_error) {}
  // #endif
  // #ifdef MP-WEIXIN
  try { globalThis['vdsConfig'] = rawOptions } catch (_error) {}
  // #endif
}

export function installGioLifecycle(app : VueApp) : boolean {
  if (lifecycleInstalled) {
    return true
  }
  app.mixin(lifecycle)
  lifecycleInstalled = true
  return true
}

export function initializeGioTracker(rawOptions : UTSJSONObject) : boolean {
  bindInitOptions(rawOptions)
  const initOptions = normalizeInitOptions(rawOptions)
  return tracker.initialize(initOptions)
}

const gioUniappxAutotracker = definePlugin({
  install(app : VueApp, options : UTSJSONObject) {
    initializeGioTracker(options)
    installGioLifecycle(app)
  }
})
