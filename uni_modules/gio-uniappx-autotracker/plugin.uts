// plugin.uts 是 Vue / JS 编译层的生命周期桥接入口。
// 这里只负责挂载 mixin、提取页面快照和启动参数快照，再把稳定对象转发给 utssdk；
// 初始化、session、事件构建和上报都由 utssdk 内部处理。

import {
  onHide as handleOnHide,
  onLaunch as handleOnLaunch,
  onPageLoad as handleOnPageLoad,
  onPageUnload as handleOnPageUnload,
  onShow as handleOnShow
} from '@/uni_modules/gio-uniappx-autotracker'
import { gdp } from './gdp.uts'

export { gdp }
export default gdp

// #ifdef MP-WEIXIN
export {
  wrapAddToFavorites,
  wrapShareAppMessage,
  wrapShareTimeline
} from '@/uni_modules/gio-uniappx-autotracker'
// #endif
let lifecycleInstalled = false
// #ifdef MP-WEIXIN
let mpAppLifecycleInstalled = false
// #endif

function copyJSONObject(source : any | null) : UTSJSONObject | null {
  if (source == null || typeof source != 'object' || Array.isArray(source)) {
    return null
  }
  const text = JSON.stringify(source)
  if (text == null || text.length == 0) {
    return null
  }
  const copied = JSON.parseObject(text)
  if (copied == null || UTSJSONObject.keys(copied).length == 0) {
    return null
  }
  return copied
}

function stringifyScalar(value : any | null) : string | null {
  if (value == null) {
    return null
  }
  if (typeof value == 'string') {
    const text = value as string
    return text.length > 0 ? text : null
  }
  if (typeof value == 'number') {
    return `${value as number}`
  }
  if (typeof value == 'boolean') {
    return `${value as boolean}`
  }
  return null
}

function copyReferrerInfo(source : UTSJSONObject | null) : UTSJSONObject | null {
  if (source == null) {
    return null
  }
  const copied = {} as UTSJSONObject
  const appId = stringifyScalar(source['appId'])
  if (appId != null) {
    copied['appId'] = appId
  }
  const extraData = source.getJSON('extraData')
  if (extraData != null) {
    copied['extraData'] = extraData
  }
  return UTSJSONObject.keys(copied).length > 0 ? copied : null
}

function getCurrentUniPage() : UniPage | null {
  const pages = getCurrentPages()
  if (pages.length == 0) {
    return null
  }
  return pages[pages.length - 1]
}

function readCurrentPageTitle(page : UniPage) : string | null {
  try {
    const pageStyle = page.$getPageStyle()
    const titleValue = pageStyle.getString('navigationBarTitleText', '')
    return titleValue.length > 0 ? titleValue : null
  } catch (_error) {
    return null
  }
}

// 页面实例不能直接进入 utssdk。
// App 端通过官方页面栈读取稳定 UniPage 字段，再转成明确 UTSJSONObject 快照。
function buildPageSnapshot() : UTSJSONObject | null {
  const page = getCurrentUniPage()
  if (page == null || page.route.length == 0) {
    return null
  }

  const snapshot = {} as UTSJSONObject
  snapshot['route'] = page.route
  const title = readCurrentPageTitle(page)
  if (title != null) {
    snapshot['title'] = title
  }
  const options = copyJSONObject(page.options)
  if (options != null) {
    snapshot['options'] = options
  }
  // 微信端 route.uts 优先读取 mpRoute/mpOptions；这里仍然只放稳定快照字段。
  // #ifdef MP-WEIXIN
  snapshot['mpRoute'] = page.route
  if (options != null) {
    snapshot['mpOptions'] = options
  }
  // #endif
  return snapshot
}

// 启动参数同样先裁成稳定快照，避免把原始 options 直接传入原生编译层。
function buildLaunchOptionsSnapshot(options : any | null) : UTSJSONObject | null {
  const raw = copyJSONObject(options)
  if (raw == null) {
    return null
  }
  const copied = {} as UTSJSONObject
  const path = stringifyScalar(raw['path'])
  if (path != null) {
    copied['path'] = path
  }
  const scene = stringifyScalar(raw['scene'])
  if (scene != null) {
    copied['scene'] = scene
  }
  const query = raw.getJSON('query')
  if (query != null) {
    copied['query'] = query
  }
  const referrerInfo = copyReferrerInfo(raw.getJSON('referrerInfo'))
  if (referrerInfo != null) {
    copied['referrerInfo'] = referrerInfo
  }
  const refererInfo = copyReferrerInfo(raw.getJSON('refererInfo'))
  if (refererInfo != null) {
    copied['refererInfo'] = refererInfo
  }
  return UTSJSONObject.keys(copied).length > 0 ? copied : null
}

// 页面生命周期参数通常就是 route query 的平铺对象。
// 这里仍然做浅拷贝，但不能按启动参数那套白名单裁剪，否则普通页面参数会被误丢弃。
function buildPageOptionsSnapshot(options : any | null) : UTSJSONObject | null {
  return copyJSONObject(options)
}

// #ifdef MP-WEIXIN
// uni-app x 的 MP-WEIXIN global mixin 会收到一轮带 App 入口参数的 onShow。
// App 生命周期已由 uni.onAppShow/uni.onAppHide 显式桥接，这里只过滤掉这轮
// App-like mixin 回调，避免被当作 Page onShow 重复发送 PAGE。
function isLaunchOptionsSnapshot(source : UTSJSONObject | null) : boolean {
  if (source == null) {
    return false
  }
  return source['path'] != null && source['scene'] != null
}

function installMpAppLifecycle() {
  if (mpAppLifecycleInstalled) {
    return
  }
  mpAppLifecycleInstalled = true
  const runtime = uni as any
  const onAppShow = runtime.onAppShow
  if (typeof onAppShow == 'function') {
    onAppShow((options : any | null) => {
      handleOnShow(null, buildLaunchOptionsSnapshot(options))
    })
  }
  const onAppHide = runtime.onAppHide
  if (typeof onAppHide == 'function') {
    onAppHide(() => {
      handleOnHide(null)
    })
  }
}
// #endif

// #ifdef APP-IOS || APP-HARMONY
function isAppInstance(instance : any | null) : boolean {
  if (instance == null) {
    return true
  }
  // @ts-ignore
  const page = instance.$page
  return page == null
}
// #endif

const lifecycle = defineMixin({
  // 各端页面实例类型不同，mixin 生命周期函数的 this / options 只能在桥接层按 any 接住，
  // 再尽快转换成明确快照对象。
  // @ts-ignore
  onLaunch(options : any | null) {
    handleOnLaunch(buildLaunchOptionsSnapshot(options))
  },
  // 生命周期函数的 this 在各端并没有统一静态类型，这里只在桥接层忽略类型检查。
  // @ts-ignore
  onLoad(options : OnLoadOptions) {
    handleOnPageLoad(
      buildPageSnapshot(),
      buildPageOptionsSnapshot(options)
    )
  },
  // 生命周期函数的 this 在各端并没有统一静态类型，这里只在桥接层忽略类型检查。
  // @ts-ignore
  onShow(options : any | null) {
    // #ifdef MP-WEIXIN
    const launchOptions = buildLaunchOptionsSnapshot(options)
    if (isLaunchOptionsSnapshot(launchOptions)) {
      return
    }
    // #endif
    // #ifdef APP-IOS || APP-HARMONY
    if (isAppInstance(this)) {
      handleOnShow(null, null)
      return
    }
    // #endif
    const pageSnapshot = buildPageSnapshot()
    handleOnShow(
      pageSnapshot,
      null
    )
  },
  // 生命周期函数的 this 在各端并没有统一静态类型，这里只在桥接层忽略类型检查。
  // @ts-ignore
  onHide() {
    // #ifdef APP-IOS || APP-HARMONY
    if (isAppInstance(this)) {
      handleOnHide(null)
      return
    }
    // #endif
    const pageSnapshot = buildPageSnapshot()
    handleOnHide(pageSnapshot)
  },
  // 生命周期函数的 this 在各端并没有统一静态类型，这里只在桥接层忽略类型检查。
  // @ts-ignore
  onUnload() {
    handleOnPageUnload(buildPageSnapshot())
  }
})

export function installGioLifecycle(app : VueApp) : boolean {
  if (lifecycleInstalled) {
    return true
  }
  // #ifdef MP-WEIXIN
  installMpAppLifecycle()
  // #endif
  app.mixin(lifecycle)
  lifecycleInstalled = true
  return true
}
