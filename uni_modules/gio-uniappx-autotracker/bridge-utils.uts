export function copyJSONObject(source : any | null, keys : Array<string> | null = null) : UTSJSONObject | null {
  if (source == null || typeof source != 'object' || Array.isArray(source)) {
    return null
  }
  // #ifndef APP-ANDROID
  const text = (keys != null && keys.length > 0) ? JSON.stringify(source, keys) : JSON.stringify(source)
  // #endif
  // #ifdef APP-ANDROID
  const text = (keys != null && keys.length > 0) ? JSON.stringify(source, new UTSArray(keys)) : JSON.stringify(source)
  // #endif
  if (text == null || text.length == 0) {
    return null
  }
  const copied = JSON.parseObject(text)
  if (copied == null || UTSJSONObject.keys(copied).length == 0) {
    return null
  }
  return copied
}

export function readDynamicField(source : any | null, key : string) : any | null {
  if (source == null || typeof source != 'object' || Array.isArray(source)) {
    return null
  }
  const raw = copyJSONObject(source, [key])
  if (raw == null) {
    return null
  }
  const value = raw.get(key)
  return value != null ? value : null
}
