// mp-weixin.uts 是 JS 编译层的小程序平台门面。
// plugin.uts / gdp.uts 只依赖这个稳定入口，避免在多个 JS 层文件里散落 utssdk 内部路径。
import {
  clearLocation as coreClearLocation,
  clearUserId as coreClearUserId,
  getABTest as coreGetABTest,
  identify as coreIdentify,
  initialize as coreInitialize,
  onHide as coreOnHide,
  onLaunch as coreOnLaunch,
  onPageLoad as coreOnPageLoad,
  onPageUnload as coreOnPageUnload,
  onShow as coreOnShow,
  registerPlugins as coreRegisterPlugins,
  setLocation as coreSetLocation,
  setOptions as coreSetOptions,
  setUserAttributes as coreSetUserAttributes,
  setUserId as coreSetUserId,
  track as coreTrack,
  GioAddToFavoritesHandler,
  GioShareAppMessageHandler,
  GioShareTimelineHandler,
  wrapAddToFavorites as coreWrapAddToFavorites,
  wrapShareAppMessage as coreWrapShareAppMessage,
  wrapShareTimeline as coreWrapShareTimeline
} from './utssdk/mp-weixin/index.uts'

export function initialize(options : UTSJSONObject) : boolean {
  return coreInitialize(options)
}

export function onLaunch(options : UTSJSONObject | null = null) {
  coreOnLaunch(options)
}

export function onPageLoad(page : UTSJSONObject | null, options : UTSJSONObject | null) {
  coreOnPageLoad(page, options)
}

export function onShow(target : UTSJSONObject | null, options : UTSJSONObject | null = null) {
  coreOnShow(target, options)
}

export function onHide(target : UTSJSONObject | null) {
  coreOnHide(target)
}

export function onPageUnload(page : UTSJSONObject | null) {
  coreOnPageUnload(page)
}

export function track(eventName : string, properties : UTSJSONObject | null = null) : boolean {
  return coreTrack(eventName, properties)
}

export function setUserId(userId : string, userKey : string | null = null) : boolean {
  return coreSetUserId(userId, userKey)
}

export function clearUserId() : boolean {
  return coreClearUserId()
}

export function identify(assignmentId : any) : boolean {
  return coreIdentify(assignmentId)
}

export function setOptions(options : UTSJSONObject) : boolean {
  return coreSetOptions(options)
}

export function setLocation(latitude : number, longitude : number) : boolean {
  return coreSetLocation(latitude, longitude)
}

export function clearLocation() : boolean {
  return coreClearLocation()
}

export function setUserAttributes(userAttributes : UTSJSONObject | null) : boolean {
  return coreSetUserAttributes(userAttributes)
}

export function registerPlugins(plugins : Array<UTSJSONObject>) : boolean {
  return coreRegisterPlugins(plugins)
}

export function getABTest(
  layerId : any,
  callback : ((result : any) => void) | null = null
) : boolean {
  return coreGetABTest(layerId, callback)
}

export function wrapShareAppMessage(
  handler : GioShareAppMessageHandler | null
) : GioShareAppMessageHandler {
  return coreWrapShareAppMessage(handler)
}

export function wrapShareTimeline(
  handler : GioShareTimelineHandler | null
) : GioShareTimelineHandler {
  return coreWrapShareTimeline(handler)
}

export function wrapAddToFavorites(
  handler : GioAddToFavoritesHandler | null
) : GioAddToFavoritesHandler {
  return coreWrapAddToFavorites(handler)
}
