// Android App 端系统字段解析器。
import {
  GioSystemContextFields,
  GioSystemContextResolver
} from '../interface.uts'

function readTextField(source : UTSJSONObject | null, key : string) : string | null {
  if (source == null) {
    return null
  }
  const value = source.getString(key)
  return value != null && value.length > 0 ? value : null
}

function readAndroidChannel() : string | null {
  try {
    const appBase = uni.getAppBaseInfo()
    const channel = appBase.channel
    return channel != null && channel.length > 0 ? channel : null
  } catch (_error) {
    return null
  }
}

class AppAndroidSystemContextResolver implements GioSystemContextResolver {
  resolveSystemContext(
    systemInfo : UTSJSONObject | null,
    osName : string,
    osLabel : string,
    version : string,
    deviceBrand : string,
    deviceType : string
  ) : GioSystemContextFields | null {
    return {
      appName: readTextField(systemInfo, 'appName'),
      bundleId: readTextField(systemInfo, 'bundleId'),
      channel: readAndroidChannel(),
      deviceBrand: deviceBrand,
      deviceModel: null,
      deviceType: deviceType,
      language: null,
      networkState: null,
      operatingSystem: osLabel,
      platform: osLabel,
      platformVersion: version.length > 0 ? version : osLabel
    } as GioSystemContextFields
  }
}

export function createAppAndroidSystemContextResolver() : GioSystemContextResolver {
  return new AppAndroidSystemContextResolver()
}
