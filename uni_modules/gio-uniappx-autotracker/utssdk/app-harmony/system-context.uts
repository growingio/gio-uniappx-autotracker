// Harmony App 端系统字段解析器。
import {
  GioSystemContextFields,
  GioSystemContextResolver
} from '../interface.uts'
import { readStringField } from '../common/utils/base.uts'

class AppHarmonySystemContextResolver implements GioSystemContextResolver {
  resolveSystemContext(
    systemInfo : UTSJSONObject | null,
    osName : string,
    osLabel : string,
    version : string,
    deviceBrand : string,
    deviceType : string
  ) : GioSystemContextFields | null {
    return {
      appName: readStringField(systemInfo, 'appName'),
      bundleId: readStringField(systemInfo, 'bundleId'),
      channel: null,
      deviceBrand: deviceBrand,
      deviceModel: null,
      deviceType: deviceType,
      language: null,
      networkState: null,
      operatingSystem: osLabel,
      platform: osLabel,
      platformVersion: version.length > 0 ? version : osLabel
    } as GioSystemContextFields
  }
}

export function createAppHarmonySystemContextResolver() : GioSystemContextResolver {
  return new AppHarmonySystemContextResolver()
}
