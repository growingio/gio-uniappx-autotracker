// App 平台运行时策略。common 只消费抽象策略，移动端 session 超时语义收敛在这里。
import { GioInitOptions } from '../interface.uts'
import { registerRuntimePolicy } from '../common/runtime/index.uts'

const APP_SESSION_TIMEOUT_MS = 30 * 1000

registerRuntimePolicy({
  getInitStartMessage(fallback : string) : string {
    return fallback
  },
  getInitCompleteMessage(fallback : string) : string {
    return fallback
  },
  getSessionTimeoutMs(_fallback : number) : number {
    return APP_SESSION_TIMEOUT_MS
  },
  shouldRenewSessionOnTimeout() : boolean {
    return true
  },
  getMaxQueueSize(fallback : number) : number {
    return fallback
  },
  shouldPersistSessionId() : boolean {
    return false
  },
  shouldPersistEvents() : boolean {
    return true
  },
  shouldWaitForNetworkState() : boolean {
    return true
  },
  shouldEmitPageWithoutShow() : boolean {
    return false
  },
  supportsAppState() : boolean {
    return true
  },
  supportsLocation() : boolean {
    return true
  },
  getPageReferralFallback(_options : GioInitOptions) : string {
    return ''
  },
  getUploadRequestTimeout(fallback : number) : number {
    return fallback
  },
  getUploadMaxConcurrency(fallback : number) : number {
    return fallback
  }
})
