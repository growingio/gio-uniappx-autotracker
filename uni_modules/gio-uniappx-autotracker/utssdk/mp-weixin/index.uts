// 微信小程序平台入口。
// 这里只注册小程序专属 resolver 和分享包装器，再复用公共 utssdk 入口。
import { GioTracker } from '../common/core/tracker.uts'
import { createOriginalSourceStore } from '../platform-shared/original-source.uts'
import { createMiniProgramResolver } from './resolver.uts'
import { installGioShareTrackingPlugin } from './plugins/gio-share-tracking.uts'

GioTracker.getInstance().setOriginalSourceStore(
  createOriginalSourceStore()
)
GioTracker.getInstance().setMiniProgramResolver(
  createMiniProgramResolver()
)
installGioShareTrackingPlugin(GioTracker.getInstance())

export * from './plugins/gio-share-tracking.uts'

export * from '../index.uts'
