// iOS App 端系统字段解析器。
import {
  GioSystemContextFields,
  GioSystemContextResolver
} from '../interface.uts'
import { resolveIosDeviceModel } from '../common/utils/device-model.uts'

function readTextField(source : UTSJSONObject | null, key : string) : string | null {
  if (source == null) {
    return null
  }
  const value = source.getString(key)
  return value != null && value.length > 0 ? value : null
}

function mapIosDeviceType(deviceType : string) : string {
  return deviceType.toLowerCase() == 'pad' ? 'iPad' : 'iPhone'
}

class AppIosSystemContextResolver implements GioSystemContextResolver {
  resolveSystemContext(
    systemInfo : UTSJSONObject | null,
    osName : string,
    osLabel : string,
    version : string,
    deviceBrand : string,
    deviceType : string
  ) : GioSystemContextFields | null {
    const rawDeviceModel = readTextField(systemInfo, 'deviceModel')
    let deviceModel = ''
    if (rawDeviceModel != null) {
      deviceModel = rawDeviceModel
    }
    return {
      appName: readTextField(systemInfo, 'appName'),
      bundleId: readTextField(systemInfo, 'bundleId'),
      channel: null,
      deviceBrand: 'Apple',
      deviceModel: resolveIosDeviceModel(deviceModel),
      deviceType: mapIosDeviceType(deviceType),
      language: null,
      networkState: null,
      operatingSystem: osLabel,
      platform: osLabel,
      platformVersion: version.length > 0 ? version : osLabel
    } as GioSystemContextFields
  }
}

export function createAppIosSystemContextResolver() : GioSystemContextResolver {
  return new AppIosSystemContextResolver()
}
