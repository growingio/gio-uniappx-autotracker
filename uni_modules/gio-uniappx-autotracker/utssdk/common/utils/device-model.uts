// device-model.uts 把 iOS 营销机型名映射回硬件标识符（如 iPhone 17 Pro -> iPhone18,1）。
// uni.getDeviceInfo() 在 iOS 上拿到的是营销名，原生上报口径要标识符。
// 数据来源 https://gist.github.com/adamawolf/3048717
// 营销名重复的旧机型（如 iPhone 7 = iPhone9,1/9,3）只保留首个标识符；
// iPad 因来源里营销名有歧义/重复，这里不做映射，原样返回。

const IOS_DEVICE_MODEL_MAP = {
  'iPhone': 'iPhone1,1',
  'iPhone 3G': 'iPhone1,2',
  'iPhone 3GS': 'iPhone2,1',
  'iPhone 4': 'iPhone3,1',
  'iPhone 4 GSM Rev A': 'iPhone3,2',
  'iPhone 4 CDMA': 'iPhone3,3',
  'iPhone 4S': 'iPhone4,1',
  'iPhone 5 (GSM)': 'iPhone5,1',
  'iPhone 5 (GSM+CDMA)': 'iPhone5,2',
  'iPhone 5C (GSM)': 'iPhone5,3',
  'iPhone 5C (Global)': 'iPhone5,4',
  'iPhone 5S (GSM)': 'iPhone6,1',
  'iPhone 5S (Global)': 'iPhone6,2',
  'iPhone 6 Plus': 'iPhone7,1',
  'iPhone 6': 'iPhone7,2',
  'iPhone 6s': 'iPhone8,1',
  'iPhone 6s Plus': 'iPhone8,2',
  'iPhone SE (GSM)': 'iPhone8,4',
  'iPhone 7': 'iPhone9,1',
  'iPhone 7 Plus': 'iPhone9,2',
  'iPhone 8': 'iPhone10,1',
  'iPhone 8 Plus': 'iPhone10,2',
  'iPhone X Global': 'iPhone10,3',
  'iPhone X GSM': 'iPhone10,6',
  'iPhone XS': 'iPhone11,2',
  'iPhone XS Max': 'iPhone11,4',
  'iPhone XS Max Global': 'iPhone11,6',
  'iPhone XR': 'iPhone11,8',
  'iPhone 11': 'iPhone12,1',
  'iPhone 11 Pro': 'iPhone12,3',
  'iPhone 11 Pro Max': 'iPhone12,5',
  'iPhone SE 2nd Gen': 'iPhone12,8',
  'iPhone 12 Mini': 'iPhone13,1',
  'iPhone 12': 'iPhone13,2',
  'iPhone 12 Pro': 'iPhone13,3',
  'iPhone 12 Pro Max': 'iPhone13,4',
  'iPhone 13 Pro': 'iPhone14,2',
  'iPhone 13 Pro Max': 'iPhone14,3',
  'iPhone 13 Mini': 'iPhone14,4',
  'iPhone 13': 'iPhone14,5',
  'iPhone SE 3rd Gen': 'iPhone14,6',
  'iPhone 14': 'iPhone14,7',
  'iPhone 14 Plus': 'iPhone14,8',
  'iPhone 14 Pro': 'iPhone15,2',
  'iPhone 14 Pro Max': 'iPhone15,3',
  'iPhone 15': 'iPhone15,4',
  'iPhone 15 Plus': 'iPhone15,5',
  'iPhone 15 Pro': 'iPhone16,1',
  'iPhone 15 Pro Max': 'iPhone16,2',
  'iPhone 16 Pro': 'iPhone17,1',
  'iPhone 16 Pro Max': 'iPhone17,2',
  'iPhone 16': 'iPhone17,3',
  'iPhone 16 Plus': 'iPhone17,4',
  'iPhone 16e': 'iPhone17,5',
  'iPhone 17 Pro': 'iPhone18,1',
  'iPhone 17 Pro Max': 'iPhone18,2',
  'iPhone 17': 'iPhone18,3',
  'iPhone Air': 'iPhone18,4',
  'iPhone 17e': 'iPhone18,5'
} as UTSJSONObject

export function resolveIosDeviceModel(marketingName : string) : string {
  if (marketingName.length == 0) {
    return marketingName
  }
  const identifier = IOS_DEVICE_MODEL_MAP.getString(marketingName, '')
  return identifier.length > 0 ? identifier : marketingName
}
