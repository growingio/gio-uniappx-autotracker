// system.uts 放系统信息快照、平台识别和标准系统上下文组装。

export type GioSystemContext = {
  appName : string
  appState : string | null
  bundleId : string
  channel : string
  isApp : boolean
  deviceBrand : string
  deviceModel : string
  deviceType : string
  language : string
  networkState : string
  operatingSystem : string
  platform : string
  platformVersion : string
  screenHeight : number
  screenWidth : number
}

function readSystemText(source : any | null, keys : Array<string>) : string {
  if (source == null) {
    return ''
  }
  const raw = source as UTSJSONObject
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    const value = raw[key]
    if (value != null && `${value}`.length > 0) {
      return `${value}`
    }
  }
  return ''
}

export function getSystemInfoSnapshot() : UTSJSONObject | null {
  // UTS 不能像 JS 一样按字符串动态访问 `uni` 上的方法，只能直接调用明确 API，
  // 再把消费者需要的系统信息拼成快照对象。
  try {
    const snapshot = {} as UTSJSONObject

    const device = uni.getDeviceInfo()
    snapshot['deviceBrand'] = device.deviceBrand
    snapshot['brand'] = device.brand
    snapshot['deviceModel'] = device.deviceModel
    snapshot['model'] = device.model
    snapshot['osName'] = device.osName
    snapshot['osVersion'] = device.osVersion
    snapshot['platform'] = device.platform
    snapshot['deviceType'] = device.deviceType

    const appBase = uni.getAppBaseInfo()
    snapshot['uniPlatform'] = appBase.uniPlatform
    snapshot['version'] = appBase.version
    snapshot['appLanguage'] = appBase.appLanguage
    snapshot['language'] = appBase.language
    snapshot['appName'] = appBase.appName
    // #ifdef APP-IOS
    snapshot['bundleId'] = appBase.bundleId
    // #endif
    // #ifdef APP-ANDROID
    snapshot['bundleId'] = appBase.packageName
	  // 仅app-android平台支持渠道包
	  // https://doc.dcloud.net.cn/uni-app-x/api/get-app-base-info.html#channel
	  snapshot['channel'] = appBase.channel
    // #endif
    // #ifdef APP-HARMONY
    snapshot['bundleId'] = appBase.bundleName
    // #endif

    return snapshot
  } catch (_error) {
    return null
  }
}

export function readDeviceOrientation() : string | null {
  try {
    const orientation = uni.getDeviceInfo().deviceOrientation
    if (orientation.length == 0) {
      return null
    }
    return orientation.toLowerCase() == 'landscape' ? 'LANDSCAPE' : 'PORTRAIT'
  } catch (_error) {
    return null
  }
}

export function platformName () : string {
  const system = getSystemInfoSnapshot()
  const platform = readSystemText(system, ['uniPlatform', 'platform'])
  if (platform.length > 0) {
    return platform
  }
  return 'unknown'
}
