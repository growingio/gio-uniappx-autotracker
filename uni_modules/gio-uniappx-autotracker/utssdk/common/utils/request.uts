// request.uts 放上报地址与请求路径相关的纯拼装工具。

export function normalizeServerUrl (serverUrl : string) : string {
  if (serverUrl.endsWith('/')) {
    return serverUrl.slice(0, serverUrl.length - 1)
  }
  return serverUrl
}

export function buildCollectUrl (serverUrl : string, projectId : string) : string {
  return `${normalizeServerUrl(serverUrl)}/v3/projects/${projectId}/collect`
}
