// uploader 负责事件排队、批量发送、失败重试和 forceLogin 积压释放。
import { GioInitOptions, GioTrackEvent } from '../../interface.uts'
import { DEFAULT_REQUEST_TIMEOUT_MS } from '../config.uts'
import { BoxArray, guid } from '../utils/base.uts'
import { stringifyScalar } from '../utils/validate.uts'
import { debugLog, debugLogRequest } from '../utils/debug.uts'
import { buildCollectUrl } from '../utils/request.uts'
import { platformName } from '../utils/system.uts'
import { dispatchViaEventSender } from '../runtime/index.uts'

type GioQueuedEvent = {
  requestId : string
  retryCount : number
  event : GioTrackEvent
}

const MAX_BATCH_SIZE = 50
const MAX_RETRY_COUNT = 2
const DEFAULT_MP_REQUEST_TIMEOUT_MS = 5000

export class GioUploader {
  private options : GioInitOptions | null = null
  private pending : BoxArray<GioQueuedEvent> = new BoxArray()
  private hoarding : BoxArray<GioQueuedEvent> = new BoxArray()
  private inflight : boolean = false
  private forceLogin : boolean = false
  private onFlushSuccess : ((events : Array<GioTrackEvent>) => void) | null = null
  private flushTimer : number = 0
  private uploadInterval : number = 1000

  configure(
    options : GioInitOptions,
    onFlushSuccess : ((events : Array<GioTrackEvent>) => void) | null = null
  ) {
    this.options = options
    this.forceLogin = options.forceLogin == true
    this.onFlushSuccess = onFlushSuccess
  }

  private shouldThrottleFlush() : boolean {
    return platformName().startsWith('mp-')
  }

  private continueFlush() {
    if (this.pending.length == 0) {
      return
    }
    if (this.shouldThrottleFlush()) {
      this.scheduleFlush()
      return
    }
    if (!this.inflight) {
      this.flush(null, null)
    }
  }

  private sanitizeValue(value : any | null) : any | null {
    if (value == null) {
      return null
    }
    if (typeof value == 'string') {
      return value.length > 0 ? value : null
    }
    if (Array.isArray(value)) {
      const items = [] as Array<any>
      for (let i = 0; i < value.length; i++) {
        const sanitizedItem = this.sanitizeValue(value[i])
        if (sanitizedItem != null) {
          items.push(sanitizedItem)
        }
      }
      return items
    }
    if (typeof value == 'object') {
      const raw = value as UTSJSONObject
      const sanitized = {} as UTSJSONObject
      const keys = UTSJSONObject.keys(raw)
      for (let i = 0; i < keys.length; i++) {
        const key = keys[i]
        const sanitizedValue = this.sanitizeValue(raw[key])
        if (sanitizedValue != null) {
          sanitized[key] = sanitizedValue
        }
      }
      return UTSJSONObject.keys(sanitized).length > 0 ? sanitized : null
    }
    return value
  }

  private scheduleFlush() {
    if (this.flushTimer > 0 || this.pending.length == 0) {
      return
    }
    this.flushTimer = setTimeout(() => {
      this.flushTimer = 0
      this.flush(null, null)
    }, this.uploadInterval) as number
  }

  requestFlush() {
    this.continueFlush()
  }

  enqueue(event : GioTrackEvent, maxQueueSize : number) {
    const queue = this.forceLogin ? this.hoarding : this.pending
    queue.push({
      requestId: guid(),
      retryCount: 0,
      event: event
    } as GioQueuedEvent)
    if (queue.length > maxQueueSize) {
      queue.shift()
    }
    if (!this.forceLogin) {
      this.continueFlush()
    }
  }

  getPendingCount() : number {
    // Swift 里数组长度是 Int，而这里的返回类型是 number，对外返回前要显式转一次。
    return this.pending.length as number
  }

  getHoardingCount() : number {
    return this.hoarding.length as number
  }

  setForceLogin(forceLogin : boolean) {
    this.forceLogin = forceLogin
  }

  releaseHoarding(deviceId : string, maxQueueSize : number) {
    for (let i = 0; i < this.hoarding.length; i++) {
      const queued = this.hoarding.get(i as number)
	  if (queued != null) {
		  queued.event.deviceId = deviceId
		  this.pending.push(queued)
		  if (this.pending.length > maxQueueSize) {
			this.pending.shift()
		  }
	  }
    }
    this.hoarding = new BoxArray()
    this.scheduleFlush()
  }

  private sanitizeEvent(event : GioTrackEvent) : UTSJSONObject {
    const sanitized = {} as UTSJSONObject
    const raw = this.toEventJSONObject(event)
    const target = sanitized as UTSJSONObject
    const keys = UTSJSONObject.keys(raw)
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i]
      const sanitizedValue = this.sanitizeValue(raw[key])
      if (sanitizedValue == null) {
        continue
      }
      target[key] = sanitizedValue
    }
    return sanitized
  }

  private toEventJSONObject(event : GioTrackEvent) : UTSJSONObject {
    const payload = {
      appChannel: event.appChannel,
      appVersion: event.appVersion,
      dataSourceId: event.dataSourceId,
      deviceBrand: event.deviceBrand,
      deviceId: event.deviceId,
      deviceModel: event.deviceModel,
      deviceType: event.deviceType,
      domain: event.domain,
      eventName: event.eventName,
      eventSequenceId: event.eventSequenceId,
      eventType: event.eventType,
      language: event.language,
      latitude: event.latitude,
      longitude: event.longitude,
      networkState: event.networkState,
      operatingSystem: event.operatingSystem,
      path: event.path,
      platform: event.platform,
      platformVersion: event.platformVersion,
      query: event.query,
      referralPage: event.referralPage,
      screenHeight: event.screenHeight,
      screenWidth: event.screenWidth,
      sdkVersion: event.sdkVersion,
      sessionId: event.sessionId,
      timestamp: event.timestamp,
      timezoneOffset: event.timezoneOffset,
      title: event.title,
      userId: event.userId,
      userKey: event.userKey,
      attributes: event.attributes
    } as UTSJSONObject
    if (event.protocolType != null && event.protocolType.length > 0) {
      payload['protocolType'] = event.protocolType
    }
    return payload
  }

  private buildRequestHeader() : UTSJSONObject {
    const header = {} as UTSJSONObject
    header['content-type'] = 'application/json;charset=UTF-8'
    return header
  }

  private dequeueBatch() : Array<GioQueuedEvent> {
    const batch = this.pending.slice(0, MAX_BATCH_SIZE)
    this.pending.splice(0, batch.length as number)
    return batch
  }

  private settleBatch(
    batch : Array<GioQueuedEvent>,
    success : boolean,
    callback : (() => void) | null
  ) {
    if (success && this.onFlushSuccess != null) {
      const batchEvents = [] as Array<GioTrackEvent>
      for (let i = 0; i < batch.length; i++) {
        batchEvents.push(batch[i].event)
      }
      this.onFlushSuccess(batchEvents)
    }
    if (!success) {
      this.retryBatch(batch)
    }
    if (callback != null) {
      callback()
    }
    this.inflight = false
    if (success) {
      this.continueFlush()
      return
    }
    this.continueFlush()
  }

  private dispatchBatch(
    batch : Array<GioQueuedEvent>,
    requestData : Array<UTSJSONObject>,
    success : (() => void) | null,
    fail : (() => void) | null
  ) : boolean {
    const options = this.options
    if (options == null) {
      return false
    }
    const sendAt = Date.now()
    this.inflight = true
    const payload = JSON.stringify(requestData)

    const collectUrl = `${buildCollectUrl(options.serverUrl, options.projectId)}?stm=${sendAt}&compress=0`
    debugLogRequest(options.debug as boolean, 'request', collectUrl, requestData)
    const dispatched = dispatchViaEventSender(
      collectUrl,
      requestData,
      () => {
        this.settleBatch(batch, true, success)
      },
      () => {
        this.settleBatch(batch, false, fail)
      }
    )
    if (dispatched) {
      return true
    }

    uni.request<string>({
      url: collectUrl,
      method: 'POST',
      dataType: 'text',
      timeout: platformName().startsWith('mp-')
        ? DEFAULT_MP_REQUEST_TIMEOUT_MS
        : DEFAULT_REQUEST_TIMEOUT_MS,
      header: this.buildRequestHeader(),
      data: payload,
      success: (res : RequestSuccess<string>) => {
        const statusCode = res.statusCode
        if (statusCode == 200 || statusCode == 204) {
          this.settleBatch(batch, true, success)
          return
        }
        debugLog(options.debug as boolean, `request non-2xx statusCode=${stringifyScalar(statusCode)} data=${stringifyScalar(res.data)}`)
        this.settleBatch(batch, false, fail)
      },
      fail: (err : RequestFail) => {
        debugLog(options.debug as boolean, `request fail errCode=${stringifyScalar(err.errCode)} errMsg=${stringifyScalar(err.errMsg)}`)
        this.settleBatch(batch, false, fail)
      }
    } as RequestOptions<string>)
    return true
  }

  flush(success : (() => void) | null = null, fail : (() => void) | null = null) : boolean {
    if (this.options == null) {
      return false
    }
    if (this.pending.length == 0 || this.inflight) {
      return false
    }
    const batch = this.dequeueBatch()
    if (batch.length == 0) {
      return false
    }
    const requestData = [] as Array<UTSJSONObject>
    for (let i = 0; i < batch.length; i++) {
      requestData.push(this.sanitizeEvent(batch[i].event))
    }
    return this.dispatchBatch(batch, requestData, success, fail)
  }

  private retryBatch(batch : Array<GioQueuedEvent>) {
    const retriable = [] as Array<GioQueuedEvent>
    for (let i = 0; i < batch.length; i++) {
      const queued = batch[i]
      if (queued.retryCount >= MAX_RETRY_COUNT) {
        continue
      }
      retriable.push({
        requestId: queued.requestId,
        retryCount: queued.retryCount + 1,
        event: queued.event
      } as GioQueuedEvent)
    }
    for (let i = retriable.length - 1; i >= 0; i--) {
      this.pending.unshift(retriable[i])
    }
    if (this.pending.length > 0) {
      this.continueFlush()
    }
  }
}
