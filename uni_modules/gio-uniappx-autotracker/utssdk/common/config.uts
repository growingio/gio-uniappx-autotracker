import { GioInitOptions } from '../interface.uts'
import { platformName } from './utils.uts'

export const SDK_VERSION = '0.1.0'
export const DEFAULT_REQUEST_TIMEOUT_MS = 15 * 1000
export const DEFAULT_MAX_QUEUE_SIZE = 100
export const DEFAULT_APP_VERSION = '1.0.0'

function readRequiredString(raw : UTSJSONObject, key : string) : string {
  const value = raw[key]
  if (value == null) {
    return ''
  }
  return `${value}`
}

function readNullableString(raw : UTSJSONObject, key : string) : string | null {
  const value = raw[key]
  if (value == null) {
    return null
  }
  return `${value}`
}

// UTS-iOS collapses `boolean | null` to a non-null `Bool = false` (both in
// struct fields and fn returns), so the tri-state "unspecified" can't survive.
// Resolve every boolean default HERE against the raw object (the only place
// that still sees whether a key was provided) and store plain `boolean`.
function readBooleanWithDefault(raw : UTSJSONObject, key : string, fallback : boolean) : boolean {
  const value = raw[key]
  if (value == null) {
    return fallback
  }
  if (typeof value == 'boolean') {
    return value as boolean
  }
  return fallback
}

function readNumberWithDefault(raw : UTSJSONObject, key : string, fallback : number) : number {
  const value = raw[key]
  if (value == null) {
    return fallback
  }
  return value as number
}

export const DEFAULT_SERVER_URL = 'https://napi.growingio.com'

export function normalizeInitOptions (raw : UTSJSONObject) : GioInitOptions {
  // `||` is a boolean-only operator in UTS; can't use it for string fallback.
  const rawServerUrl = readRequiredString(raw, 'serverUrl')
  const serverUrl = rawServerUrl.length > 0 ? rawServerUrl : DEFAULT_SERVER_URL
  // followShare 仅小程序生效：mp-weixin 默认开启（用户未显式关闭时），其余端一律关闭，
  // 分享 / 收藏事件本就只在小程序端产生。
  const isMpWeixin = platformName() == 'mp-weixin'
  const followShare = isMpWeixin ? readBooleanWithDefault(raw, 'followShare', true) : false
  return {
    projectId: readRequiredString(raw, 'projectId'),
    dataSourceId: readRequiredString(raw, 'dataSourceId'),
    appId: readRequiredString(raw, 'appId'),
    serverUrl: serverUrl,
    appVersion: readNullableString(raw, 'appVersion'),
    dataCollect: readBooleanWithDefault(raw, 'dataCollect', true),
    debug: readBooleanWithDefault(raw, 'debug', false),
    forceLogin: readBooleanWithDefault(raw, 'forceLogin', false),
    originalSource: readBooleanWithDefault(raw, 'originalSource', true),
    followShare: followShare,
    idMapping: readBooleanWithDefault(raw, 'idMapping', false),
    storageType: readNullableString(raw, 'storageType'),
    cookieDomain: readNullableString(raw, 'cookieDomain'),
    screenWidth: readNumberWithDefault(raw, 'screenWidth', 0),
    screenHeight: readNumberWithDefault(raw, 'screenHeight', 0)
  } as GioInitOptions
}

class GioConfigData {
  static sharedInstance : GioConfigData | null = null

  static getInstance() : GioConfigData {
    if (GioConfigData.sharedInstance == null) {
      GioConfigData.sharedInstance = new GioConfigData()
    }
    return GioConfigData.sharedInstance as GioConfigData
  }

  private options : GioInitOptions | null = null

  private constructor() {}

  setOptions(options : GioInitOptions) {
    if (options.appVersion == null || options.appVersion.length == 0) {
      options.appVersion = DEFAULT_APP_VERSION
    }
    this.options = options
  }

  getOptions() : GioInitOptions | null {
    return this.options
  }
}

export const GioConfig = GioConfigData.getInstance()
