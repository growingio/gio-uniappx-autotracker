// config.uts 负责初始化配置的读取、归一化和默认值收口。
import { GioInitOptions } from '../interface.uts'

export const SDK_VERSION = '0.1.0'
export const DEFAULT_REQUEST_TIMEOUT_MS = 15 * 1000
export const DEFAULT_MAX_QUEUE_SIZE = 100
export const DEFAULT_APP_VERSION = '1.0.0'
export const DEFAULT_SERVER_URL = 'https://napi.growingio.com'

export function normalizeInitOptions (raw : UTSJSONObject) : GioInitOptions {
  const rawServerUrl = raw.getString('serverUrl', '')
  const serverUrl = rawServerUrl.length > 0 ? rawServerUrl : DEFAULT_SERVER_URL
  // period range is [3, 30]
  let dataValidityPeriod = raw.getNumber('dataValidityPeriod', 7)
  if (dataValidityPeriod < 3) {
    dataValidityPeriod = 3
  } else if (dataValidityPeriod > 30) {
    dataValidityPeriod = 30
  }
  return {
    projectId: raw.getString('projectId', ''),
    dataSourceId: raw.getString('dataSourceId', ''),
    appId: raw.getString('appId', ''),
    serverUrl: serverUrl,
    appVersion: raw.getString('appVersion'),
    dataCollect: raw.getBoolean('dataCollect', true),
    debug: raw.getBoolean('debug', false),
    forceLogin: raw.getBoolean('forceLogin', false),
    originalSource: raw.getBoolean('originalSource', true),
    idMapping: raw.getBoolean('idMapping', false),
    cookieDomain: raw.getString('cookieDomain'),
    urlScheme: raw.getString('urlScheme'),
    screenWidth: raw.getNumber('screenWidth', 0),
    screenHeight: raw.getNumber('screenHeight', 0),
    dataValidityPeriod: dataValidityPeriod
  } as GioInitOptions
}

class GioConfigData {
  static sharedInstance : GioConfigData | null = null

  static getInstance() : GioConfigData {
    if (GioConfigData.sharedInstance == null) {
      GioConfigData.sharedInstance = new GioConfigData()
    }
    return GioConfigData.sharedInstance as GioConfigData
  }

  private options : GioInitOptions | null = null

  private constructor() {}

  setOptions(options : GioInitOptions) {
    if (options.appVersion == null || options.appVersion.length == 0) {
      options.appVersion = DEFAULT_APP_VERSION
    }
    this.options = options
  }

  getOptions() : GioInitOptions | null {
    return this.options
  }
}

export const GioConfig = GioConfigData.getInstance()
