// config.uts 负责初始化配置的读取、归一化和默认值收口。
import { GioInitOptions } from '../interface.uts'

export const SDK_VERSION = '0.1.0'
export const DEFAULT_REQUEST_TIMEOUT_MS = 15 * 1000
export const DEFAULT_APP_VERSION = '1.0.0'
export const DEFAULT_SERVER_URL = 'https://napi.growingio.com'
export const DEFAULT_DATA_VALIDITY_DAYS = 7
export const MIN_DATA_VALIDITY_DAYS = 3
export const MAX_DATA_VALIDITY_DAYS = 30

function readRequiredConfigString(
  raw : UTSJSONObject,
  key : string,
  fallback : string
) : string {
  return raw.getString(key, fallback)
}

function readNullableConfigString(
  raw : UTSJSONObject,
  key : string,
  fallback : string | null
) : string | null {
  const value = raw.getString(key)
  return value != null ? value : fallback
}

function readConfigNumber(
  raw : UTSJSONObject,
  key : string,
  fallback : number
) : number {
  return raw.getNumber(key, fallback)
}

function readConfigBoolean(
  raw : UTSJSONObject,
  key : string,
  fallback : boolean
) : boolean {
  return raw.getBoolean(key, fallback)
}

export function normalizeInitOptions (raw : UTSJSONObject) : GioInitOptions {
  const rawServerUrl = readRequiredConfigString(raw, 'serverUrl', '')
  const serverUrl = rawServerUrl.length > 0 ? rawServerUrl : DEFAULT_SERVER_URL
  let dataValidityPeriod = readConfigNumber(
    raw,
    'dataValidityPeriod',
    DEFAULT_DATA_VALIDITY_DAYS
  )
  if (dataValidityPeriod < MIN_DATA_VALIDITY_DAYS) {
    dataValidityPeriod = MIN_DATA_VALIDITY_DAYS
  } else if (dataValidityPeriod > MAX_DATA_VALIDITY_DAYS) {
    dataValidityPeriod = MAX_DATA_VALIDITY_DAYS
  }
  return {
    projectId: readRequiredConfigString(raw, 'projectId', ''),
    dataSourceId: readRequiredConfigString(raw, 'dataSourceId', ''),
    appId: readRequiredConfigString(raw, 'appId', ''),
    serverUrl: serverUrl,
    appVersion: readNullableConfigString(raw, 'appVersion', null),
    dataCollect: readConfigBoolean(raw, 'dataCollect', true),
    debug: readConfigBoolean(raw, 'debug', false),
    forceLogin: readConfigBoolean(raw, 'forceLogin', false),
    originalSource: readConfigBoolean(raw, 'originalSource', true),
    idMapping: readConfigBoolean(raw, 'idMapping', false),
    urlScheme: readNullableConfigString(raw, 'urlScheme', null),
    screenWidth: readConfigNumber(raw, 'screenWidth', 0),
    screenHeight: readConfigNumber(raw, 'screenHeight', 0),
    dataValidityPeriod: dataValidityPeriod
  } as GioInitOptions
}

class GioConfigData {
  static sharedInstance : GioConfigData | null = null

  static getInstance() : GioConfigData {
    if (GioConfigData.sharedInstance == null) {
      GioConfigData.sharedInstance = new GioConfigData()
    }
    return GioConfigData.sharedInstance as GioConfigData
  }

  private options : GioInitOptions | null = null

  private constructor() {}

  setOptions(options : GioInitOptions) {
    if (options.appVersion == null || options.appVersion.length == 0) {
      options.appVersion = DEFAULT_APP_VERSION
    }
    this.options = options
  }

  getOptions() : GioInitOptions | null {
    return this.options
  }
}

export const GioConfig = GioConfigData.getInstance()
