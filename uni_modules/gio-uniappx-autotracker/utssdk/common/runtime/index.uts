// runtime/index.uts 是“平台运行时注册表”。
// common 只依赖这里的抽象钩子，不直接依赖 web / mp / app 的具体实现。
import {
  GioInitOptions,
  GioPageContext,
  GioStorage,
  GioTrackEvent
} from '../../interface.uts'

type GioPlatformStorageFactory = {
  createMainStorage : (options : GioInitOptions, fallback : GioStorage) => GioStorage
  createOriginalSourceStorage : (options : GioInitOptions, fallback : GioStorage) => GioStorage
  createLocalStorage : (options : GioInitOptions, fallback : GioStorage) => GioStorage
}

type GioPageContextResolver = {
  resolvePageContext : (pageContext : GioPageContext | null) => GioPageContext | null
}

type GioRuntimeBehavior = {
  scheduleVisitAndPage : (dispatch : (() => void)) => void
  shouldTrackAppClosed : () => boolean
  shouldEmitPageOnShow : () => boolean
}

type GioEventShaper = {
  shapeTrackEvent : (event : GioTrackEvent) => GioTrackEvent
}

type GioEventSender = {
  sendEvent : (
    url : string,
    data : Array<UTSJSONObject>,
    onSuccess : (() => void) | null,
    onFail : (() => void) | null
  ) => void
}

type GioUploadPolicy = {
  shouldScheduleFlush : () => boolean
  getFlushDelay : () => number
  getMaxBatchSize : () => number
  getMaxBatchPayloadBytes : () => number
}

// ABTest「首访 session 快照」的存储抽象。对齐独立 SDK 的 visitSids：
// - mp / app（无页面刷新）放内存即可 —— 默认走下面的 builtinVisitSessionId；
// - web 因为刷新会丢内存、且 session 自身持久化，必须把快照也持久化（见 web/runtime.uts
//   registerVisitSessionStore，落 localStorage），才能复刻「首个 session 内刷新仍 newDevice=true」。
type GioVisitSessionStore = {
  record : (sessionId : string) => void
  read : () => string
  clear : () => void
}

type GioConfigSyncer = {
  syncConfig : (options : GioInitOptions) => void
}

let registeredStorageFactory : GioPlatformStorageFactory | null = null
let registeredPageContextResolver : GioPageContextResolver | null = null
let registeredRuntimeBehavior : GioRuntimeBehavior | null = null
let registeredEventShaper : GioEventShaper | null = null
let registeredEventSender : GioEventSender | null = null
let registeredUploadPolicy : GioUploadPolicy | null = null
let registeredVisitSessionStore : GioVisitSessionStore | null = null
// 未注册平台存储时的内存兜底（mp / app 用），承载首访 session 快照。
let builtinVisitSessionId : string = ''
let registeredConfigSyncer : GioConfigSyncer | null = null

export function registerPlatformStorageFactory (
  factory : GioPlatformStorageFactory | null
) {
  registeredStorageFactory = factory
}

export function registerPageContextResolver (
  resolver : GioPageContextResolver | null
) {
  registeredPageContextResolver = resolver
}

export function registerRuntimeBehavior (
  behavior : GioRuntimeBehavior | null
) {
  registeredRuntimeBehavior = behavior
}

export function registerEventShaper (
  shaper : GioEventShaper | null
) {
  registeredEventShaper = shaper
}

export function registerEventSender (
  sender : GioEventSender | null
) {
  registeredEventSender = sender
}

export function registerUploadPolicy (
  policy : GioUploadPolicy | null
) {
  registeredUploadPolicy = policy
}

export function registerConfigSyncer (
  syncer : GioConfigSyncer | null
) {
  registeredConfigSyncer = syncer
}

export function syncConfigToGlobal (options : GioInitOptions) {
  const syncer = registeredConfigSyncer
  if (syncer == null) {
    return
  }
  syncer.syncConfig(options)
}

export function registerVisitSessionStore (
  store : GioVisitSessionStore | null
) {
  registeredVisitSessionStore = store
}

// 首访 session 快照的读 / 写 / 清，统一从 runtime 内部分发到「已注册平台存储」或内存兜底，
// 调用方（tracker / 插件经 host）只见纯字符串，不必对 any 类型的 store 调方法（UTS 不允许）。
// 与 dispatchViaEventSender 同思路。
export function recordVisitSessionSnapshot (sessionId : string) {
  const store = registeredVisitSessionStore
  if (store == null) {
    builtinVisitSessionId = sessionId
    return
  }
  store.record(sessionId)
}

export function readVisitSessionSnapshot () : string {
  const store = registeredVisitSessionStore
  if (store == null) {
    return builtinVisitSessionId
  }
  return store.read()
}

export function clearVisitSessionSnapshot () {
  const store = registeredVisitSessionStore
  if (store == null) {
    builtinVisitSessionId = ''
    return
  }
  store.clear()
}

// 发送逻辑统一从 runtime 内部分发，这里能看到 GioEventSender 的明确类型。
// uploader 只拿到 boolean 结果，不需要在 `any` sender 上直接调方法。
export function dispatchViaEventSender (
  url : string,
  data : Array<UTSJSONObject>,
  onSuccess : (() => void) | null,
  onFail : (() => void) | null
) : boolean {
  const sender = registeredEventSender
  if (sender == null) {
    return false
  }
  sender.sendEvent(url, data, onSuccess, onFail)
  return true
}

export function shouldScheduleUploadFlush () : boolean {
  const policy = registeredUploadPolicy
  if (policy == null) {
    return false
  }
  return policy.shouldScheduleFlush()
}

export function resolveUploadFlushDelay (fallback : number) : number {
  const policy = registeredUploadPolicy
  if (policy == null) {
    return fallback
  }
  return policy.getFlushDelay()
}

export function resolveUploadMaxBatchSize (fallback : number) : number {
  const policy = registeredUploadPolicy
  if (policy == null) {
    return fallback
  }
  const size = policy.getMaxBatchSize()
  return size > 0 ? size : fallback
}

export function resolveUploadMaxBatchPayloadBytes () : number {
  const policy = registeredUploadPolicy
  if (policy == null) {
    return 0
  }
  const bytes = policy.getMaxBatchPayloadBytes()
  return bytes > 0 ? bytes : 0
}

export function resolveMainStorage (
  options : GioInitOptions,
  fallback : GioStorage
) : GioStorage {
  const factory = registeredStorageFactory
  if (factory == null) {
    return fallback
  }
  return factory.createMainStorage(options, fallback)
}

export function resolveOriginalSourceStorage (
  options : GioInitOptions,
  fallback : GioStorage
) : GioStorage {
  const factory = registeredStorageFactory
  if (factory == null) {
    return fallback
  }
  return factory.createOriginalSourceStorage(options, fallback)
}

export function resolveLocalStorage (
  options : GioInitOptions,
  fallback : GioStorage
) : GioStorage {
  const factory = registeredStorageFactory
  if (factory == null) {
    return fallback
  }
  return factory.createLocalStorage(options, fallback)
}

export function resolvePageContext (
  pageContext : GioPageContext | null
) : GioPageContext | null {
  const resolver = registeredPageContextResolver
  if (resolver == null) {
    return pageContext
  }
  return resolver.resolvePageContext(pageContext)
}

export function scheduleVisitAndPage (dispatch : (() => void)) {
  const behavior = registeredRuntimeBehavior
  if (behavior == null) {
    dispatch()
    return
  }
  behavior.scheduleVisitAndPage(dispatch)
}

export function shouldTrackAppClosed () : boolean {
  const behavior = registeredRuntimeBehavior
  if (behavior == null) {
    return true
  }
  return behavior.shouldTrackAppClosed()
}

export function shouldEmitPageOnShow() : boolean {
  const behavior = registeredRuntimeBehavior
  if (behavior == null) {
    return true
  }
  return behavior.shouldEmitPageOnShow()
}

export function shapeTrackEvent (
  event : GioTrackEvent
) : GioTrackEvent {
  const shaper = registeredEventShaper
  if (shaper == null) {
    return event
  }
  return shaper.shapeTrackEvent(event)
}
