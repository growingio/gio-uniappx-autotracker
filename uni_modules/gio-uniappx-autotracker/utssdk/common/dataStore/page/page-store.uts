// page-store 维护当前页、最近有效 PAGE 和路由签名等页面态。
import { GioPageContext, GioPageSnapshot } from '../../../interface.uts'
import {
  buildRouteSignature,
  getPagePath,
  resolvePageRoute
} from '../../route.uts'
import { resolvePageContext } from '../../runtime/index.uts'
import { now } from '../../utils/base.uts'

export type GioPageEventRecord = {
  path : string
  query : string
  title : string
  referralPage : string
}

export class GioPageStore {
  private currentPagePath : string = ''
  private currentPageQuery : string = ''
  private currentPageTitle : string = ''
  private currentPageTimestamp : number = 0
  private currentPageShowAt : number = 0
  private entryReferralPage : string = ''
  private lastPageEvent : GioPageEventRecord | null = null
  private lastVisitEvent : GioPageEventRecord | null = null
  private queryOptions : Map<string, string> = new Map()

  setEntryReferralPage(referralPage : string | null) {
    this.entryReferralPage = referralPage != null ? referralPage : ''
  }

  cacheQueryOptions(path : string, query : string) {
    if (path.length > 0) {
      this.queryOptions.set(path, query)
    }
  }

  private getCachedQuery(path : string) : string | null {
    if (this.queryOptions.has(path)) {
      return this.queryOptions.get(path) as string
    }
    return null
  }

  private resolvePathFromTarget(page : GioPageSnapshot | null) : string {
    return getPagePath(page)
  }

  private resolvePageTitle(context : GioPageContext) : string {
    if (context.title != null && context.title.length > 0) {
      return context.title
    }
    const resolved = resolvePageContext(context)
    if (resolved != null && resolved.title != null && resolved.title.length > 0) {
      return resolved.title
    }
    return ''
  }

  private withResolvedTitle(context : GioPageContext) : GioPageContext {
    const title = this.resolvePageTitle(context)
    if (title.length == 0) {
      return context
    }
    return {
      path: context.path,
      query: context.query,
      title: title,
      referralPage: context.referralPage,
      duration: context.duration,
      timestamp: context.timestamp
    } as GioPageContext
  }

  buildCurrentPageContext(duration : number | null) : GioPageContext | null {
    if (this.currentPagePath.length == 0) {
      return null
    }
    return this.withResolvedTitle({
      path: this.currentPagePath,
      query: this.currentPageQuery.length > 0 ? this.currentPageQuery : null,
      title: this.currentPageTitle.length > 0 ? this.currentPageTitle : null,
      referralPage: this.resolveReferralPage(
        this.currentPagePath,
        this.currentPageQuery
      ),
      duration: duration,
      timestamp: this.currentPageTimestamp > 0 ? this.currentPageTimestamp : null
    } as GioPageContext)
  }

  refreshCurrentPageTimestamp() : GioPageContext | null {
    if (this.currentPagePath.length == 0) {
      return null
    }
    this.currentPageTimestamp = now()
    return this.buildCurrentPageContext(null)
  }

  buildPageContextFromTarget(
    page : GioPageSnapshot | null,
    options : UTSJSONObject | null,
    duration : number | null = null
  ) : GioPageContext | null {
    const path = this.resolvePathFromTarget(page)
    const cachedQuery = path.length > 0 ? this.getCachedQuery(path) : null
    const lastEventQuery = path.length > 0 ? this.getQueryFromLastEvent(path) : null
    const routeInfo = resolvePageRoute(page, options, cachedQuery, lastEventQuery)
    if (routeInfo.path.length == 0) {
      return null
    }
    return this.withResolvedTitle({
      path: routeInfo.path,
      query: routeInfo.query.length > 0 ? routeInfo.query : null,
      title: routeInfo.title.length > 0 ? routeInfo.title : null,
      referralPage: this.resolveReferralPage(routeInfo.path, routeInfo.query),
      duration: duration,
      timestamp: null
    } as GioPageContext)
  }

  updateCurrentPage(page : GioPageSnapshot | null, options : UTSJSONObject | null) : GioPageContext | null {
    // 对齐独立 SDK：页面时间在解析路由时冻结，不能等事件异步构建时再取。
    const pageTimestamp : number = now()
    const path = this.resolvePathFromTarget(page)
    const cachedQuery = path.length > 0 ? this.getCachedQuery(path) : null
    const lastEventQuery = path.length > 0 ? this.getQueryFromLastEvent(path) : null
    const routeInfo = resolvePageRoute(page, options, cachedQuery, lastEventQuery)
    // 这里显式收成 string，避免 Swift 把路由结果的非空字符串局部变量降成 `String?`，
    // 影响后续 `.length` 判断和当前页字段赋值。
    const nextPath : string = routeInfo.path
    let nextQuery : string = routeInfo.query
    let nextTitle : string = routeInfo.title
    if (nextPath.length == 0 && this.currentPagePath.length == 0) {
      return null
    }
    if (
      nextQuery.length == 0 &&
      nextPath.length > 0 &&
      nextPath == this.currentPagePath &&
      this.currentPageQuery.length > 0
    ) {
      nextQuery = this.currentPageQuery
    }
    const currentSignature = buildRouteSignature(
      this.currentPagePath,
      this.currentPageQuery
    )
    const nextSignature = routeInfo.signature
    const routeChanged = nextPath.length > 0 && nextSignature != currentSignature
    if (nextPath.length > 0) {
      this.currentPagePath = nextPath
    }
    this.currentPageQuery = nextQuery
    if (nextTitle.length == 0 && nextPath.length > 0) {
      nextTitle = this.resolvePageTitle({
        path: nextPath,
        query: nextQuery.length > 0 ? nextQuery : null,
        title: null,
        referralPage: this.resolveReferralPage(nextPath, nextQuery),
        duration: null,
        timestamp: pageTimestamp
      } as GioPageContext)
    }
    if (routeChanged) {
      this.currentPageTitle = nextTitle
    } else if (nextTitle.length > 0) {
      this.currentPageTitle = nextTitle
    }
    this.currentPageTimestamp = pageTimestamp
    this.currentPageShowAt = pageTimestamp
    return this.buildCurrentPageContext(null)
  }

  private resolveReferralPage(path : string, query : string) : string | null {
    // 当前页可在生命周期阶段提前更新；referral 只跟随已通过采集门控的 PAGE。
    const lastPage = this.lastPageEvent
    if (lastPage != null && lastPage.path.length > 0) {
      // 对齐独立 Web SDK：同 path/query 的 PAGE 属于 session 重放，沿用上一条
      // PAGE 原本的 referral，不能把当前页写成自己的来源页。
      if (lastPage.path == path && lastPage.query == query) {
        return lastPage.referralPage.length > 0
          ? lastPage.referralPage
          : null
      }
      return lastPage.path
    }
    if (this.entryReferralPage.length > 0) {
      return this.entryReferralPage
    }
    return null
  }

  getQueryFromLastEvent(path : string) : string | null {
    const lastPage = this.lastPageEvent
    if (lastPage != null && lastPage.path == path && lastPage.query.length > 0) {
      return lastPage.query
    }
    const lastVisit = this.lastVisitEvent
    if (lastVisit != null && lastVisit.path == path && lastVisit.query.length > 0) {
      return lastVisit.query
    }
    return null
  }

  recordLastPageEvent(path : string, query : string, title : string, referralPage : string) {
    // 该方法只在 PAGE 正式进入事件提交链路后调用，是 referral 的唯一推进点。
    this.lastPageEvent = {
      path: path,
      query: query,
      title: title,
      referralPage: referralPage
    } as GioPageEventRecord
  }

  recordLastVisitEvent(path : string, query : string, referralPage : string) {
    this.lastVisitEvent = {
      path: path,
      query: query,
      title: this.currentPageTitle,
      referralPage: referralPage
    } as GioPageEventRecord
  }

  buildLastVisitPageContext() : GioPageContext | null {
    const lastVisit = this.lastVisitEvent
    if (lastVisit == null || lastVisit.path.length == 0) {
      return null
    }
    return {
      path: lastVisit.path,
      query: lastVisit.query.length > 0 ? lastVisit.query : null,
      title: lastVisit.title.length > 0 ? lastVisit.title : null,
      referralPage: lastVisit.referralPage.length > 0 ? lastVisit.referralPage : null,
      duration: null,
      timestamp: null
    } as GioPageContext
  }

  hasCurrentPage() : boolean {
    return this.currentPagePath.length > 0
  }

  getCurrentPagePath() : string {
    return this.currentPagePath
  }

  getCurrentPageShowAt() : number {
    return this.currentPageShowAt
  }

  resetCurrentPageShowAt(path : string) {
    if (path.length > 0 && path == this.currentPagePath) {
      this.currentPageShowAt = 0
    }
  }
}
