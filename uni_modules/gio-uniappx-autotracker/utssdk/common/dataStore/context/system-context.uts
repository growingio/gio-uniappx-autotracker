// system-context 负责异步拉取系统信息、网络状态，并在 ready 后统一回填给事件构建层。
import { debugLog } from '../../utils/debug.uts'
import {
  GioSystemContext,
  getSystemInfoSnapshot,
  platformName
} from '../../utils/system.uts'
import { resolveIosDeviceModel } from '../../utils/device-model.uts'
import {
  GioSystemContextFields,
  GioSystemContextResolver
} from '../../../interface.uts'


type GioSystemReadyCallback = () => void

function readTextField(source : any | null, keys : Array<string>) : string {
  if (source == null) {
    return ''
  }
  const raw = source as UTSJSONObject
  for (let i = 0; i < keys.length; i++) {
    const value = raw.getString(keys[i])
    if (value != null && value.length > 0) {
      return value
    }
  }
  return ''
}

function osDisplayName(rawValue : string) : string {
  if (rawValue.length == 0) {
    return 'unknown'
  }
  const lowerValue = rawValue.toLowerCase()
  if (lowerValue.indexOf('android') >= 0) {
    return 'Android'
  }
  if (lowerValue.indexOf('ios') >= 0) {
    return 'iOS'
  }
  if (
    lowerValue.indexOf('harmony') >= 0 ||
    lowerValue.indexOf('ohos') >= 0
  ) {
    return 'HarmonyOS'
  }
  if (lowerValue.indexOf('mac') >= 0) {
    return 'macOS'
  }
  if (lowerValue.indexOf('windows') >= 0) {
    return 'Windows'
  }
  if (lowerValue.indexOf('linux') >= 0) {
    return 'Linux'
  }
  return rawValue
}

function normalizeNetworkState(rawValue : string) : string {
  const lowerValue = rawValue.toLowerCase()
  if (lowerValue == '2g') {
    return '2G'
  }
  if (lowerValue == '3g') {
    return '3G'
  }
  if (lowerValue == '4g') {
    return '4G'
  }
  if (lowerValue == '5g') {
    return '5G'
  }
  if (lowerValue == 'wifi' || lowerValue == 'ethernet') {
    return 'WIFI'
  }
  return 'UNKNOWN'
}

function shortLanguage(rawValue : string) : string {
  if (rawValue.length == 0) {
    return ''
  }
  const separator = rawValue.indexOf('-')
  if (separator > 0) {
    return rawValue.slice(0, separator)
  }
  return rawValue
}

function buildSystemContext(
  systemInfo : any | null,
  networkState : string,
  appState : string | null,
  screenWidth : number,
  screenHeight : number,
  systemContextResolver : GioSystemContextResolver | null
) : GioSystemContext {
  const osName = readTextField(systemInfo, ['osName', 'platform'])
  const osLabel = osDisplayName(osName)
  const version = readTextField(systemInfo, ['osVersion', 'version'])
  const rawDeviceType = readTextField(systemInfo, ['deviceType'])
  const deviceType = rawDeviceType.length > 0 ? rawDeviceType : osLabel
  const currentPlatform = readTextField(systemInfo, ['uniPlatform', 'platform'])
  const isMiniProgram = currentPlatform.startsWith('mp-')
  const isApp = !(currentPlatform == 'web' || isMiniProgram)
  const rawLanguage = readTextField(systemInfo, ['appLanguage', 'language'])
  const rawDeviceBrand = readTextField(systemInfo, ['deviceBrand', 'brand'])
  let resolvedDeviceBrand = rawDeviceBrand
  let resolvedDeviceType = deviceType
  let resolvedOperatingSystem = osLabel
  let resolvedPlatform = osLabel
  let resolvedPlatformVersion = version.length > 0 ? version : osLabel
  if (systemContextResolver != null) {
    const resolvedSystemContext : GioSystemContextFields | null =
      systemContextResolver.resolveSystemContext(
        systemInfo,
        osName,
        osLabel,
        version,
        rawDeviceBrand,
        deviceType
      )
    if (resolvedSystemContext != null) {
      resolvedDeviceBrand = resolvedSystemContext.deviceBrand
      resolvedDeviceType = resolvedSystemContext.deviceType
      resolvedOperatingSystem = resolvedSystemContext.operatingSystem
      resolvedPlatform = resolvedSystemContext.platform
      resolvedPlatformVersion = resolvedSystemContext.platformVersion
    }
  }

  return {
    appName: isApp ? readTextField(systemInfo, ['appName']) : '',
    appState: appState,
    bundleId: readTextField(systemInfo, ['bundleId']),
    isApp: isApp,
    deviceBrand: resolvedDeviceBrand,
    deviceModel: resolveIosDeviceModel(readTextField(systemInfo, ['deviceModel', 'model'])),
    deviceType: resolvedDeviceType,
    language: isApp ? rawLanguage : shortLanguage(rawLanguage),
    networkState: normalizeNetworkState(networkState),
    operatingSystem: resolvedOperatingSystem,
    platform: resolvedPlatform,
    platformVersion: resolvedPlatformVersion,
    screenHeight: screenHeight,
    screenWidth: screenWidth
  } as GioSystemContext
}

function getDefaultAppState() : string | null {
  const currentPlatform = platformName()
  if (currentPlatform == 'web' || currentPlatform.startsWith('mp-')) {
    return null
  }
  return 'FOREGROUND'
}

export class GioSystemContextManager {
  private debugEnabled : boolean = false
  private systemInfo : any | null = null
  private networkState : string = ''
  private appState : string | null = getDefaultAppState()
  private screenWidth : number = 0
  private screenHeight : number = 0
  private systemContextResolver : GioSystemContextResolver | null = null
  private context : GioSystemContext = {
    appName: '',
    appState: getDefaultAppState(),
    bundleId: '',
    isApp: false,
    deviceBrand: '',
    deviceModel: '',
    deviceType: '',
    language: '',
    networkState: '',
    operatingSystem: '',
    platform: 'unknown',
    platformVersion: '',
    screenHeight: 0,
    screenWidth: 0
  } as GioSystemContext
  private initialized : boolean = false
  private systemReady : boolean = false
  private networkReady : boolean = false
  private readyCallbacks : Array<GioSystemReadyCallback> = []

  initialize(
    debugEnabled : boolean,
    screenWidth : number,
    screenHeight : number,
    waitForNetworkState : boolean
  ) {
    this.debugEnabled = debugEnabled
    if (this.initialized) {
      return
    }
    this.initialized = true
    this.screenWidth = screenWidth
    this.screenHeight = screenHeight
    this.loadSystemInfo()
    if (waitForNetworkState) {
      this.loadNetworkState()
    } else {
      this.markNetworkReady()
    }
  }

  setNetworkState(networkType : string) {
    this.networkState = networkType
    this.markNetworkReady()
  }

  setAppState(appState : string | null) {
    this.appState = appState
    this.updateContext()
  }

  setSystemContextResolver(resolver : GioSystemContextResolver | null) {
    this.systemContextResolver = resolver
    if (this.systemReady) {
      this.updateContext()
    }
  }

  getContext() : GioSystemContext {
    return this.context
  }

  isReady() : boolean {
    return this.systemReady && this.networkReady
  }

  ensureReady(callback : GioSystemReadyCallback | null = null) {
    if (this.isReady()) {
      if (callback != null) {
        callback()
      }
      return
    }
    if (callback != null) {
      this.readyCallbacks.push(callback)
    }
  }

  private updateContext() {
    this.context = buildSystemContext(
      this.systemInfo,
      this.networkState,
      this.appState,
      this.screenWidth,
      this.screenHeight,
      this.systemContextResolver
    )
  }

  private flushReadyCallbacks() {
    if (!this.systemReady || !this.networkReady) {
      return
    }
    while (this.readyCallbacks.length > 0) {
      const callback = this.readyCallbacks.shift()
      if (callback != null) {
        callback()
      }
    }
  }

  private markSystemReady() {
    this.systemReady = true
    this.updateContext()
    this.flushReadyCallbacks()
  }

  private markNetworkReady() {
    this.networkReady = true
    this.updateContext()
    this.flushReadyCallbacks()
  }

  private loadSystemInfo() {
    const systemSnapshot = getSystemInfoSnapshot()
    if (systemSnapshot != null) {
      this.systemInfo = systemSnapshot
    } else {
      debugLog(this.debugEnabled, 'system info snapshot is empty', null)
    }
    this.markSystemReady()
  }

  private loadNetworkState() {
    try {
      uni.getNetworkType({
        success: (res : GetNetworkTypeSuccess) => {
          this.setNetworkState(res.networkType)
        },
        fail: (_error : GetNetworkTypeFail) => {
          debugLog(this.debugEnabled, 'network state snapshot is empty', null)
          this.markNetworkReady()
        }
      } as GetNetworkTypeOptions)
    } catch (_error) {
      debugLog(this.debugEnabled, 'getNetworkType is unavailable', null)
      this.markNetworkReady()
    }
    this.bindNetworkStatusChange()
  }

  private bindNetworkStatusChange() {
    try {
      uni.onNetworkStatusChange((res : OnNetworkStatusChangeCallbackResult) => {
        this.setNetworkState(res.networkType)
      })
    } catch (_error) {
      debugLog(this.debugEnabled, 'onNetworkStatusChange is unavailable', null)
    }
  }

}
