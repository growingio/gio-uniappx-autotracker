import { GioSystemContext, debugLog, getSystemInfoSnapshot, consoleText } from '../../utils.uts'


type GioSystemReadyCallback = () => void

function readTextField(source : any | null, keys : Array<string>) : string {
  if (source == null) {
    return ''
  }
  const raw = source as UTSJSONObject
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    const value = raw[key]
    if (value != null && `${value}`.length > 0) {
      return `${value}`
    }
  }
  return ''
}

function readNumberField(source : any | null, keys : Array<string>) : number {
  if (source == null) {
    return 0
  }
  const raw = source as UTSJSONObject
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    const value = raw[key]
    if (value != null && `${value}`.length > 0) {
      return value as number
    }
  }
  return 0
}

function mapOperatingSystem(rawValue : string) : string {
  if (rawValue.length == 0) {
    return 'unknown'
  }
  const lowerValue = rawValue.toLowerCase()
  if (lowerValue.indexOf('android') >= 0) {
    return 'uni-app-x-Android'
  }
  if (lowerValue.indexOf('ios') >= 0) {
    return 'uni-app-x-iOS'
  }
  if (
    lowerValue.indexOf('harmony') >= 0 ||
    lowerValue.indexOf('ohos') >= 0
  ) {
    return 'uni-app-x-HarmonyOS'
  }
  return rawValue
}

function buildSystemContext(
  systemInfo : any | null,
  networkState : string
) : GioSystemContext {
  const platform = readTextField(
    systemInfo,
    ['uniPlatform', 'platform', 'osName']
  )
  const operatingSystem = mapOperatingSystem(
    readTextField(systemInfo, ['osName', 'platform', 'uniPlatform'])
  )
  const version = readTextField(systemInfo, ['osVersion', 'version'])
  let platformVersion = operatingSystem
  if (version.length > 0) {
    platformVersion = `${operatingSystem} ${version}`
  }

  consoleText(`systemInfo ${systemInfo}`, 'info')
  consoleText(`screenHeight ${readNumberField(systemInfo, ['screenHeight'])}`, 'info')
  let si = systemInfo as UTSJSONObject
  consoleText(`uts ${si}`, 'info')
  consoleText(`${si['screenHeight']}`, 'info')
  
  return {
    deviceBrand: readTextField(systemInfo, ['deviceBrand', 'brand']),
    deviceModel: readTextField(systemInfo, ['deviceModel', 'model']),
    deviceType: operatingSystem,
    language: readTextField(systemInfo, ['appLanguage', 'language']),
    networkState: networkState,
    operatingSystem: operatingSystem,
    platform: platform.length > 0 ? platform : 'unknown',
    platformVersion: platformVersion,
    screenHeight: readNumberField(systemInfo, ['screenHeight']),
    screenWidth: readNumberField(systemInfo, ['screenWidth'])
  } as GioSystemContext
}

export class GioSystemContextManager {
  private debugEnabled : boolean = false
  private systemInfo : any | null = null
  private networkState : string = ''
  private context : GioSystemContext = {
    deviceBrand: '',
    deviceModel: '',
    deviceType: '',
    language: '',
    networkState: '',
    operatingSystem: '',
    platform: 'unknown',
    platformVersion: '',
    screenHeight: 0,
    screenWidth: 0
  } as GioSystemContext
  private initialized : boolean = false
  private listenerBound : boolean = false
  private systemReady : boolean = false
  private networkReady : boolean = false
  private readyCallbacks : Array<GioSystemReadyCallback> = []

  initialize(debugEnabled : boolean) {
    this.debugEnabled = debugEnabled
    if (this.initialized) {
      return
    }
    this.initialized = true
    this.loadSystemInfo()
    this.loadNetworkType()
    this.bindNetworkListener()
  }

  getContext() : GioSystemContext {
    return this.context
  }

  isReady() : boolean {
    return this.systemReady && this.networkReady
  }

  ensureReady(callback : GioSystemReadyCallback | null = null) {
    consoleText(`ensureReady: ${this.isReady()}`)
    if (this.isReady()) {
      if (callback != null) {
        callback()
      }
      return
    }
    if (callback != null) {
      this.readyCallbacks.push(callback)
    }
  }

  private updateContext() {
    this.context = buildSystemContext(this.systemInfo, this.networkState)
  }

  private flushReadyCallbacks() {
    if (!this.systemReady || !this.networkReady) {
      return
    }
    while (this.readyCallbacks.length > 0) {
      const callback = this.readyCallbacks.shift()
      if (callback != null) {
        callback()
      }
    }
  }

  private markSystemReady() {
    this.systemReady = true
    this.updateContext()
    this.flushReadyCallbacks()
  }

  private markNetworkReady() {
    this.networkReady = true
    this.updateContext()
    this.flushReadyCallbacks()
  }

  private loadSystemInfo() {
    const systemSnapshot = getSystemInfoSnapshot()
	consoleText(`loadSystemInfo ${systemSnapshot}`, 'info')
    if (systemSnapshot != null) {
      this.systemInfo = systemSnapshot
    } else {
      debugLog(this.debugEnabled, 'system info snapshot is empty', null)
    }
    this.markSystemReady()
  }

  private loadNetworkType() {
    // UTS cannot probe `uni` members dynamically; call the typed API directly.
    try {
      uni.getNetworkType({
        success: (res) => {
          this.networkState = res.networkType
          this.markNetworkReady()
        },
        fail: (_) => {
          debugLog(this.debugEnabled, 'getNetworkType failed', null)
          this.markNetworkReady()
        }
      })
    } catch (_error) {
      debugLog(this.debugEnabled, 'getNetworkType threw synchronously', null)
      this.markNetworkReady()
    }
  }

  private bindNetworkListener() {
    if (this.listenerBound) {
      return
    }
    try {
      this.listenerBound = true
      uni.onNetworkStatusChange((res) => {
        this.networkState = res.networkType
        this.updateContext()
        if (!this.networkReady) {
          this.markNetworkReady()
        }
      })
    } catch (_error) {
      debugLog(this.debugEnabled, 'onNetworkStatusChange threw synchronously', null)
    }
  }
}
