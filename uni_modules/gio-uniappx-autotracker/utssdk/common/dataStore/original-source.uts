// original-source.uts 负责 Web 和微信小程序入口来源的存储、回填和消费。
// 它只依赖公共类型和存储抽象，由对应平台入口显式注册；App 三端不启用。
import {
  GioInitOptions,
  GioOriginalSource,
  GioOriginalSourceStore,
  GioPageContext,
  GioStorage,
  GioTrackEvent
} from '../../interface.uts'

const ORIGINAL_SOURCE_SUFFIX = '_gdp_original_source'

function getOriginalSourceKey(options : GioInitOptions) : string {
  return `${options.projectId}${ORIGINAL_SOURCE_SUFFIX}`
}

function readStoredOriginalSource(
  options : GioInitOptions,
  storage : GioStorage
) : GioOriginalSource | null {
  if (options.originalSource != true) {
    return null
  }
  const storedValue = storage.getItem(getOriginalSourceKey(options))
  if (storedValue == null) {
    return null
  }
  const raw = storedValue as UTSJSONObject
  return {
    path: raw.getString('path', ''),
    query: raw.getString('query', ''),
    referralPage: raw.getString('referralPage', '')
  } as GioOriginalSource
}

function writeStoredOriginalSource(
  options : GioInitOptions,
  storage : GioStorage,
  originalSource : GioOriginalSource
) {
  storage.setItem(getOriginalSourceKey(options), {
    path: originalSource.path,
    query: originalSource.query,
    referralPage: originalSource.referralPage
  } as UTSJSONObject, null)
}

function removeStoredOriginalSource(
  options : GioInitOptions,
  storage : GioStorage
) {
  storage.removeItem(getOriginalSourceKey(options))
}

function shouldClearOriginalSource(
  originalSource : GioOriginalSource | null,
  event : GioTrackEvent
) : boolean {
  if (originalSource == null) {
    return false
  }
  const eventPath = event.path != null ? event.path as string : ''
  const eventQuery = event.query != null ? event.query as string : ''
  const eventReferralPage = event.referralPage != null
    ? event.referralPage as string
    : ''
  return originalSource.path == eventPath &&
    originalSource.query == eventQuery &&
    originalSource.referralPage == eventReferralPage
}

class OriginalSourceStore implements GioOriginalSourceStore {
  store(
    options : GioInitOptions,
    storage : GioStorage,
    pageContext : GioPageContext | null,
    preferredPageContext : GioPageContext | null
  ) {
    if (
      options.originalSource != true ||
      pageContext == null
    ) {
      return
    }
    const storedOriginalSource = readStoredOriginalSource(options, storage)
    if (storedOriginalSource != null) {
      return
    }
    const sourceContext = preferredPageContext != null
      ? preferredPageContext
      : pageContext
    writeStoredOriginalSource(options, storage, {
      path: sourceContext.path,
      query: sourceContext.query != null ? sourceContext.query : '',
      referralPage: sourceContext.referralPage != null
        ? sourceContext.referralPage
        : ''
    } as GioOriginalSource)
  }

  read(
    options : GioInitOptions,
    storage : GioStorage
  ) : GioOriginalSource | null {
    return readStoredOriginalSource(options, storage)
  }

  consume(
    options : GioInitOptions,
    storage : GioStorage,
    event : GioTrackEvent
  ) {
    const originalSource = readStoredOriginalSource(options, storage)
    if (shouldClearOriginalSource(originalSource, event)) {
      removeStoredOriginalSource(options, storage)
    }
  }
}

export function createOriginalSourceStore() : GioOriginalSourceStore {
  return new OriginalSourceStore()
}
