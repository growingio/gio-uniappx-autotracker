export type GioResolvedRoute = {
  path : string
  query : string
  title : string
  signature : string
}

function stringifyRouteQuery(value : any | null) : string {
  if (value == null) {
    return ''
  }
  if (typeof value == 'string') {
    if (value.length == 0) {
      return ''
    }
    return normalizeQueryString(value)
  }
  const raw = value as UTSJSONObject
  if (UTSJSONObject.keys(raw).length == 0) {
    return ''
  }
  const keys = UTSJSONObject.keys(raw)
  const parts = [] as Array<string>
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    if (key.length == 0) {
      continue
    }
    const item = raw[key]
    const itemValue = item != null ? `${item}` : ''
    parts.push(`${key}=${itemValue}`)
  }
  return parts.join('&')
}

function normalizeRoutePath(raw : string | null) : string {
  if (raw == null || raw.length == 0) {
    return ''
  }
  let value : string = raw as string
  const hashIndex = value.indexOf('#')
  if (hashIndex >= 0) {
    value = value.slice(hashIndex + 1)
  }
  while (value.startsWith('/')) {
    value = value.slice(1)
  }
  const queryIndex = value.indexOf('?')
  if (queryIndex >= 0) {
    value = value.slice(0, queryIndex)
  }
  while (value.startsWith('/')) {
    value = value.slice(1)
  }
  return value
}

function normalizeQueryString(queryText : string) : string {
  if (queryText.length == 0) {
    return ''
  }
  let normalizedQuery = queryText
  if (normalizedQuery.startsWith('?') || normalizedQuery.startsWith('&')) {
    normalizedQuery = normalizedQuery.slice(1)
  }
  const hashIndex = normalizedQuery.indexOf('#')
  if (hashIndex >= 0) {
    normalizedQuery = normalizedQuery.slice(0, hashIndex)
  }
  if (normalizedQuery.length == 0) {
    return ''
  }
  const segments = normalizedQuery.split('&')
  const parts = [] as Array<string>
  for (let i = 0; i < segments.length; i++) {
    const segment = segments[i]
    if (segment.length == 0) {
      continue
    }
    let key = segment
    let value = ''
    const equalIndex = segment.indexOf('=')
    if (equalIndex >= 0) {
      key = segment.slice(0, equalIndex)
      value = segment.slice(equalIndex + 1)
    }
    if (key.length == 0) {
      continue
    }
    parts.push(`${key}=${value}`)
  }
  if (parts.length == 0) {
    return ''
  }
  return parts.join('&')
}

// ============================================================
// getPagePath — 完全对齐 uni-stat get_route（直接访问属性，无 readAnyField）
// ============================================================
export function getPagePath(page : UniPage | null) : string {
  if (page == null) {
    return ''
  }
  let route : string
  // #ifdef MP-WEIXIN
  route = (page.$scope as any)?.route ?? ''
  // #endif
  // #ifndef MP-WEIXIN
  route = page.route
  // #endif

  if (route.length == 0) {
    return ''
  }
  return normalizeRoutePath(route)
}

// ============================================================
// getPageQuery — 完全对齐 uni-stat get_route
// ============================================================
function getPageQuery(
  page : UniPage | null,
  options : any | null,
  cachedQueryOptions : string | null,
  queryFromLastEvent : string | null
) : string {
  if (page == null) {
    return ''
  }
  let selectOptions : any
  // #ifdef MP-WEIXIN
  selectOptions = (page.$scope as any)?.options
  // #endif
  // #ifndef MP-WEIXIN
  selectOptions = page.options
  // #endif

  if (options != null) {
    // Android 上 options 可能是 Map，需要转成 UTSJSONObject
    // #ifdef APP-ANDROID
    const androidOptions = new UTSJSONObject(options)
    const query = stringifyRouteQuery(androidOptions)
    if (query.length > 0) {
      return query
    }
    // #endif
    // #ifndef APP-ANDROID
    const query = stringifyRouteQuery(options)
    if (query.length > 0) {
      return query
    }
    // #endif
  }

  if (selectOptions != null) {
    const query = stringifyRouteQuery(selectOptions)
    if (query.length > 0) {
      return query
    }
  }

  if (cachedQueryOptions != null) {
    return cachedQueryOptions
  }
  if (queryFromLastEvent != null && queryFromLastEvent.length > 0) {
    return queryFromLastEvent
  }
  return ''
}

// ============================================================
// getPageTitle — 完全对齐 uni-stat get_page_name
// ============================================================
// @ts-ignore
function getPageTitle(page : UniPage | null) : string {
  if (page == null) {
    return ''
  }
  // #ifndef MP-WEIXIN
  // @ts-ignore
  try {
    const pageStyle = page.getPageStyle()
    const titleText = pageStyle['navigationBarTitleText'] as string
    if (titleText != null && titleText.length > 0) {
      return titleText
    }
  } catch (_error) {}
  // #endif

  return ''
}

// ============================================================
// Public API
// ============================================================
export function buildRouteSignature(path : string, query : string) : string {
  if (path.length == 0) {
    return ''
  }
  if (query.length == 0) {
    return path
  }
  return `${path}?${query}`
}

export function resolvePageRoute(
  page : UniPage | null,
  options : any | null,
  cachedQueryOptions : string | null = null,
  queryFromLastEvent : string | null = null
) : GioResolvedRoute {
  const path = getPagePath(page)
  const query = getPageQuery(page, options, cachedQueryOptions, queryFromLastEvent)
  const title = getPageTitle(page)
  return {
    path: path,
    query: query,
    title: title,
    signature: buildRouteSignature(path, query)
  } as GioResolvedRoute
}

export function isPageRouteTarget(target : UniPage | null) : boolean {
  return getPagePath(target).length > 0
}
