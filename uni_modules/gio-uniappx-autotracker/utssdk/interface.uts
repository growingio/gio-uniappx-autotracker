// interface.uts 定义 SDK 的公共类型契约。
// 公共层、平台层和 JS 桥接层之间只通过这里暴露的稳定类型交互。
export type GioInitOptions = {
  projectId : string
  dataSourceId : string
  appId : string
  serverUrl : string
  appVersion : string | null
  dataCollect : boolean
  debug : boolean
  forceLogin : boolean
  originalSource : boolean
  idMapping : boolean
  storageType : string | null
  cookieDomain : string | null
  urlScheme : string | null
  screenWidth : number
  screenHeight : number
}

export type GioGdpInitOptions = {
  app : any
  projectId : string
  dataSourceId : string
  appId : string
  serverUrl : string
  appVersion : string | null
  dataCollect : boolean
  debug : boolean
  forceLogin : boolean
  originalSource : boolean
  idMapping : boolean
  storageType : string | null
  cookieDomain : string | null
  urlScheme : string | null
}

export type GioPluginItem = {
  name : string
  options : UTSJSONObject | null
}

export type GioABTestPluginOptions = {
  abServerUrl : string | null
  requestInterval : number | null
  requestTimeout : number | null
}

export type GioABTestResult = {
  layerId : string
  strategyId : string
  experimentId : string
  layerName : string | null
  experimentName : string | null
  strategyName : string | null
  variables : UTSJSONObject | null
}

export type GioABTestCallback = (result : GioABTestResult | UTSJSONObject) => void

// 这是公共层与平台存储适配层共享的存储契约。
// UTS 不能在 `any` 上安全调用方法，所以存储能力必须通过明确 interface 传递。
export interface GioStorage {
  getItem(key : string) : any | null
  setItem(key : string, value : any, expiredAt : number | null) : void
  removeItem(key : string) : void
  hasItem(key : string) : boolean
  getKeys() : Array<string>
}

export type GioContext = {
  deviceId : string
  sessionId : string
  userId : string | null
  userKey : string | null
}

export type GioPageContext = {
  path : string
  query : string | null
  title : string | null
  referralPage : string | null
  duration : number | null
}

export type GioPageSnapshot = {
  route : string | null
  mpRoute : string | null
  title : string | null
  options : UTSJSONObject | null
  mpOptions : UTSJSONObject | null
}

export type GioOriginalSource = {
  sessionId : string
  path : string
  query : string
  title : string
  referralPage : string
}

export type GioTrackEvent = {
  appChannel : string | null
  appName : string | null
  appState : string | null
  appVersion : string
  dataSourceId : string
  urlScheme : string | null
  deviceBrand : string
  deviceId : string
  deviceModel : string | null
  deviceType : string | null
  domain : string
  eventName : string | null
  eventSequenceId : number | null
  eventType : string
  language : string
  latitude : number | null
  longitude : number | null
  networkState : string | null
  operatingSystem : string | null
  path : string | null
  platform : string
  platformVersion : string
  protocolType : string | null
  orientation : string | null
  query : string | null
  referralPage : string | null
  screenHeight : number
  screenWidth : number
  sdkVersion : string
  sessionId : string
  timestamp : number
  timezoneOffset : string
  title : string
  userId : string | null
  userKey : string | null
  attributes : UTSJSONObject | null
}

export interface GioOriginalSourceStore {
  reset(options : GioInitOptions, storage : GioStorage) : void
  store(
    options : GioInitOptions,
    storage : GioStorage,
    pageContext : GioPageContext | null,
    preferredPageContext : GioPageContext | null,
    forceOverwrite : boolean
  ) : void
  read(options : GioInitOptions, storage : GioStorage) : GioOriginalSource | null
  consume(
    options : GioInitOptions,
    storage : GioStorage,
    event : GioTrackEvent
  ) : void
}

// 由 GioStorageContainer 实现的存储提供器。
// 之所以放在这里靠后声明，是因为 UTS 不会为 interface 成员签名做前向提升。
export interface GioStorageProvider {
  getMainStorage() : GioStorage
  getOriginalSourceStorage() : GioStorage
  getLocalStorage() : GioStorage
}

// 这是插件层（如 ABTest）依赖的 tracker 能力切片。
// 单独抽成 interface 可以打断 tracker 与插件的循环依赖，也避免插件对 `any` tracker
// 直接点方法。
export interface GioABTestHost {
  getStorage() : GioStorageProvider
  getContext() : GioContext | null
  getOptions() : GioInitOptions | null
  trackPluginEvent(eventName : string, properties : UTSJSONObject | null) : boolean
  // 首访 session 快照：只有「全新设备」首访时才被写入（见 tracker），插件据此判定 newDevice。
  // 实际存储分平台（web 持久化 / mp·app 内存），插件不感知，对齐独立 SDK 的 visitSids。
  readVisitSessionId() : string
  clearVisitSession() : void
}

export type GioMiniProgramEntryInfo = {
  path : string
  query : string
  referralPage : string | null
  scene : string
}

export type GioSystemContextFields = {
  appName : string | null
  bundleId : string | null
  channel : string | null
  deviceBrand : string | null
  deviceModel : string | null
  deviceType : string | null
  language : string | null
  networkState : string | null
  operatingSystem : string | null
  platform : string | null
  platformVersion : string | null
}

export interface GioSystemContextResolver {
  resolveSystemContext(
    systemInfo : UTSJSONObject | null,
    osName : string,
    osLabel : string,
    version : string,
    deviceBrand : string,
    deviceType : string
  ) : GioSystemContextFields | null
}

export interface GioMiniProgramResolver extends GioSystemContextResolver {
  isMpWeixinPlatform : () => boolean
  resolveMiniProgramScene : () => string
  resolveMiniProgramEntryInfo : (fallbackOptions : any | null) => GioMiniProgramEntryInfo | null
}

// 分享采集插件所依赖的 host 能力，由 GioTracker 实现。公共层只暴露插件启用状态、
// 发事件、取当前页上下文、翻 shareOut 这些平台无关能力；微信独有的
// 事件名 / 字段集 / 翻转策略收敛在 mp-weixin/plugins/gio-share-tracking.uts。
export interface GioShareTrackingHost {
  isShareTrackingEnabled() : boolean
  getCurrentPageContext() : GioPageContext | null
  setShareOut(value : boolean) : void
  emitShareEvent(eventName : string, properties : UTSJSONObject | null) : void
}
