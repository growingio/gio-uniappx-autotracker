// The Vue plugin (defineMixin + app.mixin) must be imported directly from
// ./plugin.uts in main.uts — NOT re-exported here. Re-exporting it through the
// package entry pulls plugin.uts into the uts native module compilation, where
// the Vue global `defineMixin` is not in scope. (Matches the uni-stat plugin.)

// #ifdef WEB
export * from './utssdk/web/index.uts'
// #endif

// #ifdef MP-WEIXIN
export * from './utssdk/mp-weixin/index.uts'
// #endif

// #ifdef APP-ANDROID
export * from './utssdk/app-android/index.uts'
// #endif

// #ifdef APP-IOS
export * from './utssdk/app-ios/index.uts'
// #endif

// #ifdef APP-HARMONY
export * from './utssdk/app-harmony/index.uts'
// #endif
