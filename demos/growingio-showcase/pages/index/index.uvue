<template>
	<view class="container">
		<view class="header">
			<text class="title">GrowingIO uni-app-x SDK</text>
			<text class="subtitle">Minimal showcase · VISIT / PAGE / APP_CLOSED</text>
		</view>

		<view class="section">
			<text class="section-title">运行时状态</text>
			<view class="info-row">
				<text class="info-key">deviceId</text>
				<text class="info-val">{{ deviceId }}</text>
			</view>
			<view class="info-row">
				<text class="info-key">sessionId</text>
				<text class="info-val">{{ sessionId }}</text>
			</view>
			<view class="info-row">
				<text class="info-key">userId</text>
				<text class="info-val">{{ userId }}</text>
			</view>
			<view class="info-row">
				<text class="info-key">userKey</text>
				<text class="info-val">{{ userKey }}</text>
			</view>
		</view>

		<view class="section">
			<text class="section-title">当前版本能演示什么</text>
			<text class="hint">1. 首次进入或 session 过期后，会自动发 `VISIT`。</text>
			<text class="hint">2. 每次页面显示，会自动发 `PAGE`，并尽量带 `path/query/title/referralPage`。</text>
			<text class="hint">3. 应用退后台时，会自动发 `APP_CLOSED`，并尽量带当前页停留时长。</text>
			<text class="hint">4. 业务事件可以通过 `track()` 发送；调用层传 `properties`，请求体里会映射成 `attributes`。</text>
		</view>

		<view class="section">
			<text class="section-title">功能演示（4 个子页）</text>
			<view class="card-list">
				<view class="card" @click="go('custom-event')">
					<text class="card-title">① 自定义事件 / track</text>
					<text class="card-desc">发几个典型事件，方便在网络面板里看 body。</text>
				</view>
				<view class="card" @click="go('user')">
					<text class="card-title">② 用户身份 / setUserId / setUserKey</text>
					<text class="card-desc">切换 userId 和 userKey，观察后续事件上下文。</text>
				</view>
				<view class="card" @click="go('lifecycle')">
					<text class="card-title">③ 生命周期 / VISIT / PAGE / APP_CLOSED</text>
					<text class="card-desc">通过切页、切后台来验证关键事件触发时机。</text>
				</view>
				<view class="card" @click="go('route')">
					<text class="card-title">④ 路由 / referralPage / query</text>
					<text class="card-desc">带 query 跳转，帮助验证 page 级上下文字段。</text>
				</view>
			</view>
		</view>

		<view class="section">
			<text class="section-title">快捷动作</text>
			<view class="btn-row">
				<button class="btn" @click="onTrackQuick">发一条首页事件</button>
				<button class="btn ghost" @click="refreshState">刷新状态</button>
				<button class="btn subtle" @click="onFlush">flush</button>
			</view>
			<text class="hint">建议同时打开控制台和网络面板观察请求体。</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { onMounted, ref } from 'vue'
import { GioTracker, flush, track } from '@/uni_modules/gio-uniappx-autotracker'

const deviceId = ref('')
const sessionId = ref('')
const userId = ref('')
const userKey = ref('')
const tabBarPages = new Set<string>([
	'index',
	'custom-event',
	'user',
	'lifecycle',
])

function refreshState() {
	const context = GioTracker.getInstance().getContext()
	if (context == null) {
		deviceId.value = '(unknown)'
		sessionId.value = '(unknown)'
		userId.value = '(empty)'
		userKey.value = '(empty)'
		return
	}
	deviceId.value = context.deviceId
	sessionId.value = context.sessionId
	userId.value = context.userId != null ? context.userId : '(empty)'
	userKey.value = context.userKey != null ? context.userKey : '(empty)'
}

function go(name: string) {
	const url = `/pages/${name}/${name}`
	if (tabBarPages.has(name)) {
		uni.switchTab({ url })
		return
	}
	uni.navigateTo({ url })
}

function onTrackQuick() {
	track('home_quick_track', {
		from: 'index',
		tick: Date.now(),
	} as UTSJSONObject)
}

function onFlush() {
	flush()
}

onMounted(() => {
	refreshState()
})
</script>

<style>
.container { padding: 20rpx; }
.header { padding: 40rpx 20rpx; text-align: center; }
.title { font-size: 40rpx; font-weight: bold; }
.subtitle { font-size: 24rpx; color: #888; margin-top: 10rpx; }
.section { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-top: 20rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.info-row { flex-direction: row; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.info-key { width: 200rpx; font-size: 24rpx; color: #999; font-family: monospace; }
.info-val { flex: 1; font-size: 24rpx; color: #333; font-family: monospace; }
.card-list { display: flex; flex-direction: column; }
.card { padding: 24rpx; border: 1rpx solid #eee; border-radius: 10rpx; margin-bottom: 16rpx; }
.card-title { font-size: 28rpx; font-weight: 500; color: #1677ff; }
.card-desc { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.btn-row { flex-direction: row; flex-wrap: wrap; }
.btn { background: #1677ff; color: #fff; font-size: 26rpx; padding: 16rpx 32rpx; border-radius: 8rpx; margin: 8rpx; }
.btn.ghost { background: #fff; color: #1677ff; border: 1rpx solid #1677ff; }
.btn.subtle { background: #13a67a; }
.hint { font-size: 22rpx; color: #888; padding: 6rpx 0; }
</style>
